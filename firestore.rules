        && d().playerUids.size() <= 2
        && d().playerUids.hasAll(resource.data.playerUids)
        && d().board == resource.data.board
        && d().winner == resource.data.winner
        && d().draw == resource.data.draw
        && d().turnUid == resource.data.turnUid
        && d().status in ['waiting','ready']
        && changedFields().hasOnly(['playerUids','marks','status','updatedAt'])
        && d().updatedAt is timestamp
        && (
          d().playerUids.size() == resource.data.playerUids.size()
          || (
            resource.data.status == 'waiting'
            && resource.data.playerUids.size() == 1
            && d().playerUids.size() == 2
            && request.auth.uid in d().playerUids
          )
        );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids
          && d().senderUid == request.auth.uid
          && d().text is string
          && d().text.size() > 0
          && d().text.size() <= 500
          && d().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/gaming_challenges/{challengeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && d().challengeId == 'daily_tic_tac_toe'
        && d().xp == 25
        && d().completedAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{userId}/gaming_profile/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /users/{userId}/gaming_results/{resultId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /watch_together_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
      allow create: if request.auth != null
        && d().hostUid == request.auth.uid
        && d().roomId is string
        && d().roomId.size() > 0
        && d().inviteCode == inviteCode
        && d().createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /watch_together_rooms/{roomId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && d().hostUid == request.auth.uid
        && d().memberIds is list
        && d().memberIds.size() == 1
        && d().memberIds[0] == request.auth.uid
        && d().inviteCode is string
        && d().inviteCode.size() == 6
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().channelId is string
        && d().channelId.size() > 0
        && d().channelName is string
        && d().channelName.size() > 0
        && d().positionSeconds is number
        && d().positionSeconds >= 0
        && d().positionSeconds <= 86400
        && d().isPlaying is bool
        && d().status == 'waiting'
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;

      // Playback/channel state is host-authoritative.
      // Membership changes are separately constrained below.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && d().inviteCode == resource.data.inviteCode
        && d().memberIds is list
        && d().memberIds.size() <= 8
        && d().updatedAt is timestamp
        && (
          // Host can update playback/channel state, but cannot alter membership.
          (
            request.auth.uid == resource.data.hostUid
            && d().hostUid == resource.data.hostUid
            && d().memberIds == resource.data.memberIds
            && changedFields().hasOnly([
              'channelId','channelName','positionSeconds','isPlaying','updatedAt'
            ])
            && d().channelId is string
            && d().channelId.size() > 0
            && d().channelName is string
            && d().channelName.size() > 0
            && d().positionSeconds is number
            && d().positionSeconds >= 0
            && d().positionSeconds <= 86400
            && d().isPlaying is bool
            && d().status == resource.data.status
          )
          ||
          // A member can join; only the host can change hostUid.
          (
            d().hostUid == resource.data.hostUid
            && d().status in ['waiting','ready']
            && !(request.auth.uid in resource.data.memberIds)
            && d().memberIds.size() == resource.data.memberIds.size() + 1
            && d().memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in d().memberIds
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // A member can leave themselves.
          (
            d().hostUid == resource.data.hostUid
            && d().status in ['waiting','ready']
            && d().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(d().memberIds)
            && !(request.auth.uid in d().memberIds)
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // The current host can leave and transfer host ownership to a remaining member.
          (
            request.auth.uid == resource.data.hostUid
            && d().hostUid is string
            && d().hostUid != resource.data.hostUid
            && d().hostUid in d().memberIds
            && d().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(d().memberIds)
            && !(request.auth.uid in d().memberIds)
            && d().status in ['waiting','ready']
            && changedFields().hasOnly([
              'hostUid','memberIds','status','updatedAt'
            ])
          )
        );

      // Only the host can delete a room.
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      match /presence/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().uid == request.auth.uid
          && d().online is bool
          && d().lastSeen is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /activity/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().actorUid == request.auth.uid
          && d().type is string
          && d().type.size() > 0
          && d().type.size() <= 40
          && d().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /typing/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().uid == request.auth.uid
          && d().typing is bool
          && d().updatedAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /reactions/{reactionId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().senderUid == request.auth.uid
          && d().emoji is string
          && d().emoji.size() > 0
          && d().emoji.size() <= 8
          && d().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().senderUid == request.auth.uid
          && d().text is string
          && d().text.size() > 0
          && d().text.size() <= 500
          && d().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    // Canonical Education schema: courses + per-user enrollments/savedCourses.
    // Keep the legacy education_* rules below during migration; do not expose unpublished courses.
    match /courses/{courseId} {
      allow read: if request.auth != null && resource.data.status == 'published';
      allow create, delete: if false;
      allow update: if false;
    }

    match /users/{userId}/enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && d().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && d().completedLessons == 0
        && d().progress == 0
        && d().status == 'active'
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && d().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && d().courseId == resource.data.courseId
        && d().completedLessons is int
        && d().completedLessons >= 0
        && d().progress is int
        && d().progress >= 0
        && d().progress <= 100
        && d().status in ['active','completed']
        && d().createdAt == resource.data.createdAt
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/savedCourses/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['courseId','createdAt'])
        && d().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && d().createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /education_courses/{courseId} {
      allow read: if request.auth != null && resource.data.published == true;
      allow write: if false;
    }

    match /users/{userId}/education_enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && d().courseId == courseId
        && d().title is string
        && d().title.size() <= 160
        && d().progress == 0
        && d().completedLessons is list
        && d().completedLessons.size() == 0
        && d().status == 'active'
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && d().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && d().courseId == resource.data.courseId
        && d().progress is int
        && d().progress >= 0
        && d().progress <= 100
        && d().completedLessons is list
        && d().completedLessons.size() <= 100
        && d().status in ['active','completed']
        && d().createdAt == resource.data.createdAt
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/arena_history/{historyId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /arena_rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow write: if false;
    }

    match /arena_invites/{inviteCode} {
      allow read, write: if false;
    }


    match /stays/{stayId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null
        && d().ownerId == request.auth.uid
        && d().name is string && d().name.size() > 0 && d().name.size() <= 160
        && d().city is string && d().city.size() > 0 && d().city.size() <= 100
        && d().country is string && d().country.size() > 0 && d().country.size() <= 100
        && d().type in ['hotel','apartment','villa','hostel','resort','guesthouse']
        && d().description is string && d().description.size() <= 3000
        && d().currency is string && d().currency.size() == 3
        && request.resource.data.priceMinor is int && d().priceMinor >= 0
        && d().guests is int && d().guests >= 1 && d().guests <= 50
        && d().status == 'active'
        && d().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && d().ownerId == resource.data.ownerId
        && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /stay_bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.guestUid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
        && d().guestUid == request.auth.uid
        && d().ownerId is string
        && d().stayId is string
        && d().name is string
        && d().city is string
        && d().checkIn is timestamp
        && d().checkOut is timestamp
        && d().checkOut > d().checkIn
        && d().guests is int && d().guests >= 1 && d().guests <= 50
        && d().currency is string && d().currency.size() == 3
        && d().priceMinorPerNight is int && d().priceMinorPerNight >= 0
        && d().status == 'requested'
        && d().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && changedFields().hasOnly(['status'])
        && d().status in ['accepted','rejected','cancelled'];
      allow delete: if request.auth != null && resource.data.guestUid == request.auth.uid;
    }

    match /ride_requests/{rideId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.riderUid;
      allow create: if request.auth != null && d().riderUid == request.auth.uid
        && d().pickup is string && d().pickup.size() > 0 && d().pickup.size() <= 500
        && d().destination is string && d().destination.size() > 0 && d().destination.size() <= 500
        && d().rideType in ['standard','premium','van','bike']
        && d().passengers is int && d().passengers >= 1 && d().passengers <= 8
        && d().status == 'requested' && d().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.riderUid == request.auth.uid
        && d().riderUid == resource.data.riderUid
        && changedFields().hasOnly(['status'])
        && d().status == 'cancelled';
      allow delete: if request.auth != null && resource.data.riderUid == request.auth.uid;
    }
    match /food_items/{itemId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null && d().ownerId == request.auth.uid
        && d().name is string && d().name.size() > 0 && d().name.size() <= 160
        && d().category is string && d().category.size() > 0 && d().category.size() <= 100
        && d().city is string && d().city.size() > 0 && d().city.size() <= 100
        && d().country is string && d().country.size() > 0 && d().country.size() <= 100
        && d().currency is string && d().currency.size() == 3
        && request.resource.data.priceMinor is int && d().priceMinor >= 0
        && d().halal is bool && d().status == 'active'
        && d().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && d().ownerId == resource.data.ownerId && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /safety_places/{placeId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }
    match /users/{userId}/offline_routes/{routeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && d().ownerId == userId
        && d().name is string && d().name.size() > 0 && d().name.size() <= 160
        && d().points is list && d().points.size() >= 2 && d().points.size() <= 500
        && d().createdAt is timestamp;
      allow update: if request.auth != null && request.auth.uid == userId && d().ownerId == resource.data.ownerId && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /emergency_contacts/{contactId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }

    match /entertainment_items/{itemId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && d().creatorId == request.auth.uid
        && d().channelId is string
        && d().channelId.size() > 0
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().description is string
        && d().description.size() <= 3000
        && d().mediaUrl is string
        && d().mediaUrl.size() > 0
        && d().mediaUrl.size() <= 2000
        && d().mediaKind == 'video'
        && d().visibility == 'public'
        && d().createdAt is timestamp
        && get(/databases/$(database)/documents/content_channels/$(d().channelId)).data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && d().creatorId == resource.data.creatorId
        && d().channelId == resource.data.channelId
        && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }

    match /content_channels/{channelId} {
      allow read: if request.auth != null && resource.data.public == true;
      allow create: if request.auth != null && d().ownerId == request.auth.uid
        && d().name is string && d().name.size() > 0 && d().name.size() <= 100
        && d().description is string && d().description.size() <= 1000
        && d().subscribers == 0 && d().public == true && d().createdAt is timestamp;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /subscribers/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid && d().uid == uid && d().createdAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /users/{userId}/watchTogetherTokens/{tokenId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && d().keys().hasOnly(['token','platform','updatedAt'])
        && d().token == tokenId
        && d().token is string
        && d().token.size() > 0
        && d().token.size() <= 4096
        && d().platform in ['android','ios','web']
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/actions/{actionId} {
      allow read: if isOwner(userId);

      // Action documents are created by trusted server code. While an action is
      // pending, the owner may edit only the user-facing draft fields.
      // Approval/execution fields remain server-owned at all times.
      allow create, delete: if false;

      allow update: if isOwner(userId)
        && resource.data.status == 'pending'
        && d().status == 'pending'
        && d().actionType == resource.data.actionType
        && d().createdAt == resource.data.createdAt
        && d().draftVersion is int
        && d().draftVersion == resource.data.draftVersion + 1
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 200
        && d().description is string
        && d().description.size() <= 2000
        && d().payload is map
        && d().payload.keys().size() <= 50
        && d().updatedAt is timestamp
        && changedFields().hasOnly([
          'title','description','payload','draftVersion','updatedAt'
        ]);
    }
    match /users/{userId}/notes/{noteId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/memory/{memoryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/action_audit/{eventId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /agriculture_records/{recordId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && d().ownerId == request.auth.uid
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','farm','soil','water','equipment','fertilizer','nutrients','pest','plant_disease','irrigation','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && d().location is string
        && d().location.size() <= 200
        && d().visibility == 'public'
        && d().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && d().ownerId == resource.data.ownerId
        && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /agriculture_opportunities/{opportunityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow write: if false;
    }

    match /users/{userId}/agricultureNotes/{noteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['title','note','type','createdAt','updatedAt'])
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().note is string
        && d().note.size() > 0
        && d().note.size() <= 5000
        && d().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','soil','fertilizer','nutrients','potassium','nitrogen','phosphorus','pest','plant_disease','irrigation','general','field','farm','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && changedFields().hasOnly(['title','note','type','updatedAt'])
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().note is string
        && d().note.size() > 0
        && d().note.size() <= 5000
        && d().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','soil','fertilizer','nutrients','potassium','nitrogen','phosphorus','pest','plant_disease','irrigation','general','field','farm','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/agricultureAdvisories/{advisoryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/productionHistory/{entryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/outputLibrary/{outputId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/production_jobs/{jobId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().uid == userId
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 200
        && d().type in ['short','film','seriesEpisode']
        && d().status == 'queued'
        && d().engine in ['moneyPrinterTurbo','skyReelsV3','skyReelsV2','ltx2','wan','hunyuan']
        && d().targetMinutes is int
        && d().targetMinutes >= 1
        && d().targetMinutes <= 240
        && d().progress == 0
        && d().retryCount == 0
        && d().cancelRequested == false
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && changedFields().hasOnly(['status','progress','error','cancelRequested','retryCount','updatedAt'])
        && d().updatedAt is timestamp
        && (
          (d().status == 'cancelled'
            && resource.data.status in ['queued','planning','generating','assembling','review']
            && d().cancelRequested == true
            && d().progress == resource.data.progress)
          ||
          (d().status == 'queued'
            && resource.data.status in ['failed','cancelled']
            && d().progress == 0
            && d().cancelRequested == false
            && d().retryCount == resource.data.retryCount + 1)
        );
      allow delete: if isOwner(userId);
    }


    match /auren_global_countries/{iso3} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /auren_global_data/{iso3} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Canonical Education schema. Course documents are server-published only.
    match /courses/{courseId} {
      allow read: if request.auth != null
        && resource.data.status == 'published'
        && resource.data.title is string
        && resource.data.title.size() > 0
        && resource.data.title.size() <= 160
        && resource.data.description is string
        && resource.data.description.size() <= 4000
        && resource.data.category is string
        && resource.data.category.size() <= 100
        && resource.data.teacherId is string
        && resource.data.lessonCount is int
        && resource.data.lessonCount >= 1
        && resource.data.lessonCount <= 500
        && resource.data.skills is list
        && resource.data.skills.size() <= 20;
      allow create, update, delete: if false;

      match /lessons/{lessonId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
          && resource.data.title is string
          && resource.data.title.size() > 0
          && resource.data.title.size() <= 200
          && resource.data.order is int
          && resource.data.order >= 0
          && resource.data.order < get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount;
        allow write: if false;
      }
    }

    match /users/{userId}/enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && d().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount is int
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount >= 1
        && d().completedLessons == 0
        && d().progress == 0
        && d().status == 'active'
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && d().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && d().courseId == resource.data.courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount is int
        && d().completedLessons >= resource.data.completedLessons
        && d().completedLessons >= 0
        && d().completedLessons <= get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount
        && d().progress * get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount >= d().completedLessons * 100 - (get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount / 2) && d().progress * get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount < d().completedLessons * 100 + (get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount / 2) + 1
        && d().progress >= resource.data.progress
        && d().progress >= 0
        && d().progress <= 100
        && d().status in ['active','completed']
        && ((d().status == 'completed' && d().progress == 100
            && d().completedLessons == get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount)
          || (d().status == 'active' && d().progress < 100))
        && d().createdAt == resource.data.createdAt
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/savedCourses/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['courseId','createdAt'])
        && d().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && d().createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    // Personal learning plans generated by the Education Learning Engine.
    match /users/{userId}/learningPlans/{planId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && d().keys().hasOnly([
          'engineVersion','nextAction','lastCompletedTask','lastActivityAt','updatedAt'
        ])
        && (!d().keys().hasAny(['engineVersion']) || d().engineVersion is int)
        && (!d().keys().hasAny(['nextAction']) || d().nextAction is string)
        && (!d().keys().hasAny(['lastCompletedTask']) || d().lastCompletedTask is string)
        && (!d().keys().hasAny(['lastActivityAt']) || d().lastActivityAt is timestamp)
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && d().keys().hasOnly([
            'title','type','minutes','level','focusAreas','completed','order','dueAt','createdAt'
          ])
          && d().title is string
          && d().title.size() > 0
          && d().title.size() <= 200
          && d().type in ['review','lesson','practice','assessment']
          && d().minutes is int
          && d().minutes >= 5
          && d().minutes <= 180
          && d().level is string
          && d().level.size() <= 40
          && d().focusAreas is list
          && d().focusAreas.size() <= 10
          && d().completed == false
          && d().order is int
          && d().order >= 0
          && d().dueAt is timestamp
          && d().createdAt is timestamp;
        allow update: if isOwner(userId)
          && changedFields().hasOnly([
            'completed','completedAt'
          ])
          && d().completed == true
          && d().completedAt is timestamp;
        allow delete: if isOwner(userId);
      }
    }

    match /users/{userId}/educationSkills/{skillId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && d().keys().hasOnly(['name','level','lastActivityAt','source'])
        && d().name is string
        && d().name.size() > 0
        && d().name.size() <= 160
        && d().level is string
        && d().level.size() <= 40
        && d().lastActivityAt is timestamp
        && d().source == 'learning_plan';
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/emergency_contacts/{contactId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['ownerId','name','phone','relation','primary','createdAt','updatedAt'])
        && d().ownerId == userId
        && d().name is string
        && d().name.size() > 0
        && d().name.size() <= 120
        && d().phone is string
        && d().phone.size() > 0
        && d().phone.size() <= 40
        && d().relation is string
        && d().relation.size() <= 80
        && d().primary is bool
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && d().keys().hasOnly(['ownerId','name','phone','relation','primary','createdAt','updatedAt'])
        && d().ownerId == resource.data.ownerId
        && d().ownerId == userId
        && d().name is string
        && d().name.size() > 0
        && d().name.size() <= 120
        && d().phone is string
        && d().phone.size() > 0
        && d().phone.size() <= 40
        && d().relation is string
        && d().relation.size() <= 80
        && d().primary is bool
        && d().createdAt == resource.data.createdAt
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /supplier_contact_requests/{requestId} {
      allow read: if request.auth != null && resource.data.requesterUid == request.auth.uid;
      allow write: if false;
    }

    match /supplier_rfqs/{rfqId} {
      allow read: if request.auth != null && resource.data.requesterUid == request.auth.uid;
      allow write: if false;
    }


    match /kids_activities/{activityId} {
      allow read: if request.auth != null
        && resource.data.published == true
        && resource.data.title is string
        && resource.data.title.size() > 0
        && resource.data.title.size() <= 160
        && resource.data.description is string
        && resource.data.description.size() <= 1000
        && resource.data.category is string
        && resource.data.category.size() <= 40
        && resource.data.minAge in [6, 9, 13]
        && resource.data.maxAge in [8, 11, 17]
        && resource.data.minutes is int
        && resource.data.minutes >= 5
        && resource.data.minutes <= 60;
      allow write: if false;
    }

match /users/{userId}/kids_activity_progress/{activityId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && d().keys().hasOnly(['activityId','completed','updatedAt'])
        && d().activityId == activityId
        && d().completed is bool
        && d().updatedAt is timestamp
        && get(/databases/$(database)/documents/kids_activities/$(activityId)).data.published == true;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/kids/{settingId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && settingId == 'parent_settings'
        && d().keys().hasOnly(['ageBand','aiTutor','externalLinks','dailyMinutes','updatedAt'])
        && d().ageBand in [6, 9, 13]
        && d().aiTutor is bool
        && d().externalLinks is bool
        && d().dailyMinutes in [15, 30, 60, 90, 120, 180, 240]
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }
    
    
    // Canonical Family Hub / Family Pot. Financial entries are user-owned;
    // no cross-user reads or writes are allowed from the client.
    match /users/{userId}/familyMembers/{memberId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['name','relation','createdAt','updatedAt'])
        && d().name is string
        && d().name.size() > 0
        && d().name.size() <= 120
        && d().relation is string
        && d().relation.size() <= 80
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && d().keys().hasOnly(['name','relation','createdAt','updatedAt'])
        && d().name is string
        && d().name.size() > 0
        && d().name.size() <= 120
        && d().relation is string
        && d().relation.size() <= 80
        && d().createdAt == resource.data.createdAt
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/familyPot/{entryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['title','amountMinor','currency','createdAt'])
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().amountMinor is int
        && d().amountMinor >= 0
        && d().amountMinor <= 1000000000000
        && d().currency is string
        && d().currency.size() == 3
        && d().createdAt is timestamp;
      allow update, delete: if false;
    }

    // Canonical Health & Sports daily check-ins. Health guidance remains general;
    // sensitive medical actions are not performed by client writes.
    match /users/{userId}/healthCheckins/{checkinId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && checkinId.size() <= 40
        && d().keys().hasOnly([
          'activityMinutes','waterGlasses','sleepHours','mood','updatedAt'
        ])
        && d().activityMinutes is int
        && d().activityMinutes >= 0
        && d().activityMinutes <= 1440
        && d().waterGlasses is int
        && d().waterGlasses >= 0
        && d().waterGlasses <= 50
        && d().sleepHours is number
        && d().sleepHours >= 0
        && d().sleepHours <= 24
        && d().mood is int
        && d().mood >= 1
        && d().mood <= 5
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

match /users/{userId}/savedProperties/{propertyId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if false;
    }

    match /community_polls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && d().ownerId == request.auth.uid
        && d().communityId is string
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(d().communityId)).data.memberIds
        && d().question is string
        && d().question.size() > 0
        && d().question.size() <= 240
        && d().options is list
        && d().options.size() >= 2
        && d().options.size() <= 6
        && d().votes is map
        && d().voters is map
        && d().voters.size() == 0
        && d().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.communityId is string
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.memberIds
        && !(request.auth.uid in resource.data.voters)
        && request.auth.uid in d().voters
        && changedFields().hasOnly(['votes','voters'])
        && d().votes is map
        && d().voters is map
        && d().voters.size() == resource.data.voters.size() + 1;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /communities/{communityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && d().ownerId == request.auth.uid
        && d().name is string && d().name.size() > 0 && d().name.size() <= 80
        && d().description is string && d().description.size() <= 500
        && d().topic is string && d().topic.size() <= 80
        && d().visibility == 'public'
        && d().memberIds is list
        && d().memberIds.size() == 1
        && d().memberIds[0] == request.auth.uid
        && d().memberCount == 1
        && d().createdAt is timestamp;
      allow update: if request.auth != null
        && d().keys().hasOnly(['ownerId','name','description','topic','visibility','memberIds','memberCount','createdAt'])
        && resource.data.ownerId == d().ownerId
        && resource.data.name == d().name
        && resource.data.description == d().description
        && resource.data.topic == d().topic
        && resource.data.visibility == d().visibility
        && resource.data.createdAt == d().createdAt
        && d().memberIds is list
        && d().memberIds.size() >= 1
        && d().memberIds.size() <= 10000
        && d().memberCount == d().memberIds.size()
        && (
          (!(request.auth.uid in resource.data.memberIds)
            && request.auth.uid in d().memberIds
            && d().memberIds.hasAll(resource.data.memberIds)
            && d().memberIds.size() == resource.data.memberIds.size() + 1)
          || (request.auth.uid in resource.data.memberIds
            && request.auth.uid != resource.data.ownerId
            && !(request.auth.uid in d().memberIds)
            && resource.data.memberIds.hasAll(d().memberIds)
            && d().memberIds.size() + 1 == resource.data.memberIds.size())
          || (request.auth.uid == resource.data.ownerId
            && request.auth.uid in d().memberIds
            && request.auth.uid in resource.data.memberIds
            && resource.data.memberIds.hasAll(d().memberIds)
            && d().memberIds.size() + 1 == resource.data.memberIds.size())
        );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }



  match /random_calls/{callId} {
    allow read: if request.auth != null
      && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
    allow create: if request.auth != null
      && d().callerUid == request.auth.uid
      && d().calleeUid is string
      && d().calleeUid != request.auth.uid
      && d().kind in ['audio','video']
      && d().status == 'ringing'
      && d().keys().hasOnly(['callerUid','calleeUid','kind','status','createdAt']);
    allow update: if request.auth != null
      && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid)
      && (
        (changedFields().hasOnly(['offer'])
          && resource.data.callerUid == request.auth.uid
          && d().offer is map
          && d().offer.sdp is string
          && d().offer.type is string)
        || (changedFields().hasOnly(['answer','status'])
          && resource.data.calleeUid == request.auth.uid
          && resource.data.status == 'ringing'
          && d().status == 'connected'
          && d().answer is map
          && d().answer.sdp is string
          && d().answer.type is string)
        || (changedFields().hasOnly(['status','endedBy','endedAt'])
          && d().status == 'ended'
          && d().endedBy == request.auth.uid
          && d().endedAt is timestamp)
      );
    allow delete: if false;
    match /candidates/{candidateId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/random_calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/random_calls/$(callId)).data.calleeUid == request.auth.uid);
      allow create: if request.auth != null
        && d().senderUid == request.auth.uid
        && (get(/databases/$(database)/documents/random_calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/random_calls/$(callId)).data.calleeUid == request.auth.uid)
        && d().candidate is string
        && (d().sdpMid == null || d().sdpMid is string)
        && (d().sdpMLineIndex == null || d().sdpMLineIndex is int)
        && d().keys().hasOnly(['senderUid','candidate','sdpMid','sdpMLineIndex','createdAt']);
      allow update, delete: if false;
    }
  }

    match /gaming_friend_challenges/{challengeId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      // Creation and lifecycle are server-authoritative.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /gaming_friend_challenge_keys/{keyId} {
      allow read, write: if false;
    }

    match /gaming_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
      allow create: if request.auth != null
        && d().hostUid == request.auth.uid
        && d().roomId is string
        && d().roomId.size() > 0
        && d().inviteCode == inviteCode
        && d().createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /auren_game_matchmaking/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /auren_game_lobbies/{lobbyId}/private_players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/auren_game_lobbies/$(lobbyId))
        && request.auth.uid in get(/databases/$(database)/documents/auren_game_lobbies/$(lobbyId)).data.players;
      allow create, update, delete: if false;
    }

    match /auren_game_lobbies/{lobbyId}/server/{docId} {
      allow read, write: if false;
    }

    match /auren_game_lobbies/{lobbyId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && d().hostId == request.auth.uid
        && d().guestId == null
        && d().players is list
        && d().players.size() == 1
        && d().players[0] == request.auth.uid
        && d().gameIndex is int
        && d().gameIndex >= 0
        && d().gameIndex <= 59
        && d().status == 'waiting'
        && d().turnPlayerId == request.auth.uid
        && d().stateVersion == 0
        && d().state is map
        && d().state.size() == 0;
      // Only the second player may transition a waiting lobby to playing.
      // Match state itself remains immutable from clients; game moves go through
      // the trusted Cloud Function.
      allow update: if request.auth != null
        && resource.data.status == 'waiting'
        && resource.data.players is list
        && resource.data.players.size() == 1
        && d().players is list
        && d().players.size() == 2
        && d().players[0] == resource.data.players[0]
        && d().players[1] == request.auth.uid
        && d().guestId == request.auth.uid
        && d().hostId == resource.data.hostId
        && d().gameIndex == resource.data.gameIndex
        && d().status == 'playing'
        && d().turnPlayerId == resource.data.turnPlayerId
        && d().stateVersion == resource.data.stateVersion
        && d().state == resource.data.state;
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid
        && resource.data.status != 'playing';
    }

    match /gaming_rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow create: if request.auth != null
        && d().hostUid == request.auth.uid
        && d().playerUids is list
        && d().playerUids.size() == 1
        && d().playerUids[0] == request.auth.uid
        && d().gameId in ['tic_tac_toe','rock_paper_scissors','connect_four']
        && d().inviteCode is string
        && d().inviteCode.size() == 6
        && d().board is list
        && d().board.size() in [9,3,42]
        && d().turnUid == request.auth.uid
        && d().status == 'waiting';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.playerUids
        && d().hostUid == resource.data.hostUid
        && d().gameId == resource.data.gameId
        && d().inviteCode == resource.data.inviteCode
        && d().playerUids is list
        && d().playerUids.size() >= resource.data.playerUids.size()
        && d().playerUids.size() <= 2
        && d().playerUids.hasAll(resource.data.playerUids)
        && d().board == resource.data.board
        && d().winner == resource.data.winner
        && d().draw == resource.data.draw
        && d().turnUid == resource.data.turnUid
        && d().status in ['waiting','ready']
        && changedFields().hasOnly(['playerUids','marks','status','updatedAt'])
        && d().updatedAt is timestamp
        && (
          d().playerUids.size() == resource.data.playerUids.size()
          || (
            resource.data.status == 'waiting'
            && resource.data.playerUids.size() == 1
            && d().playerUids.size() == 2
            && request.auth.uid in d().playerUids
          )
        );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids
          && d().senderUid == request.auth.uid
          && d().text is string
          && d().text.size() > 0
          && d().text.size() <= 500
          && d().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/gaming_challenges/{challengeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && d().challengeId == 'daily_tic_tac_toe'
        && d().xp == 25
        && d().completedAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{userId}/gaming_profile/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /users/{userId}/gaming_results/{resultId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /watch_together_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
      allow create: if request.auth != null
        && d().hostUid == request.auth.uid
        && d().roomId is string
        && d().roomId.size() > 0
        && d().inviteCode == inviteCode
        && d().createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /watch_together_rooms/{roomId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && d().hostUid == request.auth.uid
        && d().memberIds is list
        && d().memberIds.size() == 1
        && d().memberIds[0] == request.auth.uid
        && d().inviteCode is string
        && d().inviteCode.size() == 6
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().channelId is string
        && d().channelId.size() > 0
        && d().channelName is string
        && d().channelName.size() > 0
        && d().positionSeconds is number
        && d().positionSeconds >= 0
        && d().positionSeconds <= 86400
        && d().isPlaying is bool
        && d().status == 'waiting'
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;

      // Playback/channel state is host-authoritative.
      // Membership changes are separately constrained below.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && d().inviteCode == resource.data.inviteCode
        && d().memberIds is list
        && d().memberIds.size() <= 8
        && d().updatedAt is timestamp
        && (
          // Host can update playback/channel state, but cannot alter membership.
          (
            request.auth.uid == resource.data.hostUid
            && d().hostUid == resource.data.hostUid
            && d().memberIds == resource.data.memberIds
            && changedFields().hasOnly([
              'channelId','channelName','positionSeconds','isPlaying','updatedAt'
            ])
            && d().channelId is string
            && d().channelId.size() > 0
            && d().channelName is string
            && d().channelName.size() > 0
            && d().positionSeconds is number
            && d().positionSeconds >= 0
            && d().positionSeconds <= 86400
            && d().isPlaying is bool
            && d().status == resource.data.status
          )
          ||
          // A member can join; only the host can change hostUid.
          (
            d().hostUid == resource.data.hostUid
            && d().status in ['waiting','ready']
            && !(request.auth.uid in resource.data.memberIds)
            && d().memberIds.size() == resource.data.memberIds.size() + 1
            && d().memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in d().memberIds
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // A member can leave themselves.
          (
            d().hostUid == resource.data.hostUid
            && d().status in ['waiting','ready']
            && d().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(d().memberIds)
            && !(request.auth.uid in d().memberIds)
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // The current host can leave and transfer host ownership to a remaining member.
          (
            request.auth.uid == resource.data.hostUid
            && d().hostUid is string
            && d().hostUid != resource.data.hostUid
            && d().hostUid in d().memberIds
            && d().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(d().memberIds)
            && !(request.auth.uid in d().memberIds)
            && d().status in ['waiting','ready']
            && changedFields().hasOnly([
              'hostUid','memberIds','status','updatedAt'
            ])
          )
        );

      // Only the host can delete a room.
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      match /presence/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().uid == request.auth.uid
          && d().online is bool
          && d().lastSeen is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /activity/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().actorUid == request.auth.uid
          && d().type is string
          && d().type.size() > 0
          && d().type.size() <= 40
          && d().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /typing/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().uid == request.auth.uid
          && d().typing is bool
          && d().updatedAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /reactions/{reactionId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().senderUid == request.auth.uid
          && d().emoji is string
          && d().emoji.size() > 0
          && d().emoji.size() <= 8
          && d().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && d().senderUid == request.auth.uid
          && d().text is string
          && d().text.size() > 0
          && d().text.size() <= 500
          && d().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    // Canonical Education schema: courses + per-user enrollments/savedCourses.
    // Keep the legacy education_* rules below during migration; do not expose unpublished courses.
    match /courses/{courseId} {
      allow read: if request.auth != null && resource.data.status == 'published';
      allow create, delete: if false;
      allow update: if false;
    }

    match /users/{userId}/enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && d().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && d().completedLessons == 0
        && d().progress == 0
        && d().status == 'active'
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && d().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && d().courseId == resource.data.courseId
        && d().completedLessons is int
        && d().completedLessons >= 0
        && d().progress is int
        && d().progress >= 0
        && d().progress <= 100
        && d().status in ['active','completed']
        && d().createdAt == resource.data.createdAt
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/savedCourses/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['courseId','createdAt'])
        && d().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && d().createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /education_courses/{courseId} {
      allow read: if request.auth != null && resource.data.published == true;
      allow write: if false;
    }

    match /users/{userId}/education_enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && d().courseId == courseId
        && d().title is string
        && d().title.size() <= 160
        && d().progress == 0
        && d().completedLessons is list
        && d().completedLessons.size() == 0
        && d().status == 'active'
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && d().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && d().courseId == resource.data.courseId
        && d().progress is int
        && d().progress >= 0
        && d().progress <= 100
        && d().completedLessons is list
        && d().completedLessons.size() <= 100
        && d().status in ['active','completed']
        && d().createdAt == resource.data.createdAt
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/arena_history/{historyId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /arena_rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow write: if false;
    }

    match /arena_invites/{inviteCode} {
      allow read, write: if false;
    }


    match /stays/{stayId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null
        && d().ownerId == request.auth.uid
        && d().name is string && d().name.size() > 0 && d().name.size() <= 160
        && d().city is string && d().city.size() > 0 && d().city.size() <= 100
        && d().country is string && d().country.size() > 0 && d().country.size() <= 100
        && d().type in ['hotel','apartment','villa','hostel','resort','guesthouse']
        && d().description is string && d().description.size() <= 3000
        && d().currency is string && d().currency.size() == 3
        && request.resource.data.priceMinor is int && d().priceMinor >= 0
        && d().guests is int && d().guests >= 1 && d().guests <= 50
        && d().status == 'active'
        && d().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && d().ownerId == resource.data.ownerId
        && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /stay_bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.guestUid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
        && d().guestUid == request.auth.uid
        && d().ownerId is string
        && d().stayId is string
        && d().name is string
        && d().city is string
        && d().checkIn is timestamp
        && d().checkOut is timestamp
        && d().checkOut > d().checkIn
        && d().guests is int && d().guests >= 1 && d().guests <= 50
        && d().currency is string && d().currency.size() == 3
        && d().priceMinorPerNight is int && d().priceMinorPerNight >= 0
        && d().status == 'requested'
        && d().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && changedFields().hasOnly(['status'])
        && d().status in ['accepted','rejected','cancelled'];
      allow delete: if request.auth != null && resource.data.guestUid == request.auth.uid;
    }

    match /ride_requests/{rideId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.riderUid;
      allow create: if request.auth != null && d().riderUid == request.auth.uid
        && d().pickup is string && d().pickup.size() > 0 && d().pickup.size() <= 500
        && d().destination is string && d().destination.size() > 0 && d().destination.size() <= 500
        && d().rideType in ['standard','premium','van','bike']
        && d().passengers is int && d().passengers >= 1 && d().passengers <= 8
        && d().status == 'requested' && d().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.riderUid == request.auth.uid
        && d().riderUid == resource.data.riderUid
        && changedFields().hasOnly(['status'])
        && d().status == 'cancelled';
      allow delete: if request.auth != null && resource.data.riderUid == request.auth.uid;
    }
    match /food_items/{itemId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null && d().ownerId == request.auth.uid
        && d().name is string && d().name.size() > 0 && d().name.size() <= 160
        && d().category is string && d().category.size() > 0 && d().category.size() <= 100
        && d().city is string && d().city.size() > 0 && d().city.size() <= 100
        && d().country is string && d().country.size() > 0 && d().country.size() <= 100
        && d().currency is string && d().currency.size() == 3
        && request.resource.data.priceMinor is int && d().priceMinor >= 0
        && d().halal is bool && d().status == 'active'
        && d().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && d().ownerId == resource.data.ownerId && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /safety_places/{placeId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }
    match /users/{userId}/offline_routes/{routeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && d().ownerId == userId
        && d().name is string && d().name.size() > 0 && d().name.size() <= 160
        && d().points is list && d().points.size() >= 2 && d().points.size() <= 500
        && d().createdAt is timestamp;
      allow update: if request.auth != null && request.auth.uid == userId && d().ownerId == resource.data.ownerId && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /emergency_contacts/{contactId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }

    match /entertainment_items/{itemId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && d().creatorId == request.auth.uid
        && d().channelId is string
        && d().channelId.size() > 0
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().description is string
        && d().description.size() <= 3000
        && d().mediaUrl is string
        && d().mediaUrl.size() > 0
        && d().mediaUrl.size() <= 2000
        && d().mediaKind == 'video'
        && d().visibility == 'public'
        && d().createdAt is timestamp
        && get(/databases/$(database)/documents/content_channels/$(d().channelId)).data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && d().creatorId == resource.data.creatorId
        && d().channelId == resource.data.channelId
        && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }

    match /content_channels/{channelId} {
      allow read: if request.auth != null && resource.data.public == true;
      allow create: if request.auth != null && d().ownerId == request.auth.uid
        && d().name is string && d().name.size() > 0 && d().name.size() <= 100
        && d().description is string && d().description.size() <= 1000
        && d().subscribers == 0 && d().public == true && d().createdAt is timestamp;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /subscribers/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid && d().uid == uid && d().createdAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /users/{userId}/watchTogetherTokens/{tokenId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && d().keys().hasOnly(['token','platform','updatedAt'])
        && d().token == tokenId
        && d().token is string
        && d().token.size() > 0
        && d().token.size() <= 4096
        && d().platform in ['android','ios','web']
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/actions/{actionId} {
      allow read: if isOwner(userId);

      // Action documents are created by trusted server code. While an action is
      // pending, the owner may edit only the user-facing draft fields.
      // Approval/execution fields remain server-owned at all times.
      allow create, delete: if false;

      allow update: if isOwner(userId)
        && resource.data.status == 'pending'
        && d().status == 'pending'
        && d().actionType == resource.data.actionType
        && d().createdAt == resource.data.createdAt
        && d().draftVersion is int
        && d().draftVersion == resource.data.draftVersion + 1
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 200
        && d().description is string
        && d().description.size() <= 2000
        && d().payload is map
        && d().payload.keys().size() <= 50
        && d().updatedAt is timestamp
        && changedFields().hasOnly([
          'title','description','payload','draftVersion','updatedAt'
        ]);
    }
    match /users/{userId}/notes/{noteId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/memory/{memoryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/action_audit/{eventId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /agriculture_records/{recordId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && d().ownerId == request.auth.uid
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().type in ['crop','livestock','farm','soil','water','equipment','manufacturing','invention','research','energy','recycling','design']
        && d().location is string
        && d().location.size() <= 200
        && d().visibility == 'public'
        && d().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && d().ownerId == resource.data.ownerId
        && d().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /agriculture_opportunities/{opportunityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow write: if false;
    }

    match /users/{userId}/agricultureNotes/{noteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['title','note','type','createdAt','updatedAt'])
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().note is string
        && d().note.size() > 0
        && d().note.size() <= 5000
        && d().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','soil','fertilizer','nutrients','potassium','nitrogen','phosphorus','pest','plant_disease','irrigation','general','field','farm','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && changedFields().hasOnly(['title','note','type','updatedAt'])
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 160
        && d().note is string
        && d().note.size() > 0
        && d().note.size() <= 5000
        && d().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','soil','fertilizer','nutrients','potassium','nitrogen','phosphorus','pest','plant_disease','irrigation','general','field','farm','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && d().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/agricultureAdvisories/{advisoryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/productionHistory/{entryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/outputLibrary/{outputId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/production_jobs/{jobId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().uid == userId
        && d().title is string
        && d().title.size() > 0
        && d().title.size() <= 200
        && d().type in ['short','film','seriesEpisode']
        && d().status == 'queued'
        && d().engine in ['moneyPrinterTurbo','skyReelsV3','skyReelsV2','ltx2','wan','hunyuan']
        && d().targetMinutes is int
        && d().targetMinutes >= 1
        && d().targetMinutes <= 240
        && d().progress == 0
        && d().retryCount == 0
        && d().cancelRequested == false
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && changedFields().hasOnly(['status','progress','error','cancelRequested','retryCount','updatedAt'])
        && d().updatedAt is timestamp
        && (
          (d().status == 'cancelled'
            && resource.data.status in ['queued','planning','generating','assembling','review']
            && d().cancelRequested == true
            && d().progress == resource.data.progress)
          ||
          (d().status == 'queued'
            && resource.data.status in ['failed','cancelled']
            && d().progress == 0
            && d().cancelRequested == false
            && d().retryCount == resource.data.retryCount + 1)
        );
      allow delete: if isOwner(userId);
    }


    match /auren_global_countries/{iso3} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /auren_global_data/{iso3} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Canonical Education schema. Course documents are server-published only.
    match /courses/{courseId} {
      allow read: if request.auth != null
        && resource.data.status == 'published'
        && resource.data.title is string
        && resource.data.title.size() > 0
        && resource.data.title.size() <= 160
        && resource.data.description is string
        && resource.data.description.size() <= 4000
        && resource.data.category is string
        && resource.data.category.size() <= 100
        && resource.data.teacherId is string
        && resource.data.lessonCount is int
        && resource.data.lessonCount >= 1
        && resource.data.lessonCount <= 500
        && resource.data.skills is list
        && resource.data.skills.size() <= 20;
      allow create, update, delete: if false;

      match /lessons/{lessonId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
          && resource.data.title is string
          && resource.data.title.size() > 0
          && resource.data.title.size() <= 200
          && resource.data.order is int
          && resource.data.order >= 0
          && resource.data.order < get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount;
        allow write: if false;
      }
    }

    match /users/{userId}/enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && d().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && d().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount is int
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount >= 1
        && d().completedLessons == 0
        && d().progress == 0
        && d().status == 'active'
        && d().createdAt is timestamp
        && d().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && d().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && d().courseId == resource.data.courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount is int
        && d().completedLessons >= resource.data.completedLessons
        && d().completedLessons >= 0
        && d().completedLessons <= get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount
        && d().progress * get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount >= d().completedLessons * 100 - (get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount / 2) && d().progress * get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount < d().completedLessons * 100 + (get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount / 2) + 1
        && d().progress >= resource.data.progress
        && d().progress >= 0
        && d().progress <= 100
        && d().status in ['active','completed']
        && ((d().status == 'completed' && d().progress == 100
            && d().completedLessons == get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount)
          || (d().status == 'active' && d().progress < 100))
