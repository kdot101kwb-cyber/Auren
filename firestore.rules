        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().note is string
        && requestData().note.size() > 0
        && requestData().note.size() <= 5000
        && requestData().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','soil','fertilizer','nutrients','potassium','nitrogen','phosphorus','pest','plant_disease','irrigation','general','field','farm','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && requestData().updatedAt is timestamp;
