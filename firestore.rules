      allow delete: if false;
    }

    match /gaming_friend_challenge_keys/{keyId} {
      allow read, write: if false;
    }

    match /gaming_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
