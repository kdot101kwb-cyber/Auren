        && request.resource.data.step < request.resource.data.totalSteps
        && request.resource.data.status in ['active','waiting_response','replied','completed']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (!request.resource.data.keys().hasAny(['conversationId']) || (request.resource.data.conversationId is string && request.resource.data.conversationId.size() <= 128));
