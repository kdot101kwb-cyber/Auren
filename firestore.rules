        && request.resource.data.bio is string && request.resource.data.bio.size() <= 2000
        && request.resource.data.category is string && request.resource.data.category.size() <= 100
        && request.resource.data.city is string && request.resource.data.city.size() <= 100
        && request.resource.data.country is string && request.resource.data.country.size() <= 100
        && request.resource.data.skills is list && request.resource.data.skills.size() <= 30
