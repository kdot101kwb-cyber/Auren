    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid
        && (
          !request.resource.data.keys().hasAny(['communityId'])
          || request.resource.data.communityId == ''
          || (
            request.resource.data.communityId is string
            && request.resource.data.communityId.size() > 0
            && request.auth.uid in get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.memberIds
          )
        );
      allow update: if request.auth != null
        && (
          (resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorId', 'text', 'mediaUrl', 'mediaType', 'createdAt', 'searchText'
            ])
            && request.resource.data.authorId == resource.data.authorId)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && resource.data.likes is int
            && request.resource.data.likes is int
            && (
              (request.resource.data.likes == resource.data.likes + 1
                && getAfter(
                  /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)
                ).data.createdAt != null)
              || (request.resource.data.likes == resource.data.likes - 1
                && !getAfter(
                  /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)
                ).exists())
            )
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'lastCommentId'])
            && resource.data.comments is int
            && request.resource.data.comments == resource.data.comments + 1
            && request.resource.data.lastCommentId is string
            && request.resource.data.lastCommentId.size() > 0
            && getAfter(
              /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentId)
            ).data.authorId == request.auth.uid
          )
        );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.senderName is string
        && request.resource.data.senderName.size() > 0
        && request.resource.data.senderName.size() <= 80
        && request.resource.data.type in ['user','system']
        && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is string
          && request.resource.data.keys().hasOnly([
            'postId', 'authorId', 'text', 'createdAt'
          ]);
        allow update: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/posts/$(postId)
          ).data.comments == (get(
            /databases/$(database)/documents/posts/$(postId)
          ).data.comments > 0
            ? get(
              /databases/$(database)/documents/posts/$(postId)
            ).data.comments - 1
            : 0);
