        && request.resource.data.metric is string && request.resource.data.metric.size() > 0 && request.resource.data.metric.size() <= 80
        && request.resource.data.value is number && request.resource.data.value >= 0 && request.resource.data.value <= 1000000000
        && request.resource.data.unit is string && request.resource.data.unit.size() <= 40
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.keys().hasOnly(['ownerId','sport','metric','value','unit','note','recordedAt']);
      allow update: if isOwner(userId)
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.sport is string && request.resource.data.sport.size() > 0 && request.resource.data.sport.size() <= 80
        && request.resource.data.metric is string && request.resource.data.metric.size() > 0 && request.resource.data.metric.size() <= 80
        && request.resource.data.value is number && request.resource.data.value >= 0 && request.resource.data.value <= 1000000000
        && request.resource.data.unit is string && request.resource.data.unit.size() <= 40
        && request.resource.data.note is string && request.resource.data.note.size() <= 500
        && request.resource.data.recordedAt is timestamp
        && request.resource.data.keys().hasOnly(['ownerId','sport','metric','value','unit','note','recordedAt']);
