      allow create: if request.auth != null
        && request.resource.data.senderUid == request.auth.uid
        && (get(/databases/$(database)/documents/random_calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/random_calls/$(callId)).data.calleeUid == request.auth.uid)
