rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'displayNameLower', 'photoUrl', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.displayNameLower is string
        && request.resource.data.displayNameLower.size() <= 80;
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'displayNameLower', 'photoUrl', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.displayNameLower is string
        && request.resource.data.displayNameLower.size() <= 80
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);

      match /presence/{presenceId} {
        allow read: if request.auth != null;
        allow create, update: if isOwner(userId)
          && presenceId == 'primary'
          && request.resource.data.keys().hasOnly(['online', 'lastSeen'])
          && request.resource.data.online is bool
          && request.resource.data.lastSeen is timestamp;
        allow delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read, write: if isOwner(userId);
      }

      match /actions/{actionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.status == 'pending'
          && request.resource.data.requiresApproval == true
          && request.resource.data.conversationId is string
          && request.resource.data.actionType in ['demo.echo', 'demo.create_note', 'memory.save']
          && request.resource.data.title is string
          && request.resource.data.description is string
          && request.resource.data.payload is map
          && (
            ((request.resource.data.actionType in ['demo.echo', 'demo.create_note'])
              && request.resource.data.payload.keys().hasOnly(['text'])
              && request.resource.data.payload.text is string
              && request.resource.data.payload.text.size() > 0
              && request.resource.data.payload.text.size() <= 2000)
            || (request.resource.data.actionType == 'memory.save'
              && request.resource.data.payload.keys().hasOnly(['key', 'value'])
              && request.resource.data.payload.key is string
              && request.resource.data.payload.key.size() > 0
              && request.resource.data.payload.key.size() <= 120
              && request.resource.data.payload.value is string
              && request.resource.data.payload.value.size() > 0
              && request.resource.data.payload.value.size() <= 2000)
          )
          && request.resource.data.permission == 'userApproval'
          && request.resource.data.riskLevel == 'low'
          && request.resource.data.approvalLevel == 1
          && request.resource.data.keys().hasOnly([
            'conversationId', 'actionType', 'title', 'description', 'payload',
            'permission', 'riskLevel', 'approvalLevel', 'spendingLimitMinor',
            'currency', 'requiresApproval', 'status', 'result', 'createdAt'
          ]);

        allow update: if isOwner(userId)
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.requiresApproval == resource.data.requiresApproval
          && request.resource.data.conversationId == resource.data.conversationId
          && request.resource.data.actionType == resource.data.actionType
          && request.resource.data.title == resource.data.title
          && request.resource.data.description == resource.data.description
          && request.resource.data.payload == resource.data.payload
          && request.resource.data.permission == resource.data.permission
          && request.resource.data.riskLevel == resource.data.riskLevel
          && request.resource.data.approvalLevel == resource.data.approvalLevel
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

        allow delete: if isOwner(userId);
      }

      match /agent_installations/{agentId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && agentId == request.resource.data.agentId
          && request.resource.data.agentId is string
          && request.resource.data.agentId.size() > 0
          && request.resource.data.agentId.size() <= 120
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 120
          && request.resource.data.version is string
          && request.resource.data.version.size() > 0
          && request.resource.data.version.size() <= 40
          && request.resource.data.status == 'active'
          && request.resource.data.installedAt is string
          && request.resource.data.keys().hasOnly([
            'agentId', 'name', 'version', 'status', 'installedAt'
          ]);
        allow update: if isOwner(userId)
          && agentId == resource.data.agentId
          && request.resource.data.agentId == resource.data.agentId
          && request.resource.data.name == resource.data.name
          && request.resource.data.version == resource.data.version
          && request.resource.data.installedAt == resource.data.installedAt
          && request.resource.data.status in ['active', 'paused']
          && request.resource.data.keys().hasOnly([
            'agentId', 'name', 'version', 'status', 'installedAt'
          ]);
        allow delete: if isOwner(userId);
      }

      match /agent_permissions/{permissionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && permissionId == 'primary'
          && request.resource.data.agentId == 'primary'
          && request.resource.data.enabled is bool
          && request.resource.data.allowedActions is list
          && request.resource.data.allowedActions.size() <= 100
          && (request.resource.data.dailySpendingLimitMinor == null
            || (request.resource.data.dailySpendingLimitMinor is int
              && request.resource.data.dailySpendingLimitMinor >= 0))
          && request.resource.data.spentTodayMinor == 0
          && request.resource.data.currency is string
          && request.resource.data.currency.matches('^[A-Z]{3}$')
          && request.resource.data.keys().hasOnly([
            'agentId', 'enabled', 'allowedActions', 'dailySpendingLimitMinor',
            'spentTodayMinor', 'currency', 'updatedAt'
          ]);

        allow update: if isOwner(userId)
          && permissionId == 'primary'
          && request.resource.data.agentId == resource.data.agentId
          && request.resource.data.enabled is bool
          && request.resource.data.allowedActions is list
          && request.resource.data.allowedActions.size() <= 100
          && (request.resource.data.dailySpendingLimitMinor == null
            || (request.resource.data.dailySpendingLimitMinor is int
              && request.resource.data.dailySpendingLimitMinor >= 0))
          && request.resource.data.spentTodayMinor == resource.data.spentTodayMinor
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.keys().hasOnly([
            'agentId', 'enabled', 'allowedActions', 'dailySpendingLimitMinor',
            'spentTodayMinor', 'currency', 'updatedAt'
          ]);

        allow delete: if isOwner(userId);
      }

      match /agents/{agentId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && agentId == 'primary'
          && request.resource.data.name is string
          && request.resource.data.version is string
          && request.resource.data.status in ['active', 'paused', 'revoked'];
        allow delete: if isOwner(userId);
      }

      match /agent_trust/{agentId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /wallet/{walletId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /wallet_transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /action_executions/{executionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /action_audit/{eventId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /disputes/{disputeId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /agent_liability/{liabilityId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /disputes/{disputeId}/evidence/{evidenceId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /memory/{memoryId} {
        allow read, write: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }

      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }
    }

    match /agent_simulations/{simulationId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /plugin_quotas/{quotaId} {
      allow read, write: if false;
    }

    match /plugin_invocations/{invocationId} {
      allow read, write: if false;
    }

    match /agent_reputation/{agentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /agent_reviews/{reviewId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /agent_risk/{agentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /plugin_artifacts/{artifactId} {
      allow read, write: if false;
    }

    match /agent_listings/{agentId} {
      allow read: if request.auth != null && resource.data.state == 'published';
      allow write: if false;
    }

    match /agent_messages/{messageId} {
      allow read: if request.auth != null
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid);
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null
        && (
          (resource.data.authorId == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'authorId', 'text', 'createdAt', 'searchText'
            ])
            && request.resource.data.authorId == resource.data.authorId)
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likes'])
            && resource.data.likes is int
            && request.resource.data.likes is int
            && (
              (request.resource.data.likes == resource.data.likes + 1
                && getAfter(
                  /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)
                ).data.createdAt != null)
              || (request.resource.data.likes == resource.data.likes - 1
                && !getAfter(
                  /databases/$(database)/documents/posts/$(postId)/likes/$(request.auth.uid)
                ).exists())
            )
          )
          || (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['comments', 'lastCommentId'])
            && resource.data.comments is int
            && request.resource.data.comments == resource.data.comments + 1
            && request.resource.data.lastCommentId is string
            && request.resource.data.lastCommentId.size() > 0
            && getAfter(
              /databases/$(database)/documents/posts/$(postId)/comments/$(request.resource.data.lastCommentId)
            ).data.authorId == request.auth.uid
          )
        );
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null
          && request.resource.data.authorId == request.auth.uid
          && request.resource.data.postId == postId
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000
          && request.resource.data.createdAt is string
          && request.resource.data.keys().hasOnly([
            'postId', 'authorId', 'text', 'createdAt'
          ]);
        allow update: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
        allow delete: if request.auth != null
          && resource.data.authorId == request.auth.uid
          && getAfter(
            /databases/$(database)/documents/posts/$(postId)
          ).data.comments == (get(
            /databases/$(database)/documents/posts/$(postId)
          ).data.comments > 0
            ? get(
              /databases/$(database)/documents/posts/$(postId)
            ).data.comments - 1
            : 0);
      }
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'displayNameLower', 'photoUrl', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80;
      allow update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly([
          'displayName', 'displayNameLower', 'photoUrl', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId
        && request.resource.data.followingId is string
        && request.resource.data.followerId != request.resource.data.followingId
        && request.resource.data.keys().hasOnly([
          'followerId', 'followingId', 'createdAt'
        ]);
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /businesses/{businessId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /places/{placeId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /opportunities/{opportunityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /message_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.conversationId is string
        && request.resource.data.messageId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'conversationId', 'messageId', 'reason', 'createdAt'
        ]);
      allow read, update, delete: if false;
    }

    match /message_blocks/{blockId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'blockedUid', 'createdAt'
        ]);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.memberIds.hasAll([request.auth.uid])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.isAi is bool
        && request.resource.data.keys().hasOnly([
          'memberIds', 'title', 'isAi', 'updatedAt', 'lastMessage', 'lastMessageAt', 'type', 'ownerId'
        ])
        && request.resource.data.type in ['direct', 'group', 'ai']
        && (
          (!request.resource.data.isAi && request.resource.data.type == 'group'
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.memberIds.size() >= 3)
          || (!request.resource.data.isAi && request.resource.data.type == 'direct'
            && request.resource.data.memberIds.size() == 2
            && request.resource.data.ownerId == null)
          || (request.resource.data.isAi && request.resource.data.type == 'ai'
            && request.resource.data.memberIds.size() == 1
            && !request.resource.data.keys().hasAny(['ownerId']))
        );
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.isAi == resource.data.isAi
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && (
          (
            request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'updatedAt', 'lastMessage', 'lastMessageAt'
            ])
          )
          || (
            resource.data.type == 'group'
            && request.auth.uid == resource.data.ownerId
            && request.resource.data.ownerId is string
            && request.resource.data.ownerId in resource.data.memberIds
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId'])
          )
          || (
            resource.data.type == 'group'
            && request.auth.uid == resource.data.ownerId
            && request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() >= 2
            && request.resource.data.memberIds.size() <= 50
            && request.resource.data.memberIds.hasAll([resource.data.ownerId])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          )
          || (
            resource.data.type == 'group'
            && request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() >= 2
            && request.resource.data.memberIds.size() <= 50
            && request.resource.data.memberIds.hasAll([resource.data.ownerId])
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.size() + 1 == resource.data.memberIds.size()
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          )
        );
      allow delete: if request.auth != null
        && (
          (resource.data.type == 'group' && resource.data.ownerId == request.auth.uid)
          || (resource.data.type != 'group' && request.auth.uid in resource.data.memberIds)
        );

      match /reads/{userId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.memberIds
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 12000
          && request.resource.data.keys().hasOnly([
            'senderId', 'text', 'createdAt', 'isAi'
          ])
          && (
            (!request.resource.data.isAi && request.resource.data.senderId == request.auth.uid)
            || (
              request.resource.data.isAi
              && request.resource.data.senderId == 'auren-ai'
              && get(/databases/$(database)/documents/conversations/$(conversationId)).data.isAi == true
            )
          );
        allow update, delete: if false;
      }
    }
  }
}
