        && request.resource.data.matchedSkills is list
        && request.resource.data.matchedSkills.size() <= 30
        && request.resource.data.missingSkills is list
        && request.resource.data.missingSkills.size() <= 30
        && request.resource.data.evidence is list
        && request.resource.data.evidence.size() <= 20
        && request.resource.data.createdAt is timestamp
        && request.resource.data.expiresAt is timestamp
        && request.resource.data.keys().hasOnly(['ownerId','scoutId','type','title','description','sourceType','sourceId','status','score','matchedSkills','missingSkills','evidence','createdAt','expiresAt']);
      allow update: if isOwner(userId)
