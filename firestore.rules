    match /auren_game_lobbies/{lobbyId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && d().hostId == request.auth.uid
        && d().guestId == null
        && d().players is list
        && d().players.size() == 1
        && d().players[0] == request.auth.uid
        && d().gameIndex is int
        && d().gameIndex >= 0
        && d().gameIndex <= 59
        && d().status == 'waiting'
        && d().turnPlayerId == request.auth.uid
        && d().stateVersion == 0
        && d().state is map
        && d().state.size() == 0;
      // Only the second player may transition a waiting lobby to playing.
      // Match state itself remains immutable from clients; game moves go through
      // the trusted Cloud Function.
      allow update: if request.auth != null
        && resource.data.status == 'waiting'
        && resource.data.players is list
        && resource.data.players.size() == 1
        && d().players is list
        && d().players.size() == 2
        && d().players[0] == resource.data.players[0]
        && d().players[1] == request.auth.uid
        && d().guestId == request.auth.uid
        && d().hostId == resource.data.hostId
        && d().gameIndex == resource.data.gameIndex
        && d().status == 'playing'
