  match /random_calls/{callId} {
    allow read: if request.auth != null
      && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
    allow create: if request.auth != null
      && requestData().callerUid == request.auth.uid
      && requestData().calleeUid is string
      && requestData().calleeUid != request.auth.uid
      && requestData().kind in ['audio','video']
      && requestData().status == 'ringing'
      && requestData().keys().hasOnly(['callerUid','calleeUid','kind','status','createdAt']);
    allow update: if request.auth != null
      && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid)
      && (
        (changedFields().hasOnly(['offer'])
          && resource.data.callerUid == request.auth.uid
          && requestData().offer is map
          && requestData().offer.sdp is string
          && requestData().offer.type is string)
        || (changedFields().hasOnly(['answer','status'])
          && resource.data.calleeUid == request.auth.uid
          && resource.data.status == 'ringing'
          && requestData().status == 'connected'
          && requestData().answer is map
          && requestData().answer.sdp is string
          && requestData().answer.type is string)
        || (changedFields().hasOnly(['status','endedBy','endedAt'])
          && requestData().status == 'ended'
          && requestData().endedBy == request.auth.uid
          && requestData().endedAt is timestamp)
      );
    allow delete: if false;
    match /candidates/{candidateId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/random_calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/random_calls/$(callId)).data.calleeUid == request.auth.uid);
      allow create: if request.auth != null
        && requestData().senderUid == request.auth.uid
        && (get(/databases/$(database)/documents/random_calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/random_calls/$(callId)).data.calleeUid == request.auth.uid)
        && requestData().candidate is string
        && (requestData().sdpMid == null || requestData().sdpMid is string)
        && (requestData().sdpMLineIndex == null || requestData().sdpMLineIndex is int)
        && requestData().keys().hasOnly(['senderUid','candidate','sdpMid','sdpMLineIndex','createdAt']);
      allow update, delete: if false;
    }
  }

    match /gaming_friend_challenges/{challengeId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      // Creation and lifecycle are server-authoritative.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /gaming_friend_challenge_keys/{keyId} {
      allow read, write: if false;
    }

    match /gaming_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
      allow create: if request.auth != null
        && requestData().hostUid == request.auth.uid
        && requestData().roomId is string
        && requestData().roomId.size() > 0
        && requestData().inviteCode == inviteCode
        && requestData().createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /auren_game_matchmaking/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /auren_game_lobbies/{lobbyId}/private_players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/auren_game_lobbies/$(lobbyId))
        && request.auth.uid in get(/databases/$(database)/documents/auren_game_lobbies/$(lobbyId)).data.players;
      allow create, update, delete: if false;
    }

    match /auren_game_lobbies/{lobbyId}/server/{docId} {
      allow read, write: if false;
    }

    match /auren_game_lobbies/{lobbyId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && requestData().hostId == request.auth.uid
        && requestData().guestId == null
        && requestData().players is list
        && requestData().players.size() == 1
        && requestData().players[0] == request.auth.uid
        && requestData().gameIndex is int
        && requestData().gameIndex >= 0
        && requestData().gameIndex <= 59
        && requestData().status == 'waiting'
        && requestData().turnPlayerId == request.auth.uid
        && requestData().stateVersion == 0
        && requestData().state is map
        && requestData().state.size() == 0;
      // Only the second player may transition a waiting lobby to playing.
      // Match state itself remains immutable from clients; game moves go through
      // the trusted Cloud Function.
      allow update: if request.auth != null
        && resource.data.status == 'waiting'
        && resource.data.players is list
        && resource.data.players.size() == 1
        && requestData().players is list
        && requestData().players.size() == 2
        && requestData().players[0] == resource.data.players[0]
        && requestData().players[1] == request.auth.uid
        && requestData().guestId == request.auth.uid
        && requestData().hostId == resource.data.hostId
        && requestData().gameIndex == resource.data.gameIndex
        && requestData().status == 'playing'
        && requestData().turnPlayerId == resource.data.turnPlayerId
        && requestData().stateVersion == resource.data.stateVersion
        && requestData().state == resource.data.state;
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid
        && resource.data.status != 'playing';
    }

    match /gaming_rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow create: if request.auth != null
        && requestData().hostUid == request.auth.uid
        && requestData().playerUids is list
        && requestData().playerUids.size() == 1
        && requestData().playerUids[0] == request.auth.uid
        && requestData().gameId in ['tic_tac_toe','rock_paper_scissors','connect_four']
        && requestData().inviteCode is string
        && requestData().inviteCode.size() == 6
        && requestData().board is list
        && requestData().board.size() in [9,3,42]
        && requestData().turnUid == request.auth.uid
        && requestData().status == 'waiting';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.playerUids
        && requestData().hostUid == resource.data.hostUid
        && requestData().gameId == resource.data.gameId
        && requestData().inviteCode == resource.data.inviteCode
        && requestData().playerUids is list
        && requestData().playerUids.size() >= resource.data.playerUids.size()
        && requestData().playerUids.size() <= 2
        && requestData().playerUids.hasAll(resource.data.playerUids)
        && requestData().board == resource.data.board
        && requestData().winner == resource.data.winner
        && requestData().draw == resource.data.draw
        && requestData().turnUid == resource.data.turnUid
        && requestData().status in ['waiting','ready']
        && changedFields().hasOnly(['playerUids','marks','status','updatedAt'])
        && requestData().updatedAt is timestamp
        && (
          requestData().playerUids.size() == resource.data.playerUids.size()
          || (
            resource.data.status == 'waiting'
            && resource.data.playerUids.size() == 1
            && requestData().playerUids.size() == 2
            && request.auth.uid in requestData().playerUids
          )
        );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids
          && requestData().senderUid == request.auth.uid
          && requestData().text is string
          && requestData().text.size() > 0
          && requestData().text.size() <= 500
          && requestData().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/gaming_challenges/{challengeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && requestData().challengeId == 'daily_tic_tac_toe'
        && requestData().xp == 25
        && requestData().completedAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{userId}/gaming_profile/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /users/{userId}/gaming_results/{resultId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /watch_together_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
      allow create: if request.auth != null
        && requestData().hostUid == request.auth.uid
        && requestData().roomId is string
        && requestData().roomId.size() > 0
        && requestData().inviteCode == inviteCode
        && requestData().createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /watch_together_rooms/{roomId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && requestData().hostUid == request.auth.uid
        && requestData().memberIds is list
        && requestData().memberIds.size() == 1
        && requestData().memberIds[0] == request.auth.uid
        && requestData().inviteCode is string
        && requestData().inviteCode.size() == 6
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().channelId is string
        && requestData().channelId.size() > 0
        && requestData().channelName is string
        && requestData().channelName.size() > 0
        && requestData().positionSeconds is number
        && requestData().positionSeconds >= 0
        && requestData().positionSeconds <= 86400
        && requestData().isPlaying is bool
        && requestData().status == 'waiting'
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;

      // Playback/channel state is host-authoritative.
      // Membership changes are separately constrained below.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && requestData().inviteCode == resource.data.inviteCode
        && requestData().memberIds is list
        && requestData().memberIds.size() <= 8
        && requestData().updatedAt is timestamp
        && (
          // Host can update playback/channel state, but cannot alter membership.
          (
            request.auth.uid == resource.data.hostUid
            && requestData().hostUid == resource.data.hostUid
            && requestData().memberIds == resource.data.memberIds
            && changedFields().hasOnly([
              'channelId','channelName','positionSeconds','isPlaying','updatedAt'
            ])
            && requestData().channelId is string
            && requestData().channelId.size() > 0
            && requestData().channelName is string
            && requestData().channelName.size() > 0
            && requestData().positionSeconds is number
            && requestData().positionSeconds >= 0
            && requestData().positionSeconds <= 86400
            && requestData().isPlaying is bool
            && requestData().status == resource.data.status
          )
          ||
          // A member can join; only the host can change hostUid.
          (
            requestData().hostUid == resource.data.hostUid
            && requestData().status in ['waiting','ready']
            && !(request.auth.uid in resource.data.memberIds)
            && requestData().memberIds.size() == resource.data.memberIds.size() + 1
            && requestData().memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in requestData().memberIds
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // A member can leave themselves.
          (
            requestData().hostUid == resource.data.hostUid
            && requestData().status in ['waiting','ready']
            && requestData().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(requestData().memberIds)
            && !(request.auth.uid in requestData().memberIds)
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // The current host can leave and transfer host ownership to a remaining member.
          (
            request.auth.uid == resource.data.hostUid
            && requestData().hostUid is string
            && requestData().hostUid != resource.data.hostUid
            && requestData().hostUid in requestData().memberIds
            && requestData().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(requestData().memberIds)
            && !(request.auth.uid in requestData().memberIds)
            && requestData().status in ['waiting','ready']
            && changedFields().hasOnly([
              'hostUid','memberIds','status','updatedAt'
            ])
          )
        );

      // Only the host can delete a room.
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      match /presence/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().uid == request.auth.uid
          && requestData().online is bool
          && requestData().lastSeen is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /activity/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().actorUid == request.auth.uid
          && requestData().type is string
          && requestData().type.size() > 0
          && requestData().type.size() <= 40
          && requestData().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /typing/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().uid == request.auth.uid
          && requestData().typing is bool
          && requestData().updatedAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /reactions/{reactionId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().senderUid == request.auth.uid
          && requestData().emoji is string
          && requestData().emoji.size() > 0
          && requestData().emoji.size() <= 8
          && requestData().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().senderUid == request.auth.uid
          && requestData().text is string
          && requestData().text.size() > 0
          && requestData().text.size() <= 500
          && requestData().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    // Canonical Education schema: courses + per-user enrollments/savedCourses.
    // Keep the legacy education_* rules below during migration; do not expose unpublished courses.
    match /courses/{courseId} {
      allow read: if request.auth != null && resource.data.status == 'published';
      allow create, delete: if false;
      allow update: if false;
    }

    match /users/{userId}/enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && requestData().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && requestData().completedLessons == 0
        && requestData().progress == 0
        && requestData().status == 'active'
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && requestData().courseId == resource.data.courseId
        && requestData().completedLessons is int
        && requestData().completedLessons >= 0
        && requestData().progress is int
        && requestData().progress >= 0
        && requestData().progress <= 100
        && requestData().status in ['active','completed']
        && requestData().createdAt == resource.data.createdAt
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/savedCourses/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','createdAt'])
        && requestData().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && requestData().createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /education_courses/{courseId} {
      allow read: if request.auth != null && resource.data.published == true;
      allow write: if false;
    }

    match /users/{userId}/education_enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && requestData().courseId == courseId
        && requestData().title is string
        && requestData().title.size() <= 160
        && requestData().progress == 0
        && requestData().completedLessons is list
        && requestData().completedLessons.size() == 0
        && requestData().status == 'active'
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && requestData().courseId == resource.data.courseId
        && requestData().progress is int
        && requestData().progress >= 0
        && requestData().progress <= 100
        && requestData().completedLessons is list
        && requestData().completedLessons.size() <= 100
        && requestData().status in ['active','completed']
        && requestData().createdAt == resource.data.createdAt
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/arena_history/{historyId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /arena_rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow write: if false;
    }

    match /arena_invites/{inviteCode} {
      allow read, write: if false;
    }


    match /stays/{stayId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null
        && requestData().ownerId == request.auth.uid
        && requestData().name is string && requestData().name.size() > 0 && requestData().name.size() <= 160
        && requestData().city is string && requestData().city.size() > 0 && requestData().city.size() <= 100
        && requestData().country is string && requestData().country.size() > 0 && requestData().country.size() <= 100
        && requestData().type in ['hotel','apartment','villa','hostel','resort','guesthouse']
        && requestData().description is string && requestData().description.size() <= 3000
        && requestData().currency is string && requestData().currency.size() == 3
        && requestData().priceMinor is int && requestData().priceMinor >= 0
        && requestData().guests is int && requestData().guests >= 1 && requestData().guests <= 50
        && requestData().status == 'active'
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && requestData().ownerId == resource.data.ownerId
        && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /stay_bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.guestUid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
        && requestData().guestUid == request.auth.uid
        && requestData().ownerId is string
        && requestData().stayId is string
        && requestData().name is string
        && requestData().city is string
        && requestData().checkIn is timestamp
        && requestData().checkOut is timestamp
        && requestData().checkOut > requestData().checkIn
        && requestData().guests is int && requestData().guests >= 1 && requestData().guests <= 50
        && requestData().currency is string && requestData().currency.size() == 3
        && requestData().priceMinorPerNight is int && requestData().priceMinorPerNight >= 0
        && requestData().status == 'requested'
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && changedFields().hasOnly(['status'])
        && requestData().status in ['accepted','rejected','cancelled'];
      allow delete: if request.auth != null && resource.data.guestUid == request.auth.uid;
    }

    match /ride_requests/{rideId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.riderUid;
      allow create: if request.auth != null && requestData().riderUid == request.auth.uid
        && requestData().pickup is string && requestData().pickup.size() > 0 && requestData().pickup.size() <= 500
        && requestData().destination is string && requestData().destination.size() > 0 && requestData().destination.size() <= 500
        && requestData().rideType in ['standard','premium','van','bike']
        && requestData().passengers is int && requestData().passengers >= 1 && requestData().passengers <= 8
        && requestData().status == 'requested' && requestData().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.riderUid == request.auth.uid
        && requestData().riderUid == resource.data.riderUid
        && changedFields().hasOnly(['status'])
        && requestData().status == 'cancelled';
      allow delete: if request.auth != null && resource.data.riderUid == request.auth.uid;
    }
    match /food_items/{itemId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null && requestData().ownerId == request.auth.uid
        && requestData().name is string && requestData().name.size() > 0 && requestData().name.size() <= 160
        && requestData().category is string && requestData().category.size() > 0 && requestData().category.size() <= 100
        && requestData().city is string && requestData().city.size() > 0 && requestData().city.size() <= 100
        && requestData().country is string && requestData().country.size() > 0 && requestData().country.size() <= 100
        && requestData().currency is string && requestData().currency.size() == 3
        && requestData().priceMinor is int && requestData().priceMinor >= 0
        && requestData().halal is bool && requestData().status == 'active'
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && requestData().ownerId == resource.data.ownerId && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /safety_places/{placeId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }
    match /users/{userId}/offline_routes/{routeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && requestData().ownerId == userId
        && requestData().name is string && requestData().name.size() > 0 && requestData().name.size() <= 160
        && requestData().points is list && requestData().points.size() >= 2 && requestData().points.size() <= 500
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null && request.auth.uid == userId && requestData().ownerId == resource.data.ownerId && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /emergency_contacts/{contactId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }

    match /entertainment_items/{itemId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && requestData().creatorId == request.auth.uid
        && requestData().channelId is string
        && requestData().channelId.size() > 0
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().description is string
        && requestData().description.size() <= 3000
        && requestData().mediaUrl is string
        && requestData().mediaUrl.size() > 0
        && requestData().mediaUrl.size() <= 2000
        && requestData().mediaKind == 'video'
        && requestData().visibility == 'public'
        && requestData().createdAt is timestamp
        && get(/databases/$(database)/documents/content_channels/$(requestData().channelId)).data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && requestData().creatorId == resource.data.creatorId
        && requestData().channelId == resource.data.channelId
        && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }

    match /content_channels/{channelId} {
      allow read: if request.auth != null && resource.data.public == true;
      allow create: if request.auth != null && requestData().ownerId == request.auth.uid
        && requestData().name is string && requestData().name.size() > 0 && requestData().name.size() <= 100
        && requestData().description is string && requestData().description.size() <= 1000
        && requestData().subscribers == 0 && requestData().public == true && requestData().createdAt is timestamp;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /subscribers/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid && requestData().uid == uid && requestData().createdAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /users/{userId}/watchTogetherTokens/{tokenId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && requestData().keys().hasOnly(['token','platform','updatedAt'])
        && requestData().token == tokenId
        && requestData().token is string
        && requestData().token.size() > 0
        && requestData().token.size() <= 4096
        && requestData().platform in ['android','ios','web']
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/actions/{actionId} {
      allow read: if isOwner(userId);

      // Action documents are created by trusted server code. While an action is
      // pending, the owner may edit only the user-facing draft fields.
      // Approval/execution fields remain server-owned at all times.
      allow create, delete: if false;

      allow update: if isOwner(userId)
        && resource.data.status == 'pending'
        && requestData().status == 'pending'
        && requestData().actionType == resource.data.actionType
        && requestData().createdAt == resource.data.createdAt
        && requestData().draftVersion is int
        && requestData().draftVersion == resource.data.draftVersion + 1
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 200
        && requestData().description is string
        && requestData().description.size() <= 2000
        && requestData().payload is map
        && requestData().payload.keys().size() <= 50
        && requestData().updatedAt is timestamp
        && changedFields().hasOnly([
          'title','description','payload','draftVersion','updatedAt'
        ]);
    }
    match /users/{userId}/notes/{noteId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/memory/{memoryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/action_audit/{eventId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /agriculture_records/{recordId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && requestData().ownerId == request.auth.uid
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','farm','soil','water','equipment','fertilizer','nutrients','pest','plant_disease','irrigation','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && requestData().location is string
        && requestData().location.size() <= 200
        && requestData().visibility == 'public'
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && requestData().ownerId == resource.data.ownerId
        && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /agriculture_opportunities/{opportunityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow write: if false;
    }

    match /users/{userId}/agricultureNotes/{noteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['title','note','type','createdAt','updatedAt'])
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().note is string
        && requestData().note.size() > 0
        && requestData().note.size() <= 5000
        && requestData().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','soil','fertilizer','nutrients','potassium','nitrogen','phosphorus','pest','plant_disease','irrigation','general','field','farm','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && changedFields().hasOnly(['title','note','type','updatedAt'])
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().note is string
        && requestData().note.size() > 0
        && requestData().note.size() <= 5000
        && requestData().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','soil','fertilizer','nutrients','potassium','nitrogen','phosphorus','pest','plant_disease','irrigation','general','field','farm','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/agricultureAdvisories/{advisoryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/productionHistory/{entryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/outputLibrary/{outputId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /users/{userId}/production_jobs/{jobId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().uid == userId
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 200
        && requestData().type in ['short','film','seriesEpisode']
        && requestData().status == 'queued'
        && requestData().engine in ['moneyPrinterTurbo','skyReelsV3','skyReelsV2','ltx2','wan','hunyuan']
        && requestData().targetMinutes is int
        && requestData().targetMinutes >= 1
        && requestData().targetMinutes <= 240
        && requestData().progress == 0
        && requestData().retryCount == 0
        && requestData().cancelRequested == false
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && changedFields().hasOnly(['status','progress','error','cancelRequested','retryCount','updatedAt'])
        && requestData().updatedAt is timestamp
        && (
          (requestData().status == 'cancelled'
            && resource.data.status in ['queued','planning','generating','assembling','review']
            && requestData().cancelRequested == true
            && requestData().progress == resource.data.progress)
          ||
          (requestData().status == 'queued'
            && resource.data.status in ['failed','cancelled']
            && requestData().progress == 0
            && requestData().cancelRequested == false
            && requestData().retryCount == resource.data.retryCount + 1)
        );
      allow delete: if isOwner(userId);
    }


    match /auren_global_countries/{iso3} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /auren_global_data/{iso3} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    // Canonical Education schema. Course documents are server-published only.
    match /courses/{courseId} {
      allow read: if request.auth != null
        && resource.data.status == 'published'
        && resource.data.title is string
        && resource.data.title.size() > 0
        && resource.data.title.size() <= 160
        && resource.data.description is string
        && resource.data.description.size() <= 4000
        && resource.data.category is string
        && resource.data.category.size() <= 100
        && resource.data.teacherId is string
        && resource.data.lessonCount is int
        && resource.data.lessonCount >= 1
        && resource.data.lessonCount <= 500
        && resource.data.skills is list
        && resource.data.skills.size() <= 20;
      allow create, update, delete: if false;

      match /lessons/{lessonId} {
        allow read: if request.auth != null
          && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
          && resource.data.title is string
          && resource.data.title.size() > 0
          && resource.data.title.size() <= 200
          && resource.data.order is int
          && resource.data.order >= 0
          && resource.data.order < get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount;
        allow write: if false;
      }
    }

    match /users/{userId}/enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && requestData().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount is int
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount >= 1
        && requestData().completedLessons == 0
        && requestData().progress == 0
        && requestData().status == 'active'
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && requestData().courseId == resource.data.courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount is int
        && requestData().completedLessons >= resource.data.completedLessons
        && requestData().completedLessons >= 0
        && requestData().completedLessons <= get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount
        && requestData().progress * get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount >= requestData().completedLessons * 100 - (get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount / 2) && requestData().progress * get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount < requestData().completedLessons * 100 + (get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount / 2) + 1
        && requestData().progress >= resource.data.progress
        && requestData().progress >= 0
        && requestData().progress <= 100
        && requestData().status in ['active','completed']
        && ((requestData().status == 'completed' && requestData().progress == 100
            && requestData().completedLessons == get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount)
          || (requestData().status == 'active' && requestData().progress < 100))
        && requestData().createdAt == resource.data.createdAt
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/savedCourses/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','createdAt'])
        && requestData().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && requestData().createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    // Personal learning plans generated by the Education Learning Engine.
    match /users/{userId}/learningPlans/{planId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && requestData().keys().hasOnly([
          'engineVersion','nextAction','lastCompletedTask','lastActivityAt','updatedAt'
        ])
        && (!requestData().keys().hasAny(['engineVersion']) || requestData().engineVersion is int)
        && (!requestData().keys().hasAny(['nextAction']) || requestData().nextAction is string)
        && (!requestData().keys().hasAny(['lastCompletedTask']) || requestData().lastCompletedTask is string)
        && (!requestData().keys().hasAny(['lastActivityAt']) || requestData().lastActivityAt is timestamp)
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);

      match /tasks/{taskId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && requestData().keys().hasOnly([
            'title','type','minutes','level','focusAreas','completed','order','dueAt','createdAt'
          ])
          && requestData().title is string
          && requestData().title.size() > 0
          && requestData().title.size() <= 200
          && requestData().type in ['review','lesson','practice','assessment']
          && requestData().minutes is int
          && requestData().minutes >= 5
          && requestData().minutes <= 180
          && requestData().level is string
          && requestData().level.size() <= 40
          && requestData().focusAreas is list
          && requestData().focusAreas.size() <= 10
          && requestData().completed == false
          && requestData().order is int
          && requestData().order >= 0
          && requestData().dueAt is timestamp
          && requestData().createdAt is timestamp;
        allow update: if isOwner(userId)
          && changedFields().hasOnly([
            'completed','completedAt'
          ])
          && requestData().completed == true
          && requestData().completedAt is timestamp;
        allow delete: if isOwner(userId);
      }
    }

    match /users/{userId}/educationSkills/{skillId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && requestData().keys().hasOnly(['name','level','lastActivityAt','source'])
        && requestData().name is string
        && requestData().name.size() > 0
        && requestData().name.size() <= 160
        && requestData().level is string
        && requestData().level.size() <= 40
        && requestData().lastActivityAt is timestamp
        && requestData().source == 'learning_plan';
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/emergency_contacts/{contactId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['ownerId','name','phone','relation','primary','createdAt','updatedAt'])
        && requestData().ownerId == userId
        && requestData().name is string
        && requestData().name.size() > 0
        && requestData().name.size() <= 120
        && requestData().phone is string
        && requestData().phone.size() > 0
        && requestData().phone.size() <= 40
        && requestData().relation is string
        && requestData().relation.size() <= 80
        && requestData().primary is bool
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && requestData().keys().hasOnly(['ownerId','name','phone','relation','primary','createdAt','updatedAt'])
        && requestData().ownerId == resource.data.ownerId
        && requestData().ownerId == userId
        && requestData().name is string
        && requestData().name.size() > 0
        && requestData().name.size() <= 120
        && requestData().phone is string
        && requestData().phone.size() > 0
        && requestData().phone.size() <= 40
        && requestData().relation is string
        && requestData().relation.size() <= 80
        && requestData().primary is bool
        && requestData().createdAt == resource.data.createdAt
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /supplier_contact_requests/{requestId} {
      allow read: if request.auth != null && resource.data.requesterUid == request.auth.uid;
      allow write: if false;
    }

    match /supplier_rfqs/{rfqId} {
      allow read: if request.auth != null && resource.data.requesterUid == request.auth.uid;
      allow write: if false;
    }


    match /kids_activities/{activityId} {
      allow read: if request.auth != null
        && resource.data.published == true
        && resource.data.title is string
        && resource.data.title.size() > 0
        && resource.data.title.size() <= 160
        && resource.data.description is string
        && resource.data.description.size() <= 1000
        && resource.data.category is string
        && resource.data.category.size() <= 40
        && resource.data.minAge in [6, 9, 13]
        && resource.data.maxAge in [8, 11, 17]
        && resource.data.minutes is int
        && resource.data.minutes >= 5
        && resource.data.minutes <= 60;
      allow write: if false;
    }

match /users/{userId}/kids_activity_progress/{activityId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && requestData().keys().hasOnly(['activityId','completed','updatedAt'])
        && requestData().activityId == activityId
        && requestData().completed is bool
        && requestData().updatedAt is timestamp
        && get(/databases/$(database)/documents/kids_activities/$(activityId)).data.published == true;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/kids/{settingId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && settingId == 'parent_settings'
        && requestData().keys().hasOnly(['ageBand','aiTutor','externalLinks','dailyMinutes','updatedAt'])
        && requestData().ageBand in [6, 9, 13]
        && requestData().aiTutor is bool
        && requestData().externalLinks is bool
        && requestData().dailyMinutes in [15, 30, 60, 90, 120, 180, 240]
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }
    
    
    // Canonical Family Hub / Family Pot. Financial entries are user-owned;
    // no cross-user reads or writes are allowed from the client.
    match /users/{userId}/familyMembers/{memberId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['name','relation','createdAt','updatedAt'])
        && requestData().name is string
        && requestData().name.size() > 0
        && requestData().name.size() <= 120
        && requestData().relation is string
        && requestData().relation.size() <= 80
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && requestData().keys().hasOnly(['name','relation','createdAt','updatedAt'])
        && requestData().name is string
        && requestData().name.size() > 0
        && requestData().name.size() <= 120
        && requestData().relation is string
        && requestData().relation.size() <= 80
        && requestData().createdAt == resource.data.createdAt
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/familyPot/{entryId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['title','amountMinor','currency','createdAt'])
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().amountMinor is int
        && requestData().amountMinor >= 0
        && requestData().amountMinor <= 1000000000000
        && requestData().currency is string
        && requestData().currency.size() == 3
        && requestData().createdAt is timestamp;
      allow update, delete: if false;
    }

    // Canonical Health & Sports daily check-ins. Health guidance remains general;
    // sensitive medical actions are not performed by client writes.
    match /users/{userId}/healthCheckins/{checkinId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && checkinId.size() <= 40
        && requestData().keys().hasOnly([
          'activityMinutes','waterGlasses','sleepHours','mood','updatedAt'
        ])
        && requestData().activityMinutes is int
        && requestData().activityMinutes >= 0
        && requestData().activityMinutes <= 1440
        && requestData().waterGlasses is int
        && requestData().waterGlasses >= 0
        && requestData().waterGlasses <= 50
        && requestData().sleepHours is number
        && requestData().sleepHours >= 0
        && requestData().sleepHours <= 24
        && requestData().mood is int
        && requestData().mood >= 1
        && requestData().mood <= 5
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

match /users/{userId}/savedProperties/{propertyId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if false;
    }

    match /community_polls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && requestData().ownerId == request.auth.uid
        && requestData().communityId is string
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(requestData().communityId)).data.memberIds
        && requestData().question is string
        && requestData().question.size() > 0
        && requestData().question.size() <= 240
        && requestData().options is list
        && requestData().options.size() >= 2
        && requestData().options.size() <= 6
        && requestData().votes is map
        && requestData().voters is map
        && requestData().voters.size() == 0
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.communityId is string
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.memberIds
        && !(request.auth.uid in resource.data.voters)
        && request.auth.uid in requestData().voters
        && changedFields().hasOnly(['votes','voters'])
        && requestData().votes is map
        && requestData().voters is map
        && requestData().voters.size() == resource.data.voters.size() + 1;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /communities/{communityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && requestData().ownerId == request.auth.uid
        && requestData().name is string && requestData().name.size() > 0 && requestData().name.size() <= 80
        && requestData().description is string && requestData().description.size() <= 500
        && requestData().topic is string && requestData().topic.size() <= 80
        && requestData().visibility == 'public'
        && requestData().memberIds is list
        && requestData().memberIds.size() == 1
        && requestData().memberIds[0] == request.auth.uid
        && requestData().memberCount == 1
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null
        && requestData().keys().hasOnly(['ownerId','name','description','topic','visibility','memberIds','memberCount','createdAt'])
        && resource.data.ownerId == requestData().ownerId
        && resource.data.name == requestData().name
        && resource.data.description == requestData().description
        && resource.data.topic == requestData().topic
        && resource.data.visibility == requestData().visibility
        && resource.data.createdAt == requestData().createdAt
        && requestData().memberIds is list
        && requestData().memberIds.size() >= 1
        && requestData().memberIds.size() <= 10000
        && requestData().memberCount == requestData().memberIds.size()
        && (
          (!(request.auth.uid in resource.data.memberIds)
            && request.auth.uid in requestData().memberIds
            && requestData().memberIds.hasAll(resource.data.memberIds)
            && requestData().memberIds.size() == resource.data.memberIds.size() + 1)
          || (request.auth.uid in resource.data.memberIds
            && request.auth.uid != resource.data.ownerId
            && !(request.auth.uid in requestData().memberIds)
            && resource.data.memberIds.hasAll(requestData().memberIds)
            && requestData().memberIds.size() + 1 == resource.data.memberIds.size())
          || (request.auth.uid == resource.data.ownerId
            && request.auth.uid in requestData().memberIds
            && request.auth.uid in resource.data.memberIds
            && resource.data.memberIds.hasAll(requestData().memberIds)
            && requestData().memberIds.size() + 1 == resource.data.memberIds.size())
        );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }



  match /random_calls/{callId} {
    allow read: if request.auth != null
      && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
    allow create: if request.auth != null
      && requestData().callerUid == request.auth.uid
      && requestData().calleeUid is string
      && requestData().calleeUid != request.auth.uid
      && requestData().kind in ['audio','video']
      && requestData().status == 'ringing'
      && requestData().keys().hasOnly(['callerUid','calleeUid','kind','status','createdAt']);
    allow update: if request.auth != null
      && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid)
      && (
        (changedFields().hasOnly(['offer'])
          && resource.data.callerUid == request.auth.uid
          && requestData().offer is map
          && requestData().offer.sdp is string
          && requestData().offer.type is string)
        || (changedFields().hasOnly(['answer','status'])
          && resource.data.calleeUid == request.auth.uid
          && resource.data.status == 'ringing'
          && requestData().status == 'connected'
          && requestData().answer is map
          && requestData().answer.sdp is string
          && requestData().answer.type is string)
        || (changedFields().hasOnly(['status','endedBy','endedAt'])
          && requestData().status == 'ended'
          && requestData().endedBy == request.auth.uid
          && requestData().endedAt is timestamp)
      );
    allow delete: if false;
    match /candidates/{candidateId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/random_calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/random_calls/$(callId)).data.calleeUid == request.auth.uid);
      allow create: if request.auth != null
        && requestData().senderUid == request.auth.uid
        && (get(/databases/$(database)/documents/random_calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/random_calls/$(callId)).data.calleeUid == request.auth.uid)
        && requestData().candidate is string
        && (requestData().sdpMid == null || requestData().sdpMid is string)
        && (requestData().sdpMLineIndex == null || requestData().sdpMLineIndex is int)
        && requestData().keys().hasOnly(['senderUid','candidate','sdpMid','sdpMLineIndex','createdAt']);
      allow update, delete: if false;
    }
  }

    match /gaming_friend_challenges/{challengeId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      // Creation and lifecycle are server-authoritative.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /gaming_friend_challenge_keys/{keyId} {
      allow read, write: if false;
    }

    match /gaming_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
      allow create: if request.auth != null
        && requestData().hostUid == request.auth.uid
        && requestData().roomId is string
        && requestData().roomId.size() > 0
        && requestData().inviteCode == inviteCode
        && requestData().createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /auren_game_matchmaking/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /auren_game_lobbies/{lobbyId}/private_players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/auren_game_lobbies/$(lobbyId))
        && request.auth.uid in get(/databases/$(database)/documents/auren_game_lobbies/$(lobbyId)).data.players;
      allow create, update, delete: if false;
    }

    match /auren_game_lobbies/{lobbyId}/server/{docId} {
      allow read, write: if false;
    }

    match /auren_game_lobbies/{lobbyId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && requestData().hostId == request.auth.uid
        && requestData().guestId == null
        && requestData().players is list
        && requestData().players.size() == 1
        && requestData().players[0] == request.auth.uid
        && requestData().gameIndex is int
        && requestData().gameIndex >= 0
        && requestData().gameIndex <= 59
        && requestData().status == 'waiting'
        && requestData().turnPlayerId == request.auth.uid
        && requestData().stateVersion == 0
        && requestData().state is map
        && requestData().state.size() == 0;
      // Only the second player may transition a waiting lobby to playing.
      // Match state itself remains immutable from clients; game moves go through
      // the trusted Cloud Function.
      allow update: if request.auth != null
        && resource.data.status == 'waiting'
        && resource.data.players is list
        && resource.data.players.size() == 1
        && requestData().players is list
        && requestData().players.size() == 2
        && requestData().players[0] == resource.data.players[0]
        && requestData().players[1] == request.auth.uid
        && requestData().guestId == request.auth.uid
        && requestData().hostId == resource.data.hostId
        && requestData().gameIndex == resource.data.gameIndex
        && requestData().status == 'playing'
        && requestData().turnPlayerId == resource.data.turnPlayerId
        && requestData().stateVersion == resource.data.stateVersion
        && requestData().state == resource.data.state;
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid
        && resource.data.status != 'playing';
    }

    match /gaming_rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow create: if request.auth != null
        && requestData().hostUid == request.auth.uid
        && requestData().playerUids is list
        && requestData().playerUids.size() == 1
        && requestData().playerUids[0] == request.auth.uid
        && requestData().gameId in ['tic_tac_toe','rock_paper_scissors','connect_four']
        && requestData().inviteCode is string
        && requestData().inviteCode.size() == 6
        && requestData().board is list
        && requestData().board.size() in [9,3,42]
        && requestData().turnUid == request.auth.uid
        && requestData().status == 'waiting';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.playerUids
        && requestData().hostUid == resource.data.hostUid
        && requestData().gameId == resource.data.gameId
        && requestData().inviteCode == resource.data.inviteCode
        && requestData().playerUids is list
        && requestData().playerUids.size() >= resource.data.playerUids.size()
        && requestData().playerUids.size() <= 2
        && requestData().playerUids.hasAll(resource.data.playerUids)
        && requestData().board == resource.data.board
        && requestData().winner == resource.data.winner
        && requestData().draw == resource.data.draw
        && requestData().turnUid == resource.data.turnUid
        && requestData().status in ['waiting','ready']
        && changedFields().hasOnly(['playerUids','marks','status','updatedAt'])
        && requestData().updatedAt is timestamp
        && (
          requestData().playerUids.size() == resource.data.playerUids.size()
          || (
            resource.data.status == 'waiting'
            && resource.data.playerUids.size() == 1
            && requestData().playerUids.size() == 2
            && request.auth.uid in requestData().playerUids
          )
        );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids
          && requestData().senderUid == request.auth.uid
          && requestData().text is string
          && requestData().text.size() > 0
          && requestData().text.size() <= 500
          && requestData().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/gaming_challenges/{challengeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && requestData().challengeId == 'daily_tic_tac_toe'
        && requestData().xp == 25
        && requestData().completedAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{userId}/gaming_profile/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /users/{userId}/gaming_results/{resultId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /watch_together_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
      allow create: if request.auth != null
        && requestData().hostUid == request.auth.uid
        && requestData().roomId is string
        && requestData().roomId.size() > 0
        && requestData().inviteCode == inviteCode
        && requestData().createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /watch_together_rooms/{roomId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && requestData().hostUid == request.auth.uid
        && requestData().memberIds is list
        && requestData().memberIds.size() == 1
        && requestData().memberIds[0] == request.auth.uid
        && requestData().inviteCode is string
        && requestData().inviteCode.size() == 6
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().channelId is string
        && requestData().channelId.size() > 0
        && requestData().channelName is string
        && requestData().channelName.size() > 0
        && requestData().positionSeconds is number
        && requestData().positionSeconds >= 0
        && requestData().positionSeconds <= 86400
        && requestData().isPlaying is bool
        && requestData().status == 'waiting'
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;

      // Playback/channel state is host-authoritative.
      // Membership changes are separately constrained below.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && requestData().inviteCode == resource.data.inviteCode
        && requestData().memberIds is list
        && requestData().memberIds.size() <= 8
        && requestData().updatedAt is timestamp
        && (
          // Host can update playback/channel state, but cannot alter membership.
          (
            request.auth.uid == resource.data.hostUid
            && requestData().hostUid == resource.data.hostUid
            && requestData().memberIds == resource.data.memberIds
            && changedFields().hasOnly([
              'channelId','channelName','positionSeconds','isPlaying','updatedAt'
            ])
            && requestData().channelId is string
            && requestData().channelId.size() > 0
            && requestData().channelName is string
            && requestData().channelName.size() > 0
            && requestData().positionSeconds is number
            && requestData().positionSeconds >= 0
            && requestData().positionSeconds <= 86400
            && requestData().isPlaying is bool
            && requestData().status == resource.data.status
          )
          ||
          // A member can join; only the host can change hostUid.
          (
            requestData().hostUid == resource.data.hostUid
            && requestData().status in ['waiting','ready']
            && !(request.auth.uid in resource.data.memberIds)
            && requestData().memberIds.size() == resource.data.memberIds.size() + 1
            && requestData().memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in requestData().memberIds
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // A member can leave themselves.
          (
            requestData().hostUid == resource.data.hostUid
            && requestData().status in ['waiting','ready']
            && requestData().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(requestData().memberIds)
            && !(request.auth.uid in requestData().memberIds)
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // The current host can leave and transfer host ownership to a remaining member.
          (
            request.auth.uid == resource.data.hostUid
            && requestData().hostUid is string
            && requestData().hostUid != resource.data.hostUid
            && requestData().hostUid in requestData().memberIds
            && requestData().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(requestData().memberIds)
            && !(request.auth.uid in requestData().memberIds)
            && requestData().status in ['waiting','ready']
            && changedFields().hasOnly([
              'hostUid','memberIds','status','updatedAt'
            ])
          )
        );

      // Only the host can delete a room.
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      match /presence/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().uid == request.auth.uid
          && requestData().online is bool
          && requestData().lastSeen is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /activity/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().actorUid == request.auth.uid
          && requestData().type is string
          && requestData().type.size() > 0
          && requestData().type.size() <= 40
          && requestData().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /typing/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().uid == request.auth.uid
          && requestData().typing is bool
          && requestData().updatedAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /reactions/{reactionId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().senderUid == request.auth.uid
          && requestData().emoji is string
          && requestData().emoji.size() > 0
          && requestData().emoji.size() <= 8
          && requestData().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && requestData().senderUid == request.auth.uid
          && requestData().text is string
          && requestData().text.size() > 0
          && requestData().text.size() <= 500
          && requestData().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    // Canonical Education schema: courses + per-user enrollments/savedCourses.
    // Keep the legacy education_* rules below during migration; do not expose unpublished courses.
    match /courses/{courseId} {
      allow read: if request.auth != null && resource.data.status == 'published';
      allow create, delete: if false;
      allow update: if false;
    }

    match /users/{userId}/enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && requestData().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && requestData().completedLessons == 0
        && requestData().progress == 0
        && requestData().status == 'active'
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && requestData().courseId == resource.data.courseId
        && requestData().completedLessons is int
        && requestData().completedLessons >= 0
        && requestData().progress is int
        && requestData().progress >= 0
        && requestData().progress <= 100
        && requestData().status in ['active','completed']
        && requestData().createdAt == resource.data.createdAt
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/savedCourses/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','createdAt'])
        && requestData().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && requestData().createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /education_courses/{courseId} {
      allow read: if request.auth != null && resource.data.published == true;
      allow write: if false;
    }

    match /users/{userId}/education_enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && requestData().courseId == courseId
        && requestData().title is string
        && requestData().title.size() <= 160
        && requestData().progress == 0
        && requestData().completedLessons is list
        && requestData().completedLessons.size() == 0
        && requestData().status == 'active'
        && requestData().createdAt is timestamp
        && requestData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && requestData().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && requestData().courseId == resource.data.courseId
        && requestData().progress is int
        && requestData().progress >= 0
        && requestData().progress <= 100
        && requestData().completedLessons is list
        && requestData().completedLessons.size() <= 100
        && requestData().status in ['active','completed']
        && requestData().createdAt == resource.data.createdAt
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/arena_history/{historyId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /arena_rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow write: if false;
    }

    match /arena_invites/{inviteCode} {
      allow read, write: if false;
    }


    match /stays/{stayId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null
        && requestData().ownerId == request.auth.uid
        && requestData().name is string && requestData().name.size() > 0 && requestData().name.size() <= 160
        && requestData().city is string && requestData().city.size() > 0 && requestData().city.size() <= 100
        && requestData().country is string && requestData().country.size() > 0 && requestData().country.size() <= 100
        && requestData().type in ['hotel','apartment','villa','hostel','resort','guesthouse']
        && requestData().description is string && requestData().description.size() <= 3000
        && requestData().currency is string && requestData().currency.size() == 3
        && requestData().priceMinor is int && requestData().priceMinor >= 0
        && requestData().guests is int && requestData().guests >= 1 && requestData().guests <= 50
        && requestData().status == 'active'
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && requestData().ownerId == resource.data.ownerId
        && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /stay_bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.guestUid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
        && requestData().guestUid == request.auth.uid
        && requestData().ownerId is string
        && requestData().stayId is string
        && requestData().name is string
        && requestData().city is string
        && requestData().checkIn is timestamp
        && requestData().checkOut is timestamp
        && requestData().checkOut > requestData().checkIn
        && requestData().guests is int && requestData().guests >= 1 && requestData().guests <= 50
        && requestData().currency is string && requestData().currency.size() == 3
        && requestData().priceMinorPerNight is int && requestData().priceMinorPerNight >= 0
        && requestData().status == 'requested'
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && changedFields().hasOnly(['status'])
        && requestData().status in ['accepted','rejected','cancelled'];
      allow delete: if request.auth != null && resource.data.guestUid == request.auth.uid;
    }

    match /ride_requests/{rideId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.riderUid;
      allow create: if request.auth != null && requestData().riderUid == request.auth.uid
        && requestData().pickup is string && requestData().pickup.size() > 0 && requestData().pickup.size() <= 500
        && requestData().destination is string && requestData().destination.size() > 0 && requestData().destination.size() <= 500
        && requestData().rideType in ['standard','premium','van','bike']
        && requestData().passengers is int && requestData().passengers >= 1 && requestData().passengers <= 8
        && requestData().status == 'requested' && requestData().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.riderUid == request.auth.uid
        && requestData().riderUid == resource.data.riderUid
        && changedFields().hasOnly(['status'])
        && requestData().status == 'cancelled';
      allow delete: if request.auth != null && resource.data.riderUid == request.auth.uid;
    }
    match /food_items/{itemId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null && requestData().ownerId == request.auth.uid
        && requestData().name is string && requestData().name.size() > 0 && requestData().name.size() <= 160
        && requestData().category is string && requestData().category.size() > 0 && requestData().category.size() <= 100
        && requestData().city is string && requestData().city.size() > 0 && requestData().city.size() <= 100
        && requestData().country is string && requestData().country.size() > 0 && requestData().country.size() <= 100
        && requestData().currency is string && requestData().currency.size() == 3
        && requestData().priceMinor is int && requestData().priceMinor >= 0
        && requestData().halal is bool && requestData().status == 'active'
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && requestData().ownerId == resource.data.ownerId && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /safety_places/{placeId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }
    match /users/{userId}/offline_routes/{routeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && requestData().ownerId == userId
        && requestData().name is string && requestData().name.size() > 0 && requestData().name.size() <= 160
        && requestData().points is list && requestData().points.size() >= 2 && requestData().points.size() <= 500
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null && request.auth.uid == userId && requestData().ownerId == resource.data.ownerId && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /emergency_contacts/{contactId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }

    match /entertainment_items/{itemId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && requestData().creatorId == request.auth.uid
        && requestData().channelId is string
        && requestData().channelId.size() > 0
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().description is string
        && requestData().description.size() <= 3000
        && requestData().mediaUrl is string
        && requestData().mediaUrl.size() > 0
        && requestData().mediaUrl.size() <= 2000
        && requestData().mediaKind == 'video'
        && requestData().visibility == 'public'
        && requestData().createdAt is timestamp
        && get(/databases/$(database)/documents/content_channels/$(requestData().channelId)).data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && requestData().creatorId == resource.data.creatorId
        && requestData().channelId == resource.data.channelId
        && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }

    match /content_channels/{channelId} {
      allow read: if request.auth != null && resource.data.public == true;
      allow create: if request.auth != null && requestData().ownerId == request.auth.uid
        && requestData().name is string && requestData().name.size() > 0 && requestData().name.size() <= 100
        && requestData().description is string && requestData().description.size() <= 1000
        && requestData().subscribers == 0 && requestData().public == true && requestData().createdAt is timestamp;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /subscribers/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid && requestData().uid == uid && requestData().createdAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /users/{userId}/watchTogetherTokens/{tokenId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && requestData().keys().hasOnly(['token','platform','updatedAt'])
        && requestData().token == tokenId
        && requestData().token is string
        && requestData().token.size() > 0
        && requestData().token.size() <= 4096
        && requestData().platform in ['android','ios','web']
        && requestData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/actions/{actionId} {
      allow read: if isOwner(userId);

      // Action documents are created by trusted server code. While an action is
      // pending, the owner may edit only the user-facing draft fields.
      // Approval/execution fields remain server-owned at all times.
      allow create, delete: if false;

      allow update: if isOwner(userId)
        && resource.data.status == 'pending'
        && requestData().status == 'pending'
        && requestData().actionType == resource.data.actionType
        && requestData().createdAt == resource.data.createdAt
        && requestData().draftVersion is int
        && requestData().draftVersion == resource.data.draftVersion + 1
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 200
        && requestData().description is string
        && requestData().description.size() <= 2000
        && requestData().payload is map
        && requestData().payload.keys().size() <= 50
        && requestData().updatedAt is timestamp
        && changedFields().hasOnly([
          'title','description','payload','draftVersion','updatedAt'
        ]);
    }
    match /users/{userId}/notes/{noteId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/memory/{memoryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/action_audit/{eventId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /agriculture_records/{recordId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && requestData().ownerId == request.auth.uid
        && requestData().title is string
        && requestData().title.size() > 0
        && requestData().title.size() <= 160
        && requestData().type in ['crop','livestock','farm','soil','water','equipment','manufacturing','invention','research','energy','recycling','design']
        && requestData().location is string
        && requestData().location.size() <= 200
        && requestData().visibility == 'public'
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && requestData().ownerId == resource.data.ownerId
        && requestData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /agriculture_opportunities/{opportunityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow write: if false;
    }

    match /users/{userId}/agricultureNotes/{noteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && requestData().keys().hasOnly(['title','note','type','createdAt','updatedAt'])
        && requestData().title is string
