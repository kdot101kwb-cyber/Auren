            && reqData().memberIds.size() + 1 == resource.data.memberIds.size())
        );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }



  match /random_calls/{callId} {
    allow read: if request.auth != null
      && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid);
    allow create: if request.auth != null
      && reqData().callerUid == request.auth.uid
      && reqData().calleeUid is string
      && reqData().calleeUid != request.auth.uid
      && reqData().kind in ['audio','video']
      && reqData().status == 'ringing'
      && reqData().keys().hasOnly(['callerUid','calleeUid','kind','status','createdAt']);
    allow update: if request.auth != null
      && (resource.data.callerUid == request.auth.uid || resource.data.calleeUid == request.auth.uid)
      && (
        (changedFields().hasOnly(['offer'])
          && resource.data.callerUid == request.auth.uid
          && reqData().offer is map
          && reqData().offer.sdp is string
          && reqData().offer.type is string)
        || (changedFields().hasOnly(['answer','status'])
          && resource.data.calleeUid == request.auth.uid
          && resource.data.status == 'ringing'
          && reqData().status == 'connected'
          && reqData().answer is map
          && reqData().answer.sdp is string
          && reqData().answer.type is string)
        || (changedFields().hasOnly(['status','endedBy','endedAt'])
          && reqData().status == 'ended'
          && reqData().endedBy == request.auth.uid
          && reqData().endedAt is timestamp)
      );
    allow delete: if false;
    match /candidates/{candidateId} {
      allow read: if request.auth != null
        && (get(/databases/$(database)/documents/random_calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/random_calls/$(callId)).data.calleeUid == request.auth.uid);
      allow create: if request.auth != null
        && reqData().senderUid == request.auth.uid
        && (get(/databases/$(database)/documents/random_calls/$(callId)).data.callerUid == request.auth.uid
          || get(/databases/$(database)/documents/random_calls/$(callId)).data.calleeUid == request.auth.uid)
        && reqData().candidate is string
        && (reqData().sdpMid == null || reqData().sdpMid is string)
        && (reqData().sdpMLineIndex == null || reqData().sdpMLineIndex is int)
        && reqData().keys().hasOnly(['senderUid','candidate','sdpMid','sdpMLineIndex','createdAt']);
      allow update, delete: if false;
    }
  }

    match /gaming_friend_challenges/{challengeId} {
      allow read: if request.auth != null
        && (resource.data.fromUid == request.auth.uid || resource.data.toUid == request.auth.uid);
      // Creation and lifecycle are server-authoritative.
      allow create: if false;
      allow update: if false;
      allow delete: if false;
    }

    match /gaming_friend_challenge_keys/{keyId} {
      allow read, write: if false;
    }

    match /gaming_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
      allow create: if request.auth != null
        && reqData().hostUid == request.auth.uid
        && reqData().roomId is string
        && reqData().roomId.size() > 0
        && reqData().inviteCode == inviteCode
        && reqData().createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /auren_game_matchmaking/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow create, update, delete: if false;
    }

    match /auren_game_lobbies/{lobbyId}/private_players/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid
        && exists(/databases/$(database)/documents/auren_game_lobbies/$(lobbyId))
        && request.auth.uid in get(/databases/$(database)/documents/auren_game_lobbies/$(lobbyId)).data.players;
      allow create, update, delete: if false;
    }

    match /auren_game_lobbies/{lobbyId}/server/{docId} {
      allow read, write: if false;
    }

    match /auren_game_lobbies/{lobbyId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.players;
      allow create: if request.auth != null
        && reqData().hostId == request.auth.uid
        && reqData().guestId == null
        && reqData().players is list
        && reqData().players.size() == 1
        && reqData().players[0] == request.auth.uid
        && reqData().gameIndex is int
        && reqData().gameIndex >= 0
        && reqData().gameIndex <= 59
        && reqData().status == 'waiting'
        && reqData().turnPlayerId == request.auth.uid
        && reqData().stateVersion == 0
        && reqData().state is map
        && reqData().state.size() == 0;
      // Only the second player may transition a waiting lobby to playing.
      // Match state itself remains immutable from clients; game moves go through
      // the trusted Cloud Function.
      allow update: if request.auth != null
        && resource.data.status == 'waiting'
        && resource.data.players is list
        && resource.data.players.size() == 1
        && reqData().players is list
        && reqData().players.size() == 2
        && reqData().players[0] == resource.data.players[0]
        && reqData().players[1] == request.auth.uid
        && reqData().guestId == request.auth.uid
        && reqData().hostId == resource.data.hostId
        && reqData().gameIndex == resource.data.gameIndex
        && reqData().status == 'playing'
        && reqData().turnPlayerId == resource.data.turnPlayerId
        && reqData().stateVersion == resource.data.stateVersion
        && reqData().state == resource.data.state;
      allow delete: if request.auth != null
        && resource.data.hostId == request.auth.uid
        && resource.data.status != 'playing';
    }

    match /gaming_rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow create: if request.auth != null
        && reqData().hostUid == request.auth.uid
        && reqData().playerUids is list
        && reqData().playerUids.size() == 1
        && reqData().playerUids[0] == request.auth.uid
        && reqData().gameId in ['tic_tac_toe','rock_paper_scissors','connect_four']
        && reqData().inviteCode is string
        && reqData().inviteCode.size() == 6
        && reqData().board is list
        && reqData().board.size() in [9,3,42]
        && reqData().turnUid == request.auth.uid
        && reqData().status == 'waiting';
      allow update: if request.auth != null
        && request.auth.uid in resource.data.playerUids
        && reqData().hostUid == resource.data.hostUid
        && reqData().gameId == resource.data.gameId
        && reqData().inviteCode == resource.data.inviteCode
        && reqData().playerUids is list
        && reqData().playerUids.size() >= resource.data.playerUids.size()
        && reqData().playerUids.size() <= 2
        && reqData().playerUids.hasAll(resource.data.playerUids)
        && reqData().board == resource.data.board
        && reqData().winner == resource.data.winner
        && reqData().draw == resource.data.draw
        && reqData().turnUid == resource.data.turnUid
        && reqData().status in ['waiting','ready']
        && changedFields().hasOnly(['playerUids','marks','status','updatedAt'])
        && reqData().updatedAt is timestamp
        && (
          reqData().playerUids.size() == resource.data.playerUids.size()
          || (
            resource.data.status == 'waiting'
            && resource.data.playerUids.size() == 1
            && reqData().playerUids.size() == 2
            && request.auth.uid in reqData().playerUids
          )
        );
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/gaming_rooms/$(roomId)).data.playerUids
          && reqData().senderUid == request.auth.uid
          && reqData().text is string
          && reqData().text.size() > 0
          && reqData().text.size() <= 500
          && reqData().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    match /users/{userId}/gaming_challenges/{challengeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null
        && request.auth.uid == userId
        && reqData().challengeId == 'daily_tic_tac_toe'
        && reqData().xp == 25
        && reqData().completedAt is timestamp;
      allow update, delete: if false;
    }

    match /users/{userId}/gaming_profile/{docId} {
      allow read: if request.auth != null;
      allow create, update, delete: if false;
    }

    match /users/{userId}/gaming_results/{resultId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /watch_together_invites/{inviteCode} {
      allow read: if request.auth != null && inviteCode == resource.data.inviteCode;
      allow create: if request.auth != null
        && reqData().hostUid == request.auth.uid
        && reqData().roomId is string
        && reqData().roomId.size() > 0
        && reqData().inviteCode == inviteCode
        && reqData().createdAt is timestamp;
      allow update: if false;
      allow delete: if request.auth != null && resource.data.hostUid == request.auth.uid;
    }

    match /watch_together_rooms/{roomId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;

      allow create: if request.auth != null
        && reqData().hostUid == request.auth.uid
        && reqData().memberIds is list
        && reqData().memberIds.size() == 1
        && reqData().memberIds[0] == request.auth.uid
        && reqData().inviteCode is string
        && reqData().inviteCode.size() == 6
        && reqData().title is string
        && reqData().title.size() > 0
        && reqData().title.size() <= 160
        && reqData().channelId is string
        && reqData().channelId.size() > 0
        && reqData().channelName is string
        && reqData().channelName.size() > 0
        && reqData().positionSeconds is number
        && reqData().positionSeconds >= 0
        && reqData().positionSeconds <= 86400
        && reqData().isPlaying is bool
        && reqData().status == 'waiting'
        && reqData().createdAt is timestamp
        && reqData().updatedAt is timestamp;

      // Playback/channel state is host-authoritative.
      // Membership changes are separately constrained below.
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && reqData().inviteCode == resource.data.inviteCode
        && reqData().memberIds is list
        && reqData().memberIds.size() <= 8
        && reqData().updatedAt is timestamp
        && (
          // Host can update playback/channel state, but cannot alter membership.
          (
            request.auth.uid == resource.data.hostUid
            && reqData().hostUid == resource.data.hostUid
            && reqData().memberIds == resource.data.memberIds
            && changedFields().hasOnly([
              'channelId','channelName','positionSeconds','isPlaying','updatedAt'
            ])
            && reqData().channelId is string
            && reqData().channelId.size() > 0
            && reqData().channelName is string
            && reqData().channelName.size() > 0
            && reqData().positionSeconds is number
            && reqData().positionSeconds >= 0
            && reqData().positionSeconds <= 86400
            && reqData().isPlaying is bool
            && reqData().status == resource.data.status
          )
          ||
          // A member can join; only the host can change hostUid.
          (
            reqData().hostUid == resource.data.hostUid
            && reqData().status in ['waiting','ready']
            && !(request.auth.uid in resource.data.memberIds)
            && reqData().memberIds.size() == resource.data.memberIds.size() + 1
            && reqData().memberIds.hasAll(resource.data.memberIds)
            && request.auth.uid in reqData().memberIds
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // A member can leave themselves.
          (
            reqData().hostUid == resource.data.hostUid
            && reqData().status in ['waiting','ready']
            && reqData().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(reqData().memberIds)
            && !(request.auth.uid in reqData().memberIds)
            && changedFields().hasOnly([
              'memberIds','status','updatedAt'
            ])
          )
          ||
          // The current host can leave and transfer host ownership to a remaining member.
          (
            request.auth.uid == resource.data.hostUid
            && reqData().hostUid is string
            && reqData().hostUid != resource.data.hostUid
            && reqData().hostUid in reqData().memberIds
            && reqData().memberIds.size() == resource.data.memberIds.size() - 1
            && resource.data.memberIds.hasAll(reqData().memberIds)
            && !(request.auth.uid in reqData().memberIds)
            && reqData().status in ['waiting','ready']
            && changedFields().hasOnly([
              'hostUid','memberIds','status','updatedAt'
            ])
          )
        );

      // Only the host can delete a room.
      allow delete: if request.auth != null
        && resource.data.hostUid == request.auth.uid;

      match /presence/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && reqData().uid == request.auth.uid
          && reqData().online is bool
          && reqData().lastSeen is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /activity/{activityId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && reqData().actorUid == request.auth.uid
          && reqData().type is string
          && reqData().type.size() > 0
          && reqData().type.size() <= 40
          && reqData().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /typing/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && reqData().uid == request.auth.uid
          && reqData().typing is bool
          && reqData().updatedAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /reactions/{reactionId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && reqData().senderUid == request.auth.uid
          && reqData().emoji is string
          && reqData().emoji.size() > 0
          && reqData().emoji.size() <= 8
          && reqData().createdAt is timestamp;
        allow update, delete: if false;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && reqData().senderUid == request.auth.uid
          && reqData().text is string
          && reqData().text.size() > 0
          && reqData().text.size() <= 500
          && reqData().createdAt is timestamp;
        allow update, delete: if false;
      }
    }

    // Canonical Education schema: courses + per-user enrollments/savedCourses.
    // Keep the legacy education_* rules below during migration; do not expose unpublished courses.
    match /courses/{courseId} {
      allow read: if request.auth != null && resource.data.status == 'published';
      allow create, delete: if false;
      allow update: if false;
    }

    match /users/{userId}/enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && reqData().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && reqData().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && reqData().completedLessons == 0
        && reqData().progress == 0
        && reqData().status == 'active'
        && reqData().createdAt is timestamp
        && reqData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && reqData().keys().hasOnly(['courseId','completedLessons','progress','status','createdAt','updatedAt'])
        && reqData().courseId == resource.data.courseId
        && reqData().completedLessons is int
        && reqData().completedLessons >= 0
        && reqData().progress is int
        && reqData().progress >= 0
        && reqData().progress <= 100
        && reqData().status in ['active','completed']
        && reqData().createdAt == resource.data.createdAt
        && reqData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/savedCourses/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && reqData().keys().hasOnly(['courseId','createdAt'])
        && reqData().courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && reqData().createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /education_courses/{courseId} {
      allow read: if request.auth != null && resource.data.published == true;
      allow write: if false;
    }

    match /users/{userId}/education_enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && reqData().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && reqData().courseId == courseId
        && reqData().title is string
        && reqData().title.size() <= 160
        && reqData().progress == 0
        && reqData().completedLessons is list
        && reqData().completedLessons.size() == 0
        && reqData().status == 'active'
        && reqData().createdAt is timestamp
        && reqData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && reqData().keys().hasOnly(['courseId','title','progress','completedLessons','status','createdAt','updatedAt'])
        && reqData().courseId == resource.data.courseId
        && reqData().progress is int
        && reqData().progress >= 0
        && reqData().progress <= 100
        && reqData().completedLessons is list
        && reqData().completedLessons.size() <= 100
        && reqData().status in ['active','completed']
        && reqData().createdAt == resource.data.createdAt
        && reqData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }
    match /users/{userId}/arena_history/{historyId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create, update, delete: if false;
    }

    match /arena_rooms/{roomId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.playerUids;
      allow write: if false;
    }

    match /arena_invites/{inviteCode} {
      allow read, write: if false;
    }


    match /stays/{stayId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null
        && reqData().ownerId == request.auth.uid
        && reqData().name is string && reqData().name.size() > 0 && reqData().name.size() <= 160
        && reqData().city is string && reqData().city.size() > 0 && reqData().city.size() <= 100
        && reqData().country is string && reqData().country.size() > 0 && reqData().country.size() <= 100
        && reqData().type in ['hotel','apartment','villa','hostel','resort','guesthouse']
        && reqData().description is string && reqData().description.size() <= 3000
        && reqData().currency is string && reqData().currency.size() == 3
        && request.resource.data.priceMinor is int && reqData().priceMinor >= 0
        && reqData().guests is int && reqData().guests >= 1 && reqData().guests <= 50
        && reqData().status == 'active'
        && reqData().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && reqData().ownerId == resource.data.ownerId
        && reqData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /stay_bookings/{bookingId} {
      allow read: if request.auth != null
        && (resource.data.guestUid == request.auth.uid || resource.data.ownerId == request.auth.uid);
      allow create: if request.auth != null
        && reqData().guestUid == request.auth.uid
        && reqData().ownerId is string
        && reqData().stayId is string
        && reqData().name is string
        && reqData().city is string
        && reqData().checkIn is timestamp
        && reqData().checkOut is timestamp
        && reqData().checkOut > reqData().checkIn
        && reqData().guests is int && reqData().guests >= 1 && reqData().guests <= 50
        && reqData().currency is string && reqData().currency.size() == 3
        && reqData().priceMinorPerNight is int && reqData().priceMinorPerNight >= 0
        && reqData().status == 'requested'
        && reqData().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && changedFields().hasOnly(['status'])
        && reqData().status in ['accepted','rejected','cancelled'];
      allow delete: if request.auth != null && resource.data.guestUid == request.auth.uid;
    }

    match /ride_requests/{rideId} {
      allow read: if request.auth != null && request.auth.uid == resource.data.riderUid;
      allow create: if request.auth != null && reqData().riderUid == request.auth.uid
        && reqData().pickup is string && reqData().pickup.size() > 0 && reqData().pickup.size() <= 500
        && reqData().destination is string && reqData().destination.size() > 0 && reqData().destination.size() <= 500
        && reqData().rideType in ['standard','premium','van','bike']
        && reqData().passengers is int && reqData().passengers >= 1 && reqData().passengers <= 8
        && reqData().status == 'requested' && reqData().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.riderUid == request.auth.uid
        && reqData().riderUid == resource.data.riderUid
        && changedFields().hasOnly(['status'])
        && reqData().status == 'cancelled';
      allow delete: if request.auth != null && resource.data.riderUid == request.auth.uid;
    }
    match /food_items/{itemId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null && reqData().ownerId == request.auth.uid
        && reqData().name is string && reqData().name.size() > 0 && reqData().name.size() <= 160
        && reqData().category is string && reqData().category.size() > 0 && reqData().category.size() <= 100
        && reqData().city is string && reqData().city.size() > 0 && reqData().city.size() <= 100
        && reqData().country is string && reqData().country.size() > 0 && reqData().country.size() <= 100
        && reqData().currency is string && reqData().currency.size() == 3
        && request.resource.data.priceMinor is int && reqData().priceMinor >= 0
        && reqData().halal is bool && reqData().status == 'active'
        && reqData().createdAt is timestamp;
      allow update: if request.auth != null && resource.data.ownerId == request.auth.uid
        && reqData().ownerId == resource.data.ownerId && reqData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /safety_places/{placeId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }
    match /users/{userId}/offline_routes/{routeId} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow create: if request.auth != null && request.auth.uid == userId && reqData().ownerId == userId
        && reqData().name is string && reqData().name.size() > 0 && reqData().name.size() <= 160
        && reqData().points is list && reqData().points.size() >= 2 && reqData().points.size() <= 500
        && reqData().createdAt is timestamp;
      allow update: if request.auth != null && request.auth.uid == userId && reqData().ownerId == resource.data.ownerId && reqData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
    match /emergency_contacts/{contactId} { allow read: if request.auth != null && resource.data.active == true; allow write: if false; }

    match /entertainment_items/{itemId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && reqData().creatorId == request.auth.uid
        && reqData().channelId is string
        && reqData().channelId.size() > 0
        && reqData().title is string
        && reqData().title.size() > 0
        && reqData().title.size() <= 160
        && reqData().description is string
        && reqData().description.size() <= 3000
        && reqData().mediaUrl is string
        && reqData().mediaUrl.size() > 0
        && reqData().mediaUrl.size() <= 2000
        && reqData().mediaKind == 'video'
        && reqData().visibility == 'public'
        && reqData().createdAt is timestamp
        && get(/databases/$(database)/documents/content_channels/$(reqData().channelId)).data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && reqData().creatorId == resource.data.creatorId
        && reqData().channelId == resource.data.channelId
        && reqData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }

    match /content_channels/{channelId} {
      allow read: if request.auth != null && resource.data.public == true;
      allow create: if request.auth != null && reqData().ownerId == request.auth.uid
        && reqData().name is string && reqData().name.size() > 0 && reqData().name.size() <= 100
        && reqData().description is string && reqData().description.size() <= 1000
        && reqData().subscribers == 0 && reqData().public == true && reqData().createdAt is timestamp;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
      match /subscribers/{uid} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.auth.uid == uid && reqData().uid == uid && reqData().createdAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
        allow update: if false;
      }
    }

    match /users/{userId}/watchTogetherTokens/{tokenId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && reqData().keys().hasOnly(['token','platform','updatedAt'])
        && reqData().token == tokenId
        && reqData().token is string
        && reqData().token.size() > 0
        && reqData().token.size() <= 4096
        && reqData().platform in ['android','ios','web']
        && reqData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/actions/{actionId} {
      allow read: if isOwner(userId);

      // Action documents are created by trusted server code. While an action is
      // pending, the owner may edit only the user-facing draft fields.
      // Approval/execution fields remain server-owned at all times.
      allow create, delete: if false;

      allow update: if isOwner(userId)
        && resource.data.status == 'pending'
        && reqData().status == 'pending'
        && reqData().actionType == resource.data.actionType
        && reqData().createdAt == resource.data.createdAt
        && reqData().draftVersion is int
        && reqData().draftVersion == resource.data.draftVersion + 1
        && reqData().title is string
        && reqData().title.size() > 0
        && reqData().title.size() <= 200
        && reqData().description is string
        && reqData().description.size() <= 2000
        && reqData().payload is map
        && reqData().payload.keys().size() <= 50
        && reqData().updatedAt is timestamp
        && changedFields().hasOnly([
          'title','description','payload','draftVersion','updatedAt'
        ]);
    }
    match /users/{userId}/notes/{noteId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/memory/{memoryId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/goals/{goalId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }
    match /users/{userId}/action_audit/{eventId} {
      allow read: if isOwner(userId);
      allow write: if false;
    }

    match /agriculture_records/{recordId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && reqData().ownerId == request.auth.uid
        && reqData().title is string
        && reqData().title.size() > 0
        && reqData().title.size() <= 160
        && reqData().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','farm','soil','water','equipment','fertilizer','nutrients','pest','plant_disease','irrigation','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && reqData().location is string
        && reqData().location.size() <= 200
        && reqData().visibility == 'public'
        && reqData().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && reqData().ownerId == resource.data.ownerId
        && reqData().createdAt == resource.data.createdAt;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /agriculture_opportunities/{opportunityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow write: if false;
    }

    match /users/{userId}/agricultureNotes/{noteId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && reqData().keys().hasOnly(['title','note','type','createdAt','updatedAt'])
        && reqData().title is string
        && reqData().title.size() > 0
        && reqData().title.size() <= 160
        && reqData().note is string
        && reqData().note.size() > 0
        && reqData().note.size() <= 5000
        && reqData().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','soil','fertilizer','nutrients','potassium','nitrogen','phosphorus','pest','plant_disease','irrigation','general','field','farm','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && reqData().createdAt is timestamp
        && reqData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && changedFields().hasOnly(['title','note','type','updatedAt'])
        && reqData().title is string
        && reqData().title.size() > 0
        && reqData().title.size() <= 160
        && reqData().note is string
        && reqData().note.size() > 0
        && reqData().note.size() <= 5000
        && reqData().type in ['crop','horticulture','orchard','floriculture','greenhouse','nursery','medicinal_plants','agroforestry','climate_smart','seeds','livestock','poultry','dairy','aquaculture','beekeeping','fisheries','veterinary','animal_nutrition','breeding','soil','fertilizer','nutrients','potassium','nitrogen','phosphorus','pest','plant_disease','irrigation','general','field','farm','manufacturing','invention','research','energy','recycling','design','business','production','costing','supply_chain','quality','feasibility']
        && reqData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/agricultureAdvisories/{advisoryId} {
      allow read: if isOwner(userId);
      allow write: if false;
