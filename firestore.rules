    match /community_polls/{pollId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && requestData().ownerId == request.auth.uid
        && requestData().communityId is string
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(requestData().communityId)).data.memberIds
        && requestData().question is string
        && requestData().question.size() > 0
        && requestData().question.size() <= 240
        && requestData().options is list
        && requestData().options.size() >= 2
        && requestData().options.size() <= 6
        && requestData().votes is map
        && requestData().voters is map
        && requestData().voters.size() == 0
        && requestData().createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.communityId is string
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.memberIds
        && !(request.auth.uid in resource.data.voters)
        && request.auth.uid in requestData().voters
        && changedFields().hasOnly(['votes','voters'])
        && requestData().votes is map
        && requestData().voters is map
        && requestData().voters.size() == resource.data.voters.size() + 1;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /communities/{communityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && requestData().ownerId == request.auth.uid
