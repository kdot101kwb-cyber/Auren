        && (request.resource.data.aiDraft == null || (request.resource.data.aiDraft is string && request.resource.data.aiDraft.size() <= 12000))
        && (request.resource.data.publishedPostId == null || (request.resource.data.publishedPostId is string && request.resource.data.publishedPostId.size() > 0 && request.resource.data.publishedPostId.size() <= 128))
        && (request.resource.data.status != 'published' || request.resource.data.publishedPostId is string)
        && request.resource.data.createdAt == resource.data.createdAt;
      allow delete: if isOwner(userId);
    }

    match /users/{userId}/creator_drafts/{draftId} {
