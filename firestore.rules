        && request.auth.uid in get(/databases/$(database)/documents/communities/$(request.resource.data.communityId)).data.memberIds
        && request.resource.data.question is string
        && request.resource.data.question.size() > 0
        && request.resource.data.question.size() <= 240
        && request.resource.data.options is list
