    match /users/{userId}/emergency_contacts/{contactId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && reqData().keys().hasOnly(['ownerId','name','phone','relation','primary','createdAt','updatedAt'])
        && reqData().ownerId == userId
        && reqData().name is string
        && reqData().name.size() > 0
        && reqData().name.size() <= 120
        && reqData().phone is string
        && reqData().phone.size() > 0
        && reqData().phone.size() <= 40
        && reqData().relation is string
        && reqData().relation.size() <= 80
        && reqData().primary is bool
        && reqData().createdAt is timestamp
        && reqData().updatedAt is timestamp;
      allow update: if isOwner(userId)
        && reqData().keys().hasOnly(['ownerId','name','phone','relation','primary','createdAt','updatedAt'])
        && reqData().ownerId == resource.data.ownerId
        && reqData().ownerId == userId
        && reqData().name is string
        && reqData().name.size() > 0
        && reqData().name.size() <= 120
        && reqData().phone is string
        && reqData().phone.size() > 0
        && reqData().phone.size() <= 40
        && reqData().relation is string
        && reqData().relation.size() <= 80
        && reqData().primary is bool
        && reqData().createdAt == resource.data.createdAt
        && reqData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

