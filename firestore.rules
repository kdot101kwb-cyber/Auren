    match /users/{userId}/kids/{settingId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && settingId == 'parent_settings'
        && reqData().keys().hasOnly(['ageBand','aiTutor','externalLinks','dailyMinutes','updatedAt'])
        && reqData().ageBand in [6, 9, 13]
        && reqData().aiTutor is bool
        && reqData().externalLinks is bool
        && reqData().dailyMinutes in [15, 30, 60, 90, 120, 180, 240]
        && reqData().updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }
    
    
