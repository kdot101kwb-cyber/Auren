rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    match /users/{userId} {
    match /goals/{goalId} {
      allow read, write: if isOwner(userId);
    }

      match /actions/{actionId} {
        allow read: if request.auth != null && request.auth.uid == userId;

        allow create: if request.auth != null
          && request.auth.uid == userId
          && request.resource.data.status == 'pending'
          && request.resource.data.requiresApproval == true
          && request.resource.data.conversationId is string
          && request.resource.data.actionType is string
          && request.resource.data.title is string
          && request.resource.data.description is string
          && request.resource.data.payload is map
          && request.resource.data.permission is string
          && request.resource.data.riskLevel is string
          && request.resource.data.approvalLevel is int
          && request.resource.data.actionType in ['demo.echo', 'demo.create_note']
          && request.resource.data.permission == 'userApproval'
          && request.resource.data.riskLevel == 'low'
          && request.resource.data.approvalLevel == 1
          && request.resource.data.requiresApproval == true
          && request.resource.data.keys().hasOnly([
            'conversationId', 'actionType', 'title', 'description', 'payload',
            'permission', 'riskLevel', 'approvalLevel', 'spendingLimitMinor',
            'currency', 'requiresApproval', 'status', 'result', 'createdAt'
          ]);

        allow update: if request.auth != null
          && request.auth.uid == userId
          && resource.data.status == 'pending'
          && request.resource.data.status in ['approved', 'rejected']
          && request.resource.data.requiresApproval == resource.data.requiresApproval
          && request.resource.data.conversationId == resource.data.conversationId
          && request.resource.data.actionType == resource.data.actionType
          && request.resource.data.title == resource.data.title
          && request.resource.data.description == resource.data.description
          && request.resource.data.payload == resource.data.payload
          && request.resource.data.permission == resource.data.permission
          && request.resource.data.riskLevel == resource.data.riskLevel
          && request.resource.data.approvalLevel == resource.data.approvalLevel
          && request.resource.data.requiresApproval == resource.data.requiresApproval
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

        allow delete: if request.auth != null && request.auth.uid == userId;
      }


      match /agent_permissions/{permissionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null
          && request.auth.uid == userId
          && permissionId == 'primary'
          && request.resource.data.agentId == 'primary'
          && request.resource.data.enabled is bool
          && request.resource.data.allowedActions is list
          && request.resource.data.allowedActions.size() <= 100
          && (request.resource.data.dailySpendingLimitMinor == null
            || (request.resource.data.dailySpendingLimitMinor is int
              && request.resource.data.dailySpendingLimitMinor >= 0))
          && request.resource.data.spentTodayMinor == 0
          && request.resource.data.currency is string
          && request.resource.data.currency.matches('^[A-Z]{3}
        allow update: if request.auth != null
          && request.auth.uid == userId
          && permissionId == 'primary'
          && request.resource.data.agentId == resource.data.agentId
          && request.resource.data.enabled is bool
          && request.resource.data.allowedActions is list
          && request.resource.data.allowedActions.size() <= 100
          && (request.resource.data.dailySpendingLimitMinor == null
            || (request.resource.data.dailySpendingLimitMinor is int
              && request.resource.data.dailySpendingLimitMinor >= 0))
          && request.resource.data.spentTodayMinor == resource.data.spentTodayMinor
          && request.resource.data.currency == resource.data.currency
          && request.resource.data.keys().hasOnly([
            'agentId', 'enabled', 'allowedActions', 'dailySpendingLimitMinor',
            'spentTodayMinor', 'currency', 'updatedAt'
          ]);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /agents/{agentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && agentId == 'primary'
          && request.resource.data.name is string
          && request.resource.data.version is string
          && request.resource.data.status in ['active', 'paused', 'revoked'];
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /agent_trust/{agentId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /wallet/{walletId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /wallet_transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /action_executions/{executionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /action_audit/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /disputes/{disputeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /agent_liability/{liabilityId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /disputes/{disputeId}/evidence/{evidenceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /memory/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notes/{noteId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /plugin_quotas/{quotaId} {
      allow read, write: if false;
    }

    match /plugin_invocations/{invocationId} {
      allow read, write: if false;
    }

    match /agent_reputation/{agentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /agent_reviews/{reviewId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /agent_risk/{agentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /plugin_artifacts/{artifactId} {
      allow read, write: if false;
    }

    match /agent_listings/{agentId} {
      allow read: if request.auth != null && resource.data.state == 'published';
      allow write: if false;
    }

    match /agent_messages/{messageId} {
      allow read: if request.auth != null
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid);
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.followerId == request.auth.uid;
    }

    match /businesses/{businessId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /places/{placeId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /opportunities/{opportunityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.memberIds;

      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.memberIds;
      }
    }
  }
}
)
          && request.resource.data.keys().hasOnly([
            'agentId', 'enabled', 'allowedActions', 'dailySpendingLimitMinor',
            'spentTodayMinor', 'currency', 'updatedAt'
          ]);
        allow update: if request.auth != null
          && request.auth.uid == userId
          && permissionId == 'primary'
          && request.resource.data.agentId == resource.data.agentId
          && request.resource.data.enabled is bool
          && request.resource.data.allowedActions is list
          && (request.resource.data.dailySpendingLimitMinor == null
            || request.resource.data.dailySpendingLimitMinor is int)
          && request.resource.data.spentTodayMinor == resource.data.spentTodayMinor
          && request.resource.data.currency == resource.data.currency;
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /agents/{agentId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && agentId == 'primary'
          && request.resource.data.name is string
          && request.resource.data.version is string
          && request.resource.data.status in ['active', 'paused', 'revoked'];
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      match /agent_trust/{agentId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /wallet/{walletId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /wallet_transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /action_executions/{executionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /action_audit/{eventId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /disputes/{disputeId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /agent_liability/{liabilityId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /disputes/{disputeId}/evidence/{evidenceId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }

      match /memory/{memoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      match /notes/{noteId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow write: if false;
      }
    }

    match /plugin_quotas/{quotaId} {
      allow read, write: if false;
    }

    match /plugin_invocations/{invocationId} {
      allow read, write: if false;
    }

    match /agent_reputation/{agentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /agent_reviews/{reviewId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /agent_risk/{agentId} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /plugin_artifacts/{artifactId} {
      allow read, write: if false;
    }

    match /agent_listings/{agentId} {
      allow read: if request.auth != null && resource.data.state == 'published';
      allow write: if false;
    }

    match /agent_messages/{messageId} {
      allow read: if request.auth != null
        && (resource.data.senderUid == request.auth.uid
          || resource.data.recipientUid == request.auth.uid);
      allow write: if false;
    }

    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;

      match /likes/{userId} {
        allow read: if request.auth != null;
        allow create, delete: if request.auth != null && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
        allow update, delete: if request.auth != null && resource.data.authorId == request.auth.uid;
      }
    }

    match /profiles/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }

    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.followerId == request.auth.uid;
      allow delete: if request.auth != null && resource.data.followerId == request.auth.uid;
    }

    match /businesses/{businessId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /places/{placeId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /opportunities/{opportunityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null && request.auth.uid in request.resource.data.memberIds;
      allow update, delete: if request.auth != null && request.auth.uid in resource.data.memberIds;

      match /messages/{messageId} {
        allow read, write: if request.auth != null && request.auth.uid in get(
          /databases/$(database)/documents/conversations/$(conversationId)
        ).data.memberIds;
      }
    }
  }
}
