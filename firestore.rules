rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

  
  match /random_group_connect/{requestId} { allow read: if request.auth != null; allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.status == 'waiting' && request.resource.data.groupSize >= 3 && request.resource.data.groupSize <= 8; allow update: if request.auth != null && resource.data.uid == request.auth.uid; allow delete: if request.auth != null && resource.data.uid == request.auth.uid; }
  match /random_groups/{groupId} { allow read: if request.auth != null && request.auth.uid in resource.data.memberUids; allow create: if request.auth != null && request.auth.uid in request.resource.data.memberUids && request.resource.data.size >= 3 && request.resource.data.size <= 8; allow update: if request.auth != null && request.auth.uid in resource.data.memberUids && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['conversationId','chatReady']) && request.resource.data.chatReady == true && request.resource.data.conversationId is string && request.resource.data.conversationId.size() > 0; allow delete: if false; }
  match /random_connect_reports/{reportId} { allow create: if request.auth != null && request.resource.data.reporterUid == request.auth.uid && request.resource.data.reportedUid is string && request.resource.data.reason is string && request.resource.data.reason.size() <= 120; allow read: if false; allow update, delete: if false; }
  match /random_connect_blocks/{blockId} { allow read: if request.auth != null && resource.data.uid == request.auth.uid; allow create: if request.auth != null && request.resource.data.uid == request.auth.uid && request.resource.data.blockedUid is string; allow delete: if request.auth != null && resource.data.uid == request.auth.uid; allow update: if false; }
  match /users/{userId}/random_sessions/{sessionId} { allow read: if isOwner(userId); allow create: if isOwner(userId) && request.resource.data.keys().hasOnly(['otherUid','otherName','action','kind','createdAt']) && request.resource.data.otherUid is string && request.resource.data.otherUid.size() > 0 && request.resource.data.otherUid.size() <= 128 && request.resource.data.otherName is string && request.resource.data.otherName.size() <= 80 && request.resource.data.action is string && request.resource.data.action.size() <= 32 && request.resource.data.kind is string && request.resource.data.kind.size() <= 16 && request.resource.data.createdAt is timestamp; allow update, delete: if isOwner(userId); }
  match /random_connect/{requestId} { allow read: if request.auth != null; allow create: if false; allow update: if request.auth != null && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','matchedWith','matchedAt','endedAt']) && ((resource.data.uid == request.auth.uid && (request.resource.data.status == 'cancelled' || request.resource.data.status == 'ended')) || (resource.data.status == 'waiting' && request.resource.data.status == 'matched' && request.resource.data.matchedWith == request.auth.uid && request.resource.data.matchedAt is timestamp)); allow delete: if request.auth != null && resource.data.uid == request.auth.uid; }
  match /users/{userId}/blocked/{blockedUid} {
    allow read: if isOwner(userId);
    allow create: if isOwner(userId)
      && blockedUid == request.resource.data.blockedUid
      && blockedUid != userId
      && request.resource.data.keys().hasOnly(['blockedUid','createdAt'])
      && request.resource.data.createdAt is timestamp;
    allow delete: if isOwner(userId);
    allow update: if false;
  }

  match /auren_action_events/{eventId} {
    allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    allow create: if request.auth != null
      && request.resource.data.uid == request.auth.uid
      && request.resource.data.targetId is string
      && request.resource.data.targetId.size() > 0
      && request.resource.data.targetId.size() <= 128
      && request.resource.data.targetKind in ['person','opportunity','business','product','content']
      && request.resource.data.action in ['open','contact','requestQuote','apply','addToCart','follow','save','watch']
      && request.resource.data.intent is string
      && request.resource.data.intent.size() <= 1000
      && request.resource.data.sourceIntent is string
      && request.resource.data.sourceIntent.size() <= 1000
      && request.resource.data.createdAt is timestamp;
    allow update, delete: if false;
  }

  match /reports/{reportId} {
    allow create: if request.auth != null
      && request.resource.data.reporterUid == request.auth.uid
      && request.resource.data.reportedUid is string
      && request.resource.data.reportedUid != request.auth.uid
      && request.resource.data.reason is string
      && request.resource.data.reason.size() > 0
      && request.resource.data.reason.size() <= 500
      && (!request.resource.data.keys().hasAny(['contentId']) || request.resource.data.contentId == null || request.resource.data.contentId is string)
      && (!request.resource.data.keys().hasAny(['contentType']) || request.resource.data.contentType == null || request.resource.data.contentType is string)
      && request.resource.data.status == 'open'
      && request.resource.data.createdAt is timestamp
      && request.resource.data.keys().hasOnly(['reporterUid','reportedUid','reason','contentId','contentType','status','createdAt']);
    allow read, update, delete: if false;
  }

  match /users/{userId}/notifications/{notificationId} {
    allow read: if isOwner(userId);
    allow update: if isOwner(userId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      && request.resource.data.read is bool;
    allow create, delete: if false;
  }

  match /users/{userId}/profile_settings/{settingId} {
    allow read: if isOwner(userId);
    allow create, update: if isOwner(userId)
      && settingId == 'current'
      && request.resource.data.keys().hasOnly(['activeMode','updatedAt'])
      && request.resource.data.activeMode in ['personal','creator','professional','business']
      && request.resource.data.updatedAt is timestamp;
    allow delete: if isOwner(userId);
  }

  match /{path=**}/profile_modes/{modeId} {
    allow list: if request.auth != null && resource.data.discoverable == true;
    allow get: if request.auth != null && resource.data.discoverable == true;
  }

  match /users/{userId}/profile_modes/{modeId} {
    allow read: if request.auth != null
      && (request.auth.uid == userId || resource.data.discoverable == true);
    allow create, update: if isOwner(userId)
      && modeId in ['personal','creator','professional','business']
      && request.resource.data.keys().hasOnly([
        'mode','headline','bio','skills','interests','links','goals','languages','services','achievements','discoverable','showContact','updatedAt'
      ])
      && request.resource.data.mode == modeId
      && request.resource.data.headline is string
      && request.resource.data.headline.size() <= 120
      && request.resource.data.bio is string
      && request.resource.data.bio.size() <= 800
      && request.resource.data.skills is list
      && request.resource.data.skills.size() <= 20
      && request.resource.data.interests is list
      && request.resource.data.interests.size() <= 20
      && request.resource.data.links is list
      && request.resource.data.links.size() <= 5
      && request.resource.data.goals is list
      && request.resource.data.goals.size() <= 10
      && request.resource.data.languages is list
      && request.resource.data.languages.size() <= 10
      && request.resource.data.services is list
      && request.resource.data.services.size() <= 15
      && request.resource.data.achievements is list
      && request.resource.data.achievements.size() <= 10
      && request.resource.data.discoverable is bool
      && request.resource.data.showContact is bool
      && request.resource.data.updatedAt is timestamp;
    allow delete: if isOwner(userId);
  }

  match /users/{userId}/random_notifications/{notificationId} {
    allow read: if isOwner(userId);
    allow update: if isOwner(userId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
      && request.resource.data.read is bool;
    allow create, delete: if false;
  }
  match /users/{userId}/entertainmentDrafts/{draftId} {
    allow read, delete: if isOwner(userId);
    allow create: if isOwner(userId)
      && request.resource.data.keys().hasOnly(['mode','mood','length','idea','status','createdAt','updatedAt'])
      && request.resource.data.mode in ['أغنية','قصة','فيديو','بودكاست','عالم','مسلسل']
      && request.resource.data.mood is string
      && request.resource.data.mood.size() <= 40
      && request.resource.data.length is string
      && request.resource.data.length.size() > 0
      && request.resource.data.length.size() <= 80
      && request.resource.data.idea is string
      && request.resource.data.idea.size() <= 5000
      && request.resource.data.status == 'draft'
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    allow update: if isOwner(userId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['mode','mood','length','idea','status','updatedAt'])
      && request.resource.data.mode in ['أغنية','قصة','فيديو','بودكاست','عالم','مسلسل']
      && request.resource.data.mood is string
      && request.resource.data.mood.size() <= 40
      && request.resource.data.length in ['قصير','متوسط','طويل']
      && request.resource.data.idea is string
      && request.resource.data.idea.size() <= 5000
      && request.resource.data.status == 'draft'
      && request.resource.data.updatedAt is timestamp;
  }

  match /users/{userId}/entertainmentCreationJobs/{jobId} {
    allow read: if isOwner(userId);
    allow create: if isOwner(userId)
      && request.resource.data.keys().hasOnly(['draftId','mode','mood','length','idea','status','provider','externalJobId','progress','plan','assets','createdAt','updatedAt'])
      && request.resource.data.draftId is string
      && request.resource.data.draftId.size() <= 128
      && request.resource.data.mode in ['أغنية','قصة','فيديو','بودكاست','عالم','مسلسل']
      && request.resource.data.mood is string
      && request.resource.data.mood.size() <= 40
      && request.resource.data.length in ['قصير','متوسط','طويل']
      && request.resource.data.idea is string
      && request.resource.data.idea.size() <= 5000
      && request.resource.data.status == 'planning'
      && request.resource.data.provider in ['auren_ai','pollinations','gemini','server_provider']
      && request.resource.data.progress == 0
      && request.resource.data.plan is list
      && request.resource.data.plan.size() >= 2
      && request.resource.data.plan.size() <= 10
      && request.resource.data.assets is list
      && request.resource.data.assets.size() <= 20
      && request.resource.data.createdAt is timestamp
      && request.resource.data.updatedAt is timestamp;
    // Clients may only request a lifecycle action (retry/cancel). All queue,
    // provider, progress and worker metadata is server-owned.
    allow update: if isOwner(userId)
      && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','progress','updatedAt'])
      && request.resource.data.status in ['planning','cancelled']
      && request.resource.data.progress == 0
      && (
        (resource.data.status in ['planning','generating','processing','waiting_provider','failed','cancelled']
          && request.resource.data.status == 'planning')
        || (resource.data.status in ['planning','generating','processing','waiting_provider']
          && request.resource.data.status == 'cancelled')
      )
      && request.resource.data.updatedAt is timestamp;
    allow delete: if isOwner(userId);
  }

    match /users/{userId}/entertainmentAnalytics/{itemId} {
    allow read: if isOwner(userId);
    allow create, update: if isOwner(userId)
      && request.resource.data.itemId == itemId
      && request.resource.data.contentType is string
      && request.resource.data.contentType.size() <= 40;
    allow delete: if false;
  }
  match /users/{userId} {
    match /future_simulator/{scenarioId} { allow read: if isOwner(userId); allow create, update: if isOwner(userId) && scenarioId == 'current' && request.resource.data.keys().hasOnly(['scenarios','updatedAt']) && request.resource.data.scenarios is list && request.resource.data.scenarios.size() <= 10; allow delete: if isOwner(userId); }

    match /digital_twin/{twinId} { allow read: if isOwner(userId); allow create, update: if isOwner(userId) && twinId == 'current' && request.resource.data.keys().hasOnly(['name','summary','goals','preferences','strengths','constraints','updatedAt']) && request.resource.data.name is string && request.resource.data.name.size() <= 80 && request.resource.data.summary is string && request.resource.data.summary.size() <= 1000 && request.resource.data.goals is list && request.resource.data.goals.size() <= 20 && request.resource.data.preferences is list && request.resource.data.preferences.size() <= 20 && request.resource.data.strengths is list && request.resource.data.strengths.size() <= 20 && request.resource.data.constraints is list && request.resource.data.constraints.size() <= 20; allow delete: if isOwner(userId); }

      allow read: if request.auth != null;
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'displayNameLower', 'photoUrl', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.displayNameLower is string
        && request.resource.data.displayNameLower.size() <= 80;
      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'displayName', 'displayNameLower', 'photoUrl', 'createdAt'
        ])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
        && request.resource.data.displayNameLower is string
        && request.resource.data.displayNameLower.size() <= 80
        && request.resource.data.createdAt == resource.data.createdAt
        && (!('aiDraft' in request.resource.data) || (request.resource.data.aiDraft is string && request.resource.data.aiDraft.size() <= 12000));
      allow delete: if isOwner(userId);

      match /opportunity_graph/{graphId} { allow read: if isOwner(userId); allow create, update: if isOwner(userId) && graphId == 'current' && request.resource.data.keys().hasOnly(['nodes','generatedAt']) && request.resource.data.nodes is list && request.resource.data.nodes.size() <= 100 && request.resource.data.generatedAt is timestamp; allow delete: if isOwner(userId); }

      match /learn_by_doing/{planId} { allow read: if isOwner(userId); allow create, update: if isOwner(userId) && planId == 'current' && request.resource.data.keys().hasOnly(['goalTitle','skill','steps','updatedAt']) && request.resource.data.goalTitle is string && request.resource.data.skill is string && request.resource.data.steps is list && request.resource.data.steps.size() <= 10 && request.resource.data.updatedAt is timestamp; allow delete: if isOwner(userId); }
      match /skill_coach/{planId} { allow read: if isOwner(userId); allow create, update: if isOwner(userId) && planId == 'current' && request.resource.data.keys().hasOnly(['skill','goalTitle','level','strengths','gaps','actions','updatedAt']) && request.resource.data.skill is string && request.resource.data.goalTitle is string && request.resource.data.level is string && request.resource.data.strengths is list && request.resource.data.gaps is list && request.resource.data.actions is list && request.resource.data.strengths.size() <= 10 && request.resource.data.gaps.size() <= 10 && request.resource.data.actions.size() <= 10 && request.resource.data.updatedAt is timestamp; allow delete: if isOwner(userId); }

      match /universal_conversation/{contextId} { allow read: if isOwner(userId); allow create, update: if isOwner(userId) && contextId == 'current' && request.resource.data.keys().hasOnly(['summary','goals','memories','businesses','updatedAt']) && request.resource.data.summary is string && request.resource.data.summary.size() <= 1000 && request.resource.data.goals is list && request.resource.data.goals.size() <= 10 && request.resource.data.memories is list && request.resource.data.memories.size() <= 20 && request.resource.data.businesses is list && request.resource.data.businesses.size() <= 10 && request.resource.data.updatedAt is timestamp; allow delete: if isOwner(userId); }

      match /opportunity_chain/{chainId} { allow read: if isOwner(userId); allow create, update: if isOwner(userId) && chainId == 'current' && request.resource.data.keys().hasOnly(['goalTitle','opportunityTitle','steps','updatedAt']) && request.resource.data.goalTitle is string && request.resource.data.opportunityTitle is string && request.resource.data.steps is list && request.resource.data.steps.size() <= 10 && request.resource.data.updatedAt is timestamp; allow delete: if isOwner(userId); }

      match /daily_plans/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && planId == 'current'
          && request.resource.data.keys().hasOnly([
            'goalId','goalTitle','focus','steps','generatedAt',
            'planDate','status','completedTasks','taskCount','updatedAt'
          ])
          && request.resource.data.goalId is string
          && request.resource.data.goalTitle is string
          && request.resource.data.goalTitle.size() <= 200
          && request.resource.data.focus is string
          && request.resource.data.focus.size() <= 500
          && request.resource.data.steps is list
          && request.resource.data.steps.size() <= 10
          && request.resource.data.generatedAt is timestamp
          && (!request.resource.data.keys().hasAny(['planDate']) || request.resource.data.planDate is string)
          && (!request.resource.data.keys().hasAny(['status']) || request.resource.data.status in ['empty','active','completed'])
          && (!request.resource.data.keys().hasAny(['completedTasks']) || request.resource.data.completedTasks is int)
          && (!request.resource.data.keys().hasAny(['taskCount']) || request.resource.data.taskCount is int)
          && (!request.resource.data.keys().hasAny(['updatedAt']) || request.resource.data.updatedAt is timestamp);
        allow delete: if isOwner(userId);

        match /tasks/{taskId} {
          allow read: if isOwner(userId);
          allow create: if isOwner(userId)
            && request.resource.data.keys().hasOnly(['title','order','completed','completedAt','createdAt'])
            && request.resource.data.title is string
            && request.resource.data.title.size() > 0
            && request.resource.data.title.size() <= 300
            && request.resource.data.order is int
            && request.resource.data.order >= 0
            && request.resource.data.order < 10
            && request.resource.data.completed is bool
            && request.resource.data.createdAt is timestamp;
          allow update: if isOwner(userId)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['completed','completedAt'])
            && request.resource.data.completed is bool;
          allow delete: if isOwner(userId);
        }
      }

      match /business_growth_plans/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId) && planId == 'current'
          && request.resource.data.keys().hasOnly(['businessId','businessName','objective','actions','metrics','generatedAt'])
          && request.resource.data.businessId is string && request.resource.data.businessName is string
          && request.resource.data.objective is string && request.resource.data.actions is list
          && request.resource.data.metrics is list && request.resource.data.generatedAt is timestamp
          && request.resource.data.actions.size() <= 10 && request.resource.data.metrics.size() <= 10;
        allow delete: if isOwner(userId);
      }

      match /campaign_ai_plans/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && planId == 'current'
          && request.resource.data.keys().hasOnly(['businessId','businessName','objective','audience','channel','contentIdeas','steps','metrics','generatedAt'])
          && request.resource.data.businessId is string
          && request.resource.data.businessName is string
          && request.resource.data.objective is string && request.resource.data.objective.size() <= 300
          && request.resource.data.audience is string && request.resource.data.audience.size() <= 300
          && request.resource.data.channel is string && request.resource.data.channel.size() <= 60
          && request.resource.data.contentIdeas is list && request.resource.data.contentIdeas.size() <= 20
          && request.resource.data.steps is list && request.resource.data.steps.size() <= 20
          && request.resource.data.metrics is list && request.resource.data.metrics.size() <= 20
          && request.resource.data.generatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /focus_sessions/{sessionId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && sessionId == 'current'
          && request.resource.data.keys().hasOnly(['goalId','title','minutes','startedAt','active','endedAt'])
          && request.resource.data.goalId is string
          && request.resource.data.title is string
          && request.resource.data.minutes is int
          && request.resource.data.minutes >= 1 && request.resource.data.minutes <= 180
          && request.resource.data.startedAt is timestamp
          && request.resource.data.active is bool
          && (!request.resource.data.keys().hasAny(['endedAt']) || request.resource.data.endedAt is timestamp);
        allow delete: if isOwner(userId);
      }

      match /weekly_reviews/{reviewId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && reviewId == 'current'
          && request.resource.data.keys().hasOnly(['activeGoals','completedGoals','enabledMemories','averageProgress','headline','focus','generatedAt'])
          && request.resource.data.activeGoals is int
          && request.resource.data.completedGoals is int
          && request.resource.data.enabledMemories is int
          && request.resource.data.averageProgress is int
          && request.resource.data.headline is string
          && request.resource.data.focus is string
          && request.resource.data.generatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /daily_reviews/{reviewId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && reviewId == 'current'
          && request.resource.data.keys().hasOnly(['activeGoals','completedGoals','enabledMemories','averageProgress','headline','focus','generatedAt'])
          && request.resource.data.activeGoals is int
          && request.resource.data.completedGoals is int
          && request.resource.data.enabledMemories is int
          && request.resource.data.averageProgress is int
          && request.resource.data.headline is string
          && request.resource.data.focus is string
          && request.resource.data.generatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /continuity/{contextId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && contextId == 'current'
          && request.resource.data.keys().hasOnly(['status','summary','activeGoals','enabledMemories','focus','updatedAt'])
          && request.resource.data.status is string
          && request.resource.data.summary is string
          && request.resource.data.activeGoals is int
          && request.resource.data.enabledMemories is int
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /handoffs/{handoffId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['title','summary','destination','context','createdAt'])
          && request.resource.data.title is string
          && request.resource.data.summary is string
          && request.resource.data.destination is string
          && request.resource.data.context is list
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if isOwner(userId);
      }

      match /rescue_mode/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && planId == 'current'
          && request.resource.data.keys().hasOnly(['status','summary','steps','updatedAt'])
          && request.resource.data.status is string
          && request.resource.data.summary is string
          && request.resource.data.steps is list
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /context_switch/{contextId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && contextId == 'current'
          && request.resource.data.keys().hasOnly(['mode','label','description','updatedAt'])
          && request.resource.data.mode is string
          && request.resource.data.mode.size() <= 40
          && request.resource.data.label is string
          && request.resource.data.label.size() <= 120
          && request.resource.data.description is string
          && request.resource.data.description.size() <= 500
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /auto_organize/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && planId == 'current'
          && request.resource.data.keys().hasOnly(['items','memoryCount','activeGoalCount','updatedAt'])
          && request.resource.data.items is list
          && request.resource.data.items.size() <= 120
          && request.resource.data.memoryCount is int
          && request.resource.data.memoryCount >= 0
          && request.resource.data.activeGoalCount is int
          && request.resource.data.activeGoalCount >= 0
          && request.resource.data.updatedAt is timestamp;
        allow delete: if isOwner(userId);
      }

      match /autopilot/{planId} {
        allow read: if isOwner(userId);
        allow create, update: if isOwner(userId)
          && planId == 'current'
          && request.resource.data.keys().hasOnly(['goal','summary','steps','updatedAt','paused'])
          && request.resource.data.goal is string
          && request.resource.data.goal.size() <= 300
          && request.resource.data.summary is string
          && request.resource.data.summary.size() <= 2000
          && request.resource.data.steps is list
          && request.resource.data.steps.size() <= 10
          && request.resource.data.updatedAt is timestamp
          && (!request.resource.data.keys().hasAny(['paused']) || request.resource.data.paused is bool);
        allow delete: if isOwner(userId);
      }

      match /memory_timeline/{eventId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['memoryId','key','value','action','createdAt'])
          && request.resource.data.memoryId is string
          && request.resource.data.memoryId.size() > 0
          && request.resource.data.key is string
          && request.resource.data.key.size() > 0
          && request.resource.data.key.size() <= 120
          && request.resource.data.value is string
          && request.resource.data.value.size() <= 4000
          && request.resource.data.action in ['created','updated','deleted']
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }

      match /presence/{presenceId} {
        allow read: if request.auth != null;
        allow create, update: if isOwner(userId)
          && presenceId == 'primary'
          && request.resource.data.keys().hasOnly(['online', 'lastSeen'])
          && request.resource.data.online is bool
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 80
          && request.resource.data.lastSeen is timestamp;
        allow delete: if isOwner(userId);
      }

      match /goals/{goalId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && (request.resource.data.description == null || request.resource.data.description is string)
          && (request.resource.data.description == null || request.resource.data.description.size() <= 2000)
          && request.resource.data.progress is int
          && request.resource.data.progress >= 0
          && request.resource.data.progress <= 100
          && request.resource.data.status in ['active', 'completed', 'paused', 'archived']
          && request.resource.data.createdAt is string
          && request.resource.data.updatedAt is string
          && request.resource.data.keys().hasOnly([
            'title', 'description', 'progress', 'status', 'createdAt', 'updatedAt'
          ]);
        allow update: if isOwner(userId)
          && request.resource.data.title is string
          && request.resource.data.title.size() > 0
          && request.resource.data.title.size() <= 200
          && (request.resource.data.description == null || request.resource.data.description is string)
          && (request.resource.data.description == null || request.resource.data.description.size() <= 2000)
          && request.resource.data.progress is int
          && request.resource.data.progress >= 0
          && request.resource.data.progress <= 100
          && request.resource.data.status in ['active', 'completed', 'paused', 'archived']
          && request.resource.data.createdAt == resource.data.createdAt
          && request.resource.data.updatedAt is string
          && request.resource.data.keys().hasOnly([
            'title', 'description', 'progress', 'status', 'createdAt', 'updatedAt'
          ]);
        allow delete: if isOwner(userId);
      }

      match /actions/{actionId} {
        allow read: if isOwner(userId);
        // Action proposals and lifecycle mutations are server-controlled.
        // The client can read its own action records but cannot forge,
        // approve, reject, cancel, or execute an action directly.
        allow create, update, delete: if false;
      }

      match /agent_installations/{agentId} {
        allow read: if isOwner(userId);
        // Server-controlled lifecycle: validation happens in Cloud Functions.
        allow create, update, delete: if false;
      }

      match /agent_permissions/{permissionId} {
        allow read: if isOwner(userId);
        // Permission ledger lifecycle is server-controlled. Client can only read it.
        allow create, update, delete: if false;
      }

      match /agents/{agentId} {
        allow read: if isOwner(userId);
        // Agent lifecycle is server-controlled. Client may only read owned agents.
        allow create, update, delete: if false;
      }

      match /agent_trust/{agentId} {
        allow read: if request.auth != null;
        allow write: if false;
      }

      match /wallet/{walletId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /wallet_transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /action_executions/{executionId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /action_audit/{eventId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /disputes/{disputeId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /agent_liability/{liabilityId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /disputes/{disputeId}/evidence/{evidenceId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /memory/{memoryId} {
        allow read: if isOwner(userId);

        // Client memory edits are limited to the user-facing fields.
        // Server-side AUREN Actions can still write provenance fields via Admin SDK.
        allow create: if isOwner(userId)
          && request.resource.data.key is string
          && request.resource.data.key.size() > 0
          && request.resource.data.key.size() <= 120
          && request.resource.data.value is string
          && request.resource.data.value.size() > 0
          && request.resource.data.value.size() <= 4000
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is string
          && request.resource.data.keys().hasOnly([
            'key', 'value', 'enabled', 'updatedAt'
          ]);

        allow update: if isOwner(userId)
          && request.resource.data.key is string
          && request.resource.data.key.size() > 0
          && request.resource.data.key.size() <= 120
          && request.resource.data.value is string
          && request.resource.data.value.size() > 0
          && request.resource.data.value.size() <= 4000
          && request.resource.data.enabled is bool
          && request.resource.data.updatedAt is string
          && request.resource.data.keys().hasOnly([
            'key', 'value', 'enabled', 'updatedAt'
          ]);

        allow delete: if isOwner(userId);
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(userId);
        allow update: if isOwner(userId)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
          && request.resource.data.read is bool;
        allow create, delete: if false;
      }


      match /notes/{noteId} {
        allow read: if isOwner(userId);
        allow write: if false;
      }

      match /agent_work_executions/{executionId} {
        allow read: if isOwner(userId);
