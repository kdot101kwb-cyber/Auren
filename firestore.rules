        && request.resource.data.talentId.size() <= 120
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.role in ['career', 'discovery', 'portfolio', 'brand', 'negotiation', 'sports']
