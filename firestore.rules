        && profileId == 'profile'
        && request.resource.data.keys().hasOnly(['ownerId','coachMode','sport','level','goal','weeklySessions','updatedAt'])
        && request.resource.data.ownerId == userId
        && request.resource.data.coachMode in ['ai','human']
        && request.resource.data.sport is string
        && request.resource.data.sport.size() <= 100
        && request.resource.data.level is string
        && request.resource.data.level.size() <= 60
        && request.resource.data.goal is string
        && request.resource.data.goal.size() <= 500
        && request.resource.data.weeklySessions is int
        && request.resource.data.weeklySessions >= 1
        && request.resource.data.weeklySessions <= 7
