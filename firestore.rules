        && request.resource.data.createdAt is timestamp;
      allow update: if request.auth != null
        && resource.data.communityId is string
        && request.auth.uid in get(/databases/$(database)/documents/communities/$(resource.data.communityId)).data.memberIds
        && !(request.auth.uid in resource.data.voters)
        && request.auth.uid in request.resource.data.voters
