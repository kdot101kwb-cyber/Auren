        && request.resource.data.targetId.size() <= 128
        && request.resource.data.targetKind in ['person','opportunity','business','product','content']
        && request.resource.data.action in ['open','contact','requestQuote','apply','addToCart','follow','save','watch']
        && request.resource.data.intent is string
        && request.resource.data.intent.size() <= 1000
        && request.resource.data.step is int
        && request.resource.data.step >= 0
        && request.resource.data.totalSteps is int
