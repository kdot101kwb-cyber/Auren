    match /follows/{followId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.followerId == request.auth.uid
        && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(request.resource.data.followingId))
        && !exists(/databases/$(database)/documents/users/$(request.resource.data.followingId)/blocked/$(request.auth.uid))
        && followId == request.resource.data.followerId + '_' + request.resource.data.followingId
        && request.resource.data.followingId is string
        && request.resource.data.followerId != request.resource.data.followingId
        && request.resource.data.keys().hasOnly([
          'followerId', 'followingId', 'createdAt'
        ]);
      allow delete: if request.auth != null
        && resource.data.followerId == request.auth.uid;
      allow update: if false;
    }

    match /marketplace_orders/{orderId} {
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.ownerId
        && request.resource.data.productId is string
        && request.resource.data.quantity is int && request.resource.data.quantity > 0 && request.resource.data.quantity <= 1000
        && request.resource.data.unitPriceMinor == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.priceMinor
        && request.resource.data.unitPriceMinor >= 0
        && request.resource.data.deliveryFeeMinor is int && request.resource.data.deliveryFeeMinor >= 0
        && request.resource.data.totalMinor == request.resource.data.unitPriceMinor * request.resource.data.quantity + request.resource.data.deliveryFeeMinor
        && request.resource.data.currency is string
        && request.resource.data.currency == get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.currency
        && request.resource.data.paymentMethod in ['cash_on_delivery','pending_gateway']
        && ((request.resource.data.paymentMethod == 'cash_on_delivery' && request.resource.data.paymentStatus == 'unpaid') || (request.resource.data.paymentMethod == 'pending_gateway' && request.resource.data.paymentStatus == 'pending'))
        && request.resource.data.deliveryProviderId is string
        && request.resource.data.deliveryProviderId in ['manual','sa3i','link_express','afrimex','twseel','wdee']
        && request.resource.data.deliveryStatus == 'pending'
        && get(/databases/$(database)/documents/products/$(request.resource.data.productId)).data.status == 'active'
        && request.resource.data.status == 'pending'
        && request.resource.data.deliveryAddress is string && request.resource.data.deliveryAddress.size() > 0 && request.resource.data.deliveryAddress.size() <= 500
        && request.resource.data.deliveryPhone is string && request.resource.data.deliveryPhone.size() > 0 && request.resource.data.deliveryPhone.size() <= 40
        && request.resource.data.estimatedDeliveryAt is timestamp
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.statusUpdatedAt is timestamp
        && request.resource.data.keys().hasOnly(['buyerId','sellerId','productId','quantity','unitPriceMinor','deliveryFeeMinor','totalMinor','currency','paymentMethod','paymentStatus','deliveryProviderId','shipmentId','trackingNumber','trackingUrl','deliveryStatus','productName','productImageUrl','deliveryAddress','deliveryPhone','status','estimatedDeliveryAt','createdAt','updatedAt','statusUpdatedAt']);
      allow read: if request.auth != null && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow update: if request.auth != null && resource.data.sellerId == request.auth.uid
        && request.resource.data.buyerId == resource.data.buyerId
        && request.resource.data.sellerId == resource.data.sellerId
        && request.resource.data.productId == resource.data.productId
        && request.resource.data.quantity == resource.data.quantity
        && request.resource.data.unitPriceMinor == resource.data.unitPriceMinor
        && request.resource.data.deliveryFeeMinor == resource.data.deliveryFeeMinor
        && request.resource.data.totalMinor == resource.data.totalMinor
        && request.resource.data.currency == resource.data.currency
        && request.resource.data.paymentMethod == resource.data.paymentMethod
        && request.resource.data.paymentStatus == resource.data.paymentStatus
        && request.resource.data.productName == resource.data.productName
        && request.resource.data.productImageUrl == resource.data.productImageUrl
        && request.resource.data.deliveryAddress == resource.data.deliveryAddress
        && request.resource.data.deliveryPhone == resource.data.deliveryPhone
        && request.resource.data.estimatedDeliveryAt is timestamp
        && request.resource.data.createdAt == resource.data.createdAt
        && (
          (resource.data.status == 'pending' && request.resource.data.status in ['pending','confirmed','cancelled'])
          || (resource.data.status == 'confirmed' && request.resource.data.status in ['confirmed','processing','cancelled'])
          || (resource.data.status == 'processing' && request.resource.data.status in ['processing','shipped','cancelled'])
          || (resource.data.status == 'shipped' && request.resource.data.status in ['shipped','delivered'])
          || (resource.data.status in ['delivered','cancelled'] && request.resource.data.status == resource.data.status)
        )
        && request.resource.data.statusUpdatedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && (request.resource.data.shipmentId is string || request.resource.data.shipmentId == null)
        && (request.resource.data.trackingNumber is string || request.resource.data.trackingNumber == null)
        && (request.resource.data.trackingUrl is string || request.resource.data.trackingUrl == null)
        && request.resource.data.deliveryProviderId in ['manual','sa3i','link_express','afrimex','twseel','wdee']
        && request.resource.data.deliveryStatus in ['pending','assigned','picked_up','shipped','delivered','failed','returned']
        && (
          request.resource.data.deliveryStatus == resource.data.deliveryStatus
          || (resource.data.deliveryStatus == 'pending' && request.resource.data.deliveryStatus in ['assigned','failed'])
          || (resource.data.deliveryStatus == 'assigned' && request.resource.data.deliveryStatus in ['picked_up','failed'])
          || (resource.data.deliveryStatus == 'picked_up' && request.resource.data.deliveryStatus in ['shipped','failed'])
          || (resource.data.deliveryStatus == 'shipped' && request.resource.data.deliveryStatus in ['delivered','failed','returned'])
          || (resource.data.deliveryStatus == 'failed' && request.resource.data.deliveryStatus in ['assigned','returned'])
        )
        && request.resource.data.keys().hasOnly(['buyerId','sellerId','productId','quantity','unitPriceMinor','deliveryFeeMinor','totalMinor','currency','paymentMethod','paymentStatus','deliveryProviderId','shipmentId','trackingNumber','trackingUrl','deliveryStatus','productName','productImageUrl','deliveryAddress','deliveryPhone','status','estimatedDeliveryAt','createdAt','updatedAt','statusUpdatedAt']);
      allow delete: if false;
    }
    match /marketplace_notifications/{notificationId} {
      allow read: if request.auth != null && resource.data.recipientUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.actorUid == request.auth.uid
        && request.resource.data.recipientUid is string
        && request.resource.data.orderId is string
        && get(/databases/$(database)/documents/marketplace_orders/$(request.resource.data.orderId)).data.buyerId == request.resource.data.actorUid
        && ((request.resource.data.type == 'order_created' && get(/databases/$(database)/documents/marketplace_orders/$(request.resource.data.orderId)).data.sellerId == request.resource.data.recipientUid)
          || (request.resource.data.type in ['order_status','shipment_created'] && get(/databases/$(database)/documents/marketplace_orders/$(request.resource.data.orderId)).data.sellerId == request.resource.data.actorUid && get(/databases/$(database)/documents/marketplace_orders/$(request.resource.data.orderId)).data.buyerId == request.resource.data.recipientUid))
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.body is string
        && request.resource.data.body.size() <= 1000
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['recipientUid','actorUid','orderId','type','title','body','createdAt','read']);
      allow update: if request.auth != null
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if false;
    }

    match /users/{userId}/cart/{productId} {
      allow read, create, update, delete: if isOwner(userId);
    }
    match /products/{productId}/reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && reviewId == request.auth.uid
        && request.resource.data.productId == productId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null && reviewId == request.auth.uid;
    }
    match /products/{productId}/offers/{offerId} {
      allow read: if request.auth != null;
      allow create, update: if request.auth != null
        && request.resource.data.ownerId == get(/databases/$(database)/documents/products/$(productId)).data.ownerId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.productId == productId
        && request.resource.data.percent is int && request.resource.data.percent >= 0 && request.resource.data.percent <= 100
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.active is bool;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /products/{productId} {
      allow read: if request.auth != null && resource.data.status == 'active';
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.businessId is string
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.description is string && request.resource.data.description.size() <= 3000
        && request.resource.data.category is string && request.resource.data.category.size() <= 60
        && request.resource.data.currency is string && request.resource.data.currency.size() == 3
        && request.resource.data.priceMinor is int && request.resource.data.priceMinor >= 0
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 1000
        && request.resource.data.service is bool
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['ownerId','businessId','name','description','category','currency','priceMinor','imageUrl','service','status','createdAt']);
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.businessId == resource.data.businessId
        && get(/databases/$(database)/documents/businesses/$(request.resource.data.businessId)).data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 160
        && request.resource.data.description is string && request.resource.data.description.size() <= 3000
        && request.resource.data.category is string && request.resource.data.category.size() <= 60
        && request.resource.data.currency is string && request.resource.data.currency.size() == 3
        && request.resource.data.priceMinor is int && request.resource.data.priceMinor >= 0
        && request.resource.data.imageUrl is string && request.resource.data.imageUrl.size() <= 1000
        && request.resource.data.service is bool
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly(['ownerId','businessId','name','description','category','currency','priceMinor','imageUrl','service','status','createdAt']);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /products/{productId}/events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.productId == productId
        && request.resource.data.viewerUid == request.auth.uid
        && request.resource.data.ownerId == get(/databases/$(database)/documents/products/$(productId)).data.ownerId
        && request.resource.data.type in ['view','message','save']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['productId','ownerId','viewerUid','type','createdAt']);
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/products/$(productId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /businesses/{businessId}/growth_campaigns/{campaignId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.businessId == businessId
        && request.resource.data.status == 'draft'
        && request.resource.data.name is string && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 120
        && request.resource.data.goal is string && request.resource.data.goal.size() > 0 && request.resource.data.goal.size() <= 500
        && request.resource.data.audience is string && request.resource.data.audience.size() <= 300
        && request.resource.data.channel in ['Social','Messenger','Email','Community','Creator']
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['draft','active','paused','completed']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /orders/{orderId} {
      allow read: if request.auth != null
        && (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid);
      allow create: if request.auth != null
        && request.resource.data.buyerId == request.auth.uid
        && request.resource.data.sellerId is string
        && request.resource.data.sellerId != request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 240
        && request.resource.data.currency is string && request.resource.data.currency.matches('^[A-Z]{3}$')
        && request.resource.data.amountMinor is int && request.resource.data.amountMinor > 0
        && request.resource.data.status == 'pending'
        && request.resource.data.deliveryStatus == 'not_started'
        && request.resource.data.createdAt is timestamp && request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null
        && resource.data.sellerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deliveryStatus','updatedAt'])
        && request.resource.data.deliveryStatus in ['not_started','preparing','shipped','out_for_delivery','delivered','cancelled']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;
    }

    match /supply_requests/{requestId} {
      allow read: if request.auth != null && resource.data.status == 'open';
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string && request.resource.data.title.size() > 0 && request.resource.data.title.size() <= 160
        && request.resource.data.description is string && request.resource.data.description.size() > 0 && request.resource.data.description.size() <= 3000
        && request.resource.data.category is string && request.resource.data.category.size() <= 100
        && request.resource.data.city is string && request.resource.data.city.size() <= 100
        && request.resource.data.country is string && request.resource.data.country.size() <= 100
        && request.resource.data.targetCountries is list && request.resource.data.targetCountries.size() <= 20
        && request.resource.data.requestedSkills is list && request.resource.data.requestedSkills.size() <= 20
        && request.resource.data.status == 'open'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['open','closed']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /users/{userId}/commerce_intents/{intentId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.action == 'purchase'
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 240
        && request.resource.data.currency is string
        && request.resource.data.currency.matches('^[A-Z]{3}$')
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.status == 'awaiting_approval'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if isOwner(userId)
        && resource.data.status == 'awaiting_approval'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','approvedAt','updatedAt'])
        && request.resource.data.status in ['approved','cancelled']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(userId) && resource.data.status == 'awaiting_approval';
    }

    match /wallets/{userId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.uid == userId
        && request.resource.data.currency is string
        && request.resource.data.currency.size() == 3
        && request.resource.data.balanceMinor == 0
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['uid','currency','balanceMinor','status','createdAt']);
      allow update: if isOwner(userId)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['spendingLimitMinor','updatedAt'])
        && request.resource.data.spendingLimitMinor is int
        && request.resource.data.spendingLimitMinor >= 0
        && request.resource.data.updatedAt is timestamp;
      allow delete: if false;

      match /transactions/{transactionId} {
        allow read: if isOwner(userId);
        allow create, update, delete: if false;
      }
    }

    // Canonical Education schema. Course publishing is server/admin-owned;
    // learners may only read published courses and manage their own progress.
    match /courses/{courseId} {
      allow read: if request.auth != null && resource.data.status == 'published';
      allow create, update, delete: if false;
    }

    match /users/{userId}/enrollments/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'courseId','completedLessons','progress','status','createdAt','updatedAt'
        ])
        && request.resource.data.courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && request.resource.data.completedLessons == 0
        && request.resource.data.progress == 0
        && request.resource.data.status == 'active'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;

      allow update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'courseId','completedLessons','progress','status','createdAt','updatedAt'
        ])
        && request.resource.data.courseId == resource.data.courseId
        && request.resource.data.courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && request.resource.data.completedLessons is int
        && request.resource.data.completedLessons >= 0
        && request.resource.data.completedLessons <= get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount
        && request.resource.data.progress is int
        && request.resource.data.progress >= 0
        && request.resource.data.progress <= 100
        // The repository derives the displayed percentage from completedLessons.
        // Avoid exact percentage arithmetic here because rounded values such as 1/3 = 33%
        // are not exactly representable as integers in Firestore rules.
        && request.resource.data.status == (
          request.resource.data.completedLessons == get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount
            ? 'completed'
            : 'active'
        )
        && (
          request.resource.data.completedLessons < get(/databases/$(database)/documents/courses/$(courseId)).data.lessonCount
            ? request.resource.data.progress < 100
            : request.resource.data.progress == 100
        )
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.updatedAt is timestamp;

      allow delete: if isOwner(userId);
    }

    match /users/{userId}/savedCourses/{courseId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly(['courseId','createdAt'])
        && request.resource.data.courseId == courseId
        && get(/databases/$(database)/documents/courses/$(courseId)).data.status == 'published'
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(userId);
    }
    match /trips/{tripId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.destination is string
        && request.resource.data.destination.size() > 0
        && request.resource.data.destination.size() <= 160
        && request.resource.data.travelers is int
        && request.resource.data.travelers >= 1
        && request.resource.data.travelers <= 50
        && request.resource.data.placeIds is list
        && request.resource.data.placeIds.size() <= 100
        && request.resource.data.status == 'planned'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly(['ownerId','title','destination','startDate','endDate','travelers','placeIds','status','createdAt','updatedAt']);
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['planned','active','completed','cancelled']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }
    match /users/{userId}/savedPlaces/{placeId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if false;
    }
    match /users/{userId}/entertainmentSignals/{itemId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'itemId','lastViewedAt','lastActionAt','watchSeconds','views',
          'completions','likes','saves','skips','mood'
        ])
        && request.resource.data.itemId == itemId
        && (!request.resource.data.keys().hasAny(['watchSeconds']) || request.resource.data.watchSeconds is number)
        && (!request.resource.data.keys().hasAny(['views']) || request.resource.data.views is number)
        && (!request.resource.data.keys().hasAny(['completions']) || request.resource.data.completions is number)
        && (!request.resource.data.keys().hasAny(['likes']) || request.resource.data.likes is number)
        && (!request.resource.data.keys().hasAny(['saves']) || request.resource.data.saves is number)
        && (!request.resource.data.keys().hasAny(['skips']) || request.resource.data.skips is number)
        && (!request.resource.data.keys().hasAny(['mood']) || request.resource.data.mood is string);
      allow delete: if isOwner(userId);

      match /actions/{actionId} {
        allow read: if isOwner(userId);
        allow create: if isOwner(userId)
          && request.resource.data.keys().hasOnly(['action','mood','createdAt'])
          && request.resource.data.action is string
          && request.resource.data.action.size() <= 32
          && request.resource.data.mood is string
          && request.resource.data.mood.size() <= 32
          && request.resource.data.createdAt is timestamp;
        allow update, delete: if false;
      }
    }

        match /users/{userId}/podcastEpisodeSaves/{episodeId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.episodeId == episodeId
        && request.resource.data.episodeId is string
        && request.resource.data.createdAt is timestamp;
      allow update: if isOwner(userId)
        && request.resource.data.episodeId == resource.data.episodeId
        && request.resource.data.episodeId == episodeId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['offline'])
        && request.resource.data.offline is bool;
      allow delete: if isOwner(userId);
    }

        match /users/{userId}/podcastLikes/{episodeId} {
      allow read: if isOwner(userId);
      allow create: if isOwner(userId)
        && request.resource.data.episodeId == episodeId
        && request.resource.data.episodeId is string
        && request.resource.data.createdAt is timestamp;
      allow update: if false;
      allow delete: if isOwner(userId);
    }

    match /entertainment_items/{itemId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['title','description','mediaUrl','mediaKind','imageUrl','type','creatorId','channelId','visibility','createdAt'])
        && request.resource.data.creatorId == request.auth.uid
        && request.resource.data.channelId is string
        && request.resource.data.channelId.size() > 0
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 160
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 3000
        && request.resource.data.mediaUrl is string
        && request.resource.data.mediaUrl.size() > 0
        && request.resource.data.mediaUrl.size() <= 2000
        && request.resource.data.mediaKind == 'video'
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 2000
        && request.resource.data.type is string
        && request.resource.data.type.size() > 0
        && request.resource.data.type.size() <= 80
        && request.resource.data.visibility == 'public'
        && request.resource.data.createdAt is timestamp
        && get(/databases/$(database)/documents/content_channels/$(request.resource.data.channelId)).data.ownerId == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.creatorId == request.auth.uid
        && request.resource.data.creatorId == resource.data.creatorId
        && request.resource.data.channelId == resource.data.channelId
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title','description','mediaUrl','imageUrl','type']);
      allow delete: if request.auth != null && resource.data.creatorId == request.auth.uid;
    }
    match /entertainment_items/{itemId}/likes/{userId} {
      allow read: if request.auth != null;
      allow create, delete: if request.auth != null
        && request.auth.uid == userId;
      allow update: if false;
    }
    match /entertainment_items/{itemId}/comments/{commentId} {
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/entertainment_items/$(itemId)).data.visibility == 'public';
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['uid','text','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 1000
        && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null
        && resource.data.uid == request.auth.uid;
      allow update: if false;
    }
    match /users/{userId}/savedEntertainment/{itemId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if false;
    }
    match /creator_support_requests/{requestId} {
      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['creatorUid','supporterUid','amountMinor','currency','message','status','createdAt'])
        && request.resource.data.supporterUid == request.auth.uid
        && request.resource.data.creatorUid is string
        && request.resource.data.creatorUid.size() > 0
        && request.resource.data.amountMinor is int
        && request.resource.data.amountMinor > 0
        && request.resource.data.amountMinor <= 100000000
        && request.resource.data.currency is string
        && request.resource.data.currency.size() == 3
        && request.resource.data.message is string
        && request.resource.data.message.size() <= 500
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp;
      allow read: if request.auth != null
        && (resource.data.creatorUid == request.auth.uid || resource.data.supporterUid == request.auth.uid);
      allow update, delete: if false;
    }
    match /creator_earnings/{earningId} {
      allow read: if request.auth != null && resource.data.creatorUid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /creator_withdrawal_ledger/{withdrawalId} {
    allow read: if request.auth != null && resource.data.creatorUid == request.auth.uid;
    allow create, update, delete: if false;
  }

  match /creator_withdrawals/{withdrawalId} {
      allow read: if request.auth != null && resource.data.creatorUid == request.auth.uid;
      allow create, update, delete: if false;
    }
    match /creator_drafts/{draftId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow create: if request.auth != null && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /businesses/{businessId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 120
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 2000
        && request.resource.data.category is string
        && request.resource.data.category.size() > 0
        && request.resource.data.category.size() <= 40
        && request.resource.data.city is string
        && request.resource.data.city.size() <= 100
        && request.resource.data.country is string
        && request.resource.data.country.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.size() <= 40
        && request.resource.data.website is string
        && request.resource.data.website.size() <= 300
        && request.resource.data.imageUrl is string
        && request.resource.data.imageUrl.size() <= 1000
        && request.resource.data.businessType is string
        && request.resource.data.businessType.size() > 0
        && request.resource.data.businessType.size() <= 60
        && request.resource.data.status == 'active'
        && request.resource.data.visibility == 'public'
        && request.resource.data.verified == false
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'ownerId','name','description','category','city','country',
          'phone','website','imageUrl','businessType','status','visibility','verified','createdAt'
        ]);
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.ownerId == resource.data.ownerId
        && request.resource.data.verified == resource.data.verified
        && request.resource.data.businessType is string
        && request.resource.data.businessType.size() > 0
        && request.resource.data.businessType.size() <= 60
        && request.resource.data.status in ['active','temporarily_closed','permanently_closed','suspended']
        && request.resource.data.visibility == resource.data.visibility
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.keys().hasOnly([
          'ownerId','name','description','category','city','country',
          'phone','website','imageUrl','businessType','status','visibility','verified','createdAt'
        ]);
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /businesses/{businessId}/events/{eventId} {
      allow create: if request.auth != null
        && request.resource.data.businessId == businessId
        && request.resource.data.ownerId == get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId
        && request.resource.data.viewerUid == request.auth.uid
        && request.resource.data.type in ['view','message','save','lead']
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['businessId','ownerId','viewerUid','type','createdAt']);
      allow read: if request.auth != null
        && get(/databases/$(database)/documents/businesses/$(businessId)).data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /businesses/{businessId}/reviews/{reviewId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && reviewId == request.auth.uid
        && request.resource.data.businessId == businessId
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['businessId','userId','rating','text','createdAt']);
      allow update: if request.auth != null
        && reviewId == request.auth.uid
        && resource.data.userId == request.auth.uid
        && request.resource.data.businessId == resource.data.businessId
        && request.resource.data.userId == resource.data.userId
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rating','text','createdAt'])
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 2000
        && request.resource.data.createdAt is timestamp;
      allow delete: if request.auth != null && reviewId == request.auth.uid;
    }

    match /marketplace_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.productId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.keys().hasOnly(['productId','reporterUid','reason','createdAt']);
      allow read, update, delete: if false;
    }

    match /users/{userId}/savedProducts/{productId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if false;
    }

    match /users/{userId}/savedOpportunities/{opportunityId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if false;
    }

    match /users/{userId}/opportunityApplications/{opportunityId} {
      allow read: if isOwner(userId) || (request.auth != null && resource.data.ownerId == request.auth.uid);
      allow create: if isOwner(userId)
        && request.resource.data.keys().hasOnly([
          'opportunityId','ownerId','applicantId','title','note','status',
          'matchScore','matchedVerifiedSkills','createdAt','updatedAt'
        ])
        && request.resource.data.opportunityId == opportunityId
        && exists(/databases/$(database)/documents/opportunities/$(opportunityId))
        && get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.status == 'open'
        && get(/databases/$(database)/documents/opportunities/$(opportunityId)).data.ownerId == request.resource.data.ownerId
        && request.resource.data.ownerId is string
        && request.resource.data.applicantId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000
        && request.resource.data.matchScore is number
        && request.resource.data.matchScore == 0
        && request.resource.data.matchedVerifiedSkills is list
        && request.resource.data.matchedVerifiedSkills.size() == 0
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.updatedAt is timestamp;
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
        && request.resource.data.status in ['pending','accepted','rejected']
        && request.resource.data.updatedAt is timestamp;
      allow delete: if isOwner(userId);
    }

    match /{path=**}/opportunityApplications/{applicationId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /opportunity_invitations/{invitationId} {
    allow read: if request.auth != null
      && (resource.data.talentUid == request.auth.uid || resource.data.ownerId == request.auth.uid);
    allow create: if request.auth != null
      && request.resource.data.keys().hasOnly(['ownerId','talentUid','opportunityId','opportunityTitle','status','createdAt'])
      && request.resource.data.ownerId == request.auth.uid
      && request.resource.data.ownerId is string
      && request.resource.data.ownerId.size() > 0
      && request.resource.data.ownerId.size() <= 128
      && request.resource.data.talentUid is string
      && request.resource.data.talentUid.size() > 0
      && request.resource.data.talentUid.size() <= 128
      && request.resource.data.talentUid != request.auth.uid
      && request.resource.data.opportunityId is string
      && request.resource.data.opportunityId.size() > 0
      && request.resource.data.opportunityId.size() <= 128
      && request.resource.data.opportunityTitle is string
      && request.resource.data.opportunityTitle.size() > 0
      && request.resource.data.opportunityTitle.size() <= 200
      && request.resource.data.status == 'pending'
      && request.resource.data.createdAt is timestamp
      && exists(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId))
      && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.ownerId == request.auth.uid;
    allow update: if request.auth != null
      && (
        (resource.data.talentUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && resource.data.status == 'pending'
          && request.resource.data.status in ['accepted','declined']
          && (request.resource.data.status == 'declined'
            || resource.data.validationStatus == 'verified_skill_match'))
        ||
        (resource.data.ownerId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status','updatedAt'])
          && resource.data.status == 'pending'
          && request.resource.data.status == 'declined')
      )
      && request.resource.data.updatedAt is timestamp;
    allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
  }

  match /opportunity_application_notifications/{notificationId} {
      allow create: if request.auth != null
        && request.resource.data.recipientUid is string
        && request.resource.data.opportunityId is string
        && request.resource.data.title is string
        && request.resource.data.read == false
        && request.resource.data.createdAt is timestamp
        && (
          (
            request.resource.data.applicantUid == request.auth.uid
            && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.ownerId == request.resource.data.recipientUid
            && request.resource.data.keys().hasOnly([
              'recipientUid','applicantUid','opportunityId','title','createdAt','read'
            ])
          )
          ||
          (
            request.resource.data.status in ['accepted','rejected']
            && get(/databases/$(database)/documents/opportunities/$(request.resource.data.opportunityId)).data.ownerId == request.auth.uid
            && request.resource.data.recipientUid is string
            && request.resource.data.keys().hasOnly([
              'recipientUid','opportunityId','title','status','createdAt','read'
            ])
          )
        );
      allow read: if request.auth != null
        && resource.data.recipientUid == request.auth.uid;
      allow update: if request.auth != null
        && resource.data.recipientUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read'])
        && request.resource.data.read is bool;
      allow delete: if request.auth != null
        && resource.data.recipientUid == request.auth.uid;
    }

    match /users/{userId}/savedBusinesses/{businessId} {
      allow read, create, delete: if isOwner(userId);
      allow update: if false;
    }

    match /business_verification_requests/{businessId} {
      allow create: if request.auth != null
        && request.resource.data.businessId == businessId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.note is string
        && request.resource.data.note.size() <= 2000
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly(['businessId','ownerId','note','status','createdAt']);
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      allow update, delete: if false;
    }

    match /business_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.businessId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.keys().hasOnly(['businessId','reporterUid','reason','createdAt']);
      allow read, update, delete: if false;
    }

    match /places/{placeId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    // Talent skill graph: verified skills are discoverable; unverified evidence stays owner-only.
    match /talent_skill_graph/{skillId} {
      allow read: if request.auth != null
        && (resource.data.ownerId == request.auth.uid || resource.data.verified == true);
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.skill is string
        && request.resource.data.skill.size() > 0
        && request.resource.data.skill.size() <= 120
        && request.resource.data.confidence is number
        && request.resource.data.confidence >= 0
        && request.resource.data.confidence <= 1
        && request.resource.data.evidenceCount is int
        && request.resource.data.evidenceCount >= 0
        && request.resource.data.evidenceCount <= 1000
        && request.resource.data.keys().hasOnly([
          'ownerId','skill','confidence','evidenceCount','source','lastMission',
          'lastResult','hasEvidence','evidence','updatedAt','verified','verifiedAt','verificationSource'
        ])
        && (!request.resource.data.keys().hasAny(['evidence']) || request.resource.data.evidence is string)
        && (!request.resource.data.keys().hasAny(['verified']) || request.resource.data.verified == false || isAdmin());

      // Owners may update their evidence fields, but only admins may change
      // a skill to verified or set verification metadata.
      allow update: if request.auth != null
        && (
          (
            resource.data.ownerId == request.auth.uid
            && request.resource.data.ownerId == resource.data.ownerId
            && (!request.resource.data.keys().hasAny(['verified']) || request.resource.data.verified == resource.data.verified)
            && (!request.resource.data.keys().hasAny(['verificationSource']) || request.resource.data.verificationSource == resource.data.verificationSource)
            && (!request.resource.data.keys().hasAny(['verifiedAt']) || request.resource.data.verifiedAt == resource.data.verifiedAt)
          )
          ||
          (
            isAdmin()
            && request.resource.data.ownerId == resource.data.ownerId
            && request.resource.data.verified == true
            && request.resource.data.verificationSource is string
          )
        );
      allow delete: if request.auth != null && resource.data.ownerId == request.auth.uid;
    }

    match /talent_skill_verification_requests/{requestId} {
      allow read: if request.auth != null && resource.data.ownerId == request.auth.uid;
      // The client can only submit a verification request. Evaluation and
      // promotion to verified are server-owned through the Cloud Function.
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.skill is string
        && request.resource.data.skill.size() > 0
        && request.resource.data.skill.size() <= 120
        && request.resource.data.status == 'pending'
        && request.resource.data.requestedAt is timestamp
        && request.resource.data.updatedAt is timestamp
        && request.resource.data.keys().hasOnly([
          'ownerId','skill','status','requestedAt','updatedAt'
        ]);
      allow update, delete: if false;
    }

    match /opportunities/{opportunityId} {
      allow read: if request.auth != null && resource.data.visibility == 'public';
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 200
        && request.resource.data.description is string
        && request.resource.data.description.size() <= 5000
        && request.resource.data.type is string
        && request.resource.data.category is string
        && request.resource.data.city is string
        && request.resource.data.country is string
        && request.resource.data.skills is list
        && request.resource.data.skills.size() <= 20
        && request.resource.data.status == 'open'
        && request.resource.data.visibility == 'public'
        && request.resource.data.createdAt is timestamp
        && request.resource.data.keys().hasOnly([
          'ownerId','title','description','type','category','city','country',
          'skills','status','visibility','createdAt'
        ]);
      allow update, delete: if request.auth != null
        && resource.data.ownerId == request.auth.uid;
    }

    match /post_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.postId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.keys().hasOnly(['postId', 'reporterUid', 'reason', 'createdAt']);
      allow read, update, delete: if false;
    }

    match /message_reports/{reportId} {
      allow create: if request.auth != null
        && request.resource.data.reporterUid == request.auth.uid
        && request.resource.data.conversationId is string
        && request.resource.data.messageId is string
        && request.resource.data.reason is string
        && request.resource.data.reason.size() > 0
        && request.resource.data.reason.size() <= 500
        && request.resource.data.keys().hasOnly([
          'reporterUid', 'conversationId', 'messageId', 'reason', 'createdAt'
        ]);
      allow read, update, delete: if false;
    }

    match /message_blocks/{blockId} {
      allow read: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.blockedUid is string
        && request.resource.data.blockedUid != request.auth.uid
        && request.resource.data.keys().hasOnly([
          'ownerUid', 'blockedUid', 'createdAt'
        ]);
      allow delete: if request.auth != null && resource.data.ownerUid == request.auth.uid;
      allow update: if false;
    }

    // AI gateway request idempotency records are server-only.
    match /users/{userId}/ai_requests/{requestId} {
      allow read, write: if false;
    }

    match /conversations/{conversationId} {
      allow read: if request.auth != null
        && request.auth.uid in resource.data.memberIds;
      allow create: if request.auth != null
        && request.auth.uid in request.resource.data.memberIds
        && request.resource.data.memberIds is list
        && request.resource.data.memberIds.size() >= 1
        && request.resource.data.memberIds.size() <= 50
        && request.resource.data.memberIds.hasAll([request.auth.uid])
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 120
        && request.resource.data.isAi is bool
        && request.resource.data.keys().hasOnly([
          'memberIds', 'title', 'isAi', 'updatedAt', 'lastMessage', 'lastMessageAt', 'lastMessageSenderId', 'type', 'ownerId'
        ])
        && request.resource.data.type in ['direct', 'group', 'ai']
        && (
          (!request.resource.data.isAi && request.resource.data.type == 'group'
            && request.resource.data.ownerId == request.auth.uid
            && request.resource.data.memberIds.size() >= 3)
          || (!request.resource.data.isAi && request.resource.data.type == 'direct'
            && request.resource.data.memberIds.size() == 2
            && !request.resource.data.keys().hasAny(['ownerId'])
            && (
              (request.resource.data.memberIds[0] == request.auth.uid
                && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(request.resource.data.memberIds[1]))
                && !exists(/databases/$(database)/documents/users/$(request.resource.data.memberIds[1])/blocked/$(request.auth.uid)))
              || (request.resource.data.memberIds[1] == request.auth.uid
                && !exists(/databases/$(database)/documents/users/$(request.auth.uid)/blocked/$(request.resource.data.memberIds[0]))
                && !exists(/databases/$(database)/documents/users/$(request.resource.data.memberIds[0])/blocked/$(request.auth.uid)))
            ))
          || (request.resource.data.isAi && request.resource.data.type == 'ai'
            && request.resource.data.memberIds.size() == 1
            && !request.resource.data.keys().hasAny(['ownerId']))
        );
      allow update: if request.auth != null
        && request.auth.uid in resource.data.memberIds
        && request.resource.data.isAi == resource.data.isAi
        && request.resource.data.type == resource.data.type
        && request.resource.data.title == resource.data.title
        && (
(
            resource.data.type == 'group'
            && request.auth.uid == resource.data.ownerId
            && request.resource.data.ownerId is string
            && request.resource.data.ownerId in resource.data.memberIds
            && request.resource.data.memberIds == resource.data.memberIds
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId'])
          )
          || (
            resource.data.type == 'group'
            && request.auth.uid == resource.data.ownerId
            && request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() >= 3
            && request.resource.data.memberIds.size() <= 50
            && request.resource.data.memberIds.hasAll([resource.data.ownerId])
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
          )
          || (
            resource.data.type == 'group'
            && request.resource.data.memberIds is list
            && request.resource.data.memberIds.size() >= 2
            && request.resource.data.memberIds.size() <= 50
            && request.resource.data.memberIds.hasAll([resource.data.ownerId])
            && !(request.auth.uid in request.resource.data.memberIds)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberIds'])
            && request.resource.data.memberIds.size() + 1 == resource.data.memberIds.size()
            && resource.data.memberIds.hasAll(request.resource.data.memberIds)
          )
        );
      allow delete: if request.auth != null
        && (
          (resource.data.type == 'group' && resource.data.ownerId == request.auth.uid)
          || (resource.data.type != 'group' && request.auth.uid in resource.data.memberIds)
        );

      match /typing/{userId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && request.resource.data.keys().hasOnly(['typing', 'updatedAt'])
          && request.resource.data.typing is bool
          && request.resource.data.updatedAt is timestamp;
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
      }

      match /reads/{userId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds
          && request.resource.data.keys().hasOnly(['readAt'])
          && request.resource.data.readAt is timestamp;
        allow delete: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
      }

      match /unreadCounts/{userId} {
        allow read: if request.auth != null
          && request.auth.uid == userId
          && request.auth.uid in get(/databases/$(database)/documents/conversations/$(conversationId)).data.memberIds;
        allow write: if false;
      }

      match /read_receipts/{uid} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds;
        allow create, update: if request.auth != null
          && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/watch_together_rooms/$(roomId)).data.memberIds
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.lastMessageId is string
          && request.resource.data.lastMessageId.size() <= 200
          && request.resource.data.lastReadAt is timestamp;
        allow delete: if request.auth != null && request.auth.uid == uid;
      }

      match /messages/{messageId} {
        allow read: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.memberIds;
        allow create: if request.auth != null
          && request.auth.uid in get(
            /databases/$(database)/documents/conversations/$(conversationId)
          ).data.memberIds
