match /users/{userId}/kids_activity_progress/{activityId} {
      allow read: if isOwner(userId);
      allow create, update: if isOwner(userId)
        && reqData().keys().hasOnly(['activityId','completed','updatedAt'])
        && reqData().activityId == activityId
        && reqData().completed is bool
        && reqData().updatedAt is timestamp
        && get(/databases/$(database)/documents/kids_activities/$(activityId)).data.published == true;
      allow delete: if isOwner(userId);
