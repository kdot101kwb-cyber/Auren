rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Published Shorts are public media. Only the authenticated owner can
    // upload/replace/delete objects in their own namespace.
    match /shorts/{userId}/{fileName} {
      allow read: if true;
      allow create, update: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size > 0
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType == 'video/mp4';
      allow delete: if request.auth != null
        && request.auth.uid == userId;
    }

    match /users/{userId}/media/{allPaths=**} {
      allow read: if request.auth != null && request.auth.uid == userId;
      allow write: if request.auth != null
        && request.auth.uid == userId
        && request.resource.size <= 25 * 1024 * 1024
        && request.resource.contentType.matches('image/.*|video/.*|audio/.*|application/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}
