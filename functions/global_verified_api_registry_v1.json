      "authentication": "none_for_public_indicators",
      "access_tier": "public",
      "officially_documented": true,
      "verification_status": "official_docs_verified",
      "integration_status": "catalog_only",
      "notes": "Supports many economic and development indicator series; confirm relevant dataset coverage and usage terms."
    },
