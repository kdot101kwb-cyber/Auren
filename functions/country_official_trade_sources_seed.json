      {
        "name": "World Bank Entrepreneurship country sources",
        "url": "https://www.worldbank.org/en/programs/entrepreneurship/sources",
        "scope": "Country-by-country company-registration source starting points, including many national registries",
        "sourceType": "country_registry_index",
        "integrationStatus": "catalog_only",
        "notes": "Use to discover a country's own authority; confirm current link, data access and reuse terms for each jurisdiction."
      },
      {
        "name": "ICAEW Company information sources by jurisdiction",
        "url": "https://www.icaew.com/library/research-guides/company-information/sources-by-jurisdiction",
        "scope": "Jurisdiction-by-jurisdiction official company information sources",
        "sourceType": "country_registry_index",
