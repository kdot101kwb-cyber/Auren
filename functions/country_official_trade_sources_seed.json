      {
        "name": "UK Government overseas company registries",
        "url": "https://www.gov.uk/government/publications/overseas-registries",
        "scope": "Selected overseas company registry links by region",
        "sourceType": "country_registry_index",
        "integrationStatus": "catalog_only",
        "notes": "Useful starting point but explicitly not comprehensive."
      },
      {
        "name": "Worldwide Registers — European Business Registry Association",
        "url": "https://ebra.be/worldwide-registers/",
        "scope": "Business registry links by country",
        "sourceType": "country_registry_index",
        "integrationStatus": "catalog_only",
        "notes": "Registry directory only; check the linked national authority for authoritative records."
      },
      {
        "name": "Global official registry source directory",
        "url": "https://www.companyinformation.com/company-registry-directory",
        "scope": "Country/jurisdiction source discovery",
        "sourceType": "registry_reference_directory",
        "integrationStatus": "catalog_only",
        "notes": "Third-party index; use it only to locate official authorities, not as the authority of record."
      }
    ]
  },
